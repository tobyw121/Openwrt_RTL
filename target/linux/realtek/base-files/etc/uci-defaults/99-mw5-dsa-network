#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# v44.65.10: safe factory topology with deterministic DSA master/slave MACs. LAN/WLAN stay in the private management LAN;
# physical WAN is a separate DHCP CLIENT and is never bridged into br-lan.
# NAT/firewall provide Internet without leaking the MW5 DHCP server upstream.
. /lib/functions.sh
. /lib/functions/system.sh
case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
	*tenda,nova-mw5*|*nova-mw5*) ;;
	*) exit 0 ;;
esac
lan_mac="$(mtd_get_mac_ascii factory HW_NIC0_ADDR 2>/dev/null)"
wan_mac=''
[ -n "$lan_mac" ] && wan_mac="$(macaddr_add "$lan_mac" 7)"
for s in eth0_dev lan_dev br_lan lan wan_dev wan wan6; do uci -q delete "network.$s" >/dev/null 2>&1 || true; done
uci -q batch <<'UCI'
set network.loopback='interface'
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'
set network.eth0_dev='device'
set network.eth0_dev.name='eth0'
set network.lan_dev='device'
set network.lan_dev.name='lan'
set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
set network.br_lan.stp='0'
set network.br_lan.igmp_snooping='0'
add_list network.br_lan.ports='lan'
set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'
set network.wan_dev='device'
set network.wan_dev.name='wan'
set network.wan_dev.ipv6='0'
set network.wan='interface'
set network.wan.device='wan'
set network.wan.proto='dhcp'
set network.wan.defaultroute='1'
set network.wan.peerdns='1'
set network.wan.metric='10'
set network.wan.delegate='0'
UCI
if [ -n "$lan_mac" ]; then
	uci -q set network.eth0_dev.macaddr="$lan_mac"
	uci -q set network.lan_dev.macaddr="$lan_mac"
	uci -q set network.br_lan.macaddr="$lan_mac"
	uci -q set network.lan.macaddr="$lan_mac"
fi
if [ -n "$wan_mac" ]; then uci -q set network.wan_dev.macaddr="$wan_mac"; uci -q set network.wan.macaddr="$wan_mac"; fi
uci -q set dhcp.lan='dhcp'
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore >/dev/null 2>&1 || true
uci -q set dhcp.wan='dhcp'
uci -q set dhcp.wan.interface='wan'
uci -q set dhcp.wan.ignore='1'
t=/etc/config/.mw5-write-test.$$
if ( : >"$t" ) 2>/dev/null; then rm -f "$t"; uci -q commit network >/dev/null 2>&1 || true; uci -q commit dhcp >/dev/null 2>&1 || true; fi
exit 0
