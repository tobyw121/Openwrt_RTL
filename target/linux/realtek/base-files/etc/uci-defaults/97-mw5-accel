#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
	*tenda,nova-mw5*|*nova-mw5*) ;;
	*) exit 0 ;;
esac

uci -q set mw5_accel.core='accel'
uci -q set mw5_accel.core.enabled='1'
uci -q set mw5_accel.core.software='1'
uci -q set mw5_accel.core.hardware='1'
uci -q set mw5_accel.core.legacy='0'
uci -q commit mw5_accel

# Keep standard Linux software flow offload on; TC/HW delivery is stability-gated.
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

[ -x /etc/init.d/mw5-accel ] && /etc/init.d/mw5-accel enable >/dev/null 2>&1 || true
exit 0
