#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
START=97
STOP=10
USE_PROCD=1

is_mw5() {
	case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
		*tenda,nova-mw5*|*nova-mw5*) return 0 ;;
	esac
	return 1
}

start_service() {
	is_mw5 || return 0
	[ -x /usr/sbin/mw5-auto-wan ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/mw5-auto-wan daemon
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
