#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
START=06
STOP=90

is_mw5() {
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
		*tenda,nova-mw5*|*nova-mw5*) return 0 ;;
		*) return 1 ;;
	esac
}

start() {
	is_mw5 || return 0
	[ -x /usr/sbin/mw5-uart ] || return 0
	/usr/sbin/mw5-uart tune >/dev/null 2>&1 || true
}

reload() {
	start
}
