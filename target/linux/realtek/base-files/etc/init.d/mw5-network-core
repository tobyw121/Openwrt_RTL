#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# v44.65.22: idempotent LAN/DHCP/DNS/WAN health check before Auto-WAN/WiFi.
START=95
STOP=10

STATE_DIR=/tmp/mw5-webui
LOG=$STATE_DIR/network-core.log

is_mw5() {
	case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
		*tenda,nova-mw5*|*nova-mw5*) return 0 ;;
	esac
	return 1
}

log() {
	mkdir -p "$STATE_DIR"
	echo "$(date +%s 2>/dev/null || echo 0) $*" >>"$LOG"
	logger -t mw5-network-core "$*" 2>/dev/null || true
}

effective_mode() {
	/usr/sbin/mw5-portmode show 2>/dev/null | sed -n 's/^effective_mode=//p' | head -n1
}

config_consistent() {
	/usr/sbin/mw5-portmode show 2>/dev/null | grep -q '^config_consistent=1$'
}

lan_has_ip() {
	ip -4 addr show dev br-lan 2>/dev/null | grep -q ' inet 192\.168\.1\.1/24'
}

local_dhcp_expected() {
	case "$1" in safe|offline|router|router-static|swap) return 0 ;; esac
	return 1
}

wan_expected() {
	case "$1" in safe|router|router-static|swap) return 0 ;; esac
	return 1
}

ensure_dhcp_config() {
	uci -q set dhcp.lan='dhcp'
	uci -q set dhcp.lan.interface='lan'
	uci -q set dhcp.lan.start='100'
	uci -q set dhcp.lan.limit='150'
	uci -q set dhcp.lan.leasetime='12h'
	uci -q delete dhcp.lan.ignore >/dev/null 2>&1 || true
	uci -q set dhcp.wan='dhcp'
	uci -q set dhcp.wan.interface='wan'
	uci -q set dhcp.wan.ignore='1'
}

ensure_dnsmasq() {
	[ -x /etc/init.d/dnsmasq ] || { log 'dnsmasq-init-missing'; return 0; }
	# v44.65.22: do not bounce a healthy DHCP/DNS daemon during the delayed
	# health pass. Port-mode apply owns deliberate dnsmasq restarts.
	if pidof dnsmasq >/dev/null 2>&1; then
		log "dnsmasq-healthy pid=$(pidof dnsmasq)"
		return 0
	fi
	/etc/init.d/dnsmasq start >>"$LOG" 2>&1 || true
	if pidof dnsmasq >/dev/null 2>&1; then
		log "dnsmasq-started pid=$(pidof dnsmasq)"
	else
		log 'dnsmasq-not-running'
	fi
}

ensure_lan_live() {
	# v44.65.22: health first. An unconditional ifup lan tears down the DSA
	# slave/bridge even when br-lan is already healthy; the v44.65.21 trace
	# showed two such boot-time flaps and an RX runout immediately afterwards.
	if lan_has_ip; then
		ip link set dev br-lan up >/dev/null 2>&1 || true
		ip link set dev lan up >/dev/null 2>&1 || true
		log 'lan-healthy-no-reload'
		return 0
	fi

	ip link set dev br-lan up >/dev/null 2>&1 || true
	ip link set dev lan up >/dev/null 2>&1 || true
	ifup lan >/dev/null 2>&1 || true
	n=0
	while [ "$n" -lt 5 ]; do
		lan_has_ip && { log 'lan-recovered-ifup'; return 0; }
		sleep 1; n=$((n + 1))
	done

	# A full port-mode/network reload is now emergency-only. Never use it as a
	# normal health-check action on a live bridge.
	log 'lan-missing-emergency-repair-current'
	/usr/sbin/mw5-portmode repair-current >>"$LOG" 2>&1 || true
	sleep 2
	lan_has_ip && { log 'lan-recovered-repair-current'; return 0; }

	# Last-resort rescue address. This is restricted to modes where the MW5 is
	# the LAN router/DHCP server, and lets a wired client always reach recovery.
	ip addr replace 192.168.1.1/24 dev br-lan >/dev/null 2>&1 || true
	ip link set dev br-lan up >/dev/null 2>&1 || true
	lan_has_ip && { log 'lan-rescue-address-installed'; return 0; }
	log 'lan-address-missing'
	return 1
}

wan_route_ready() {
	wr_dev="$1"
	ip -4 addr show dev "$wr_dev" 2>/dev/null | grep -q ' inet ' || return 1
	ip -4 route show default 2>/dev/null | grep -qw "dev $wr_dev"
}

ensure_wan() {
	mode="$1"
	reason="$2"
	wan_dev="$(uci -q get network.wan.device 2>/dev/null || true)"
	[ -n "$wan_dev" ] || wan_dev=wan
	ip link set dev "$wan_dev" up >/dev/null 2>&1 || true
	if wan_route_ready "$wan_dev"; then
		log "wan-healthy-no-ifup reason=$reason mode=$mode dev=$wan_dev"
	else
		ifup wan >/dev/null 2>&1 || true
		log "wan-recover-ifup reason=$reason mode=$mode dev=$wan_dev"
	fi

	# Linux software flowtable only. Do not request TC_SETUP_FT/netdev HW
	# offload until FLOW_CLS_REPLACE is proven on hardware.
	changed=0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null || echo 0)" = 1 ] || { uci -q set firewall.@defaults[0].flow_offloading='1'; changed=1; }
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null || echo 0)" = 0 ] || { uci -q set firewall.@defaults[0].flow_offloading_hw='0'; changed=1; }

	# Repair firewall once during the primary boot pass. A healthy delayed pass
	# must not bounce firewall/NAT state or network clients.
	if [ "$reason" = boot ]; then
		/usr/sbin/mw5-portmode repair-firewall >>"$LOG" 2>&1 || true
	elif [ "$changed" = 1 ]; then
		/etc/init.d/firewall reload >>"$LOG" 2>&1 || true
	fi
	log "wan-check reason=$reason mode=$mode dev=$wan_dev carrier=$(cat /sys/class/net/$wan_dev/carrier 2>/dev/null || echo 0)"
}

check_once() {
	reason="$1"
	is_mw5 || return 0
	mkdir -p "$STATE_DIR"
	[ -x /usr/sbin/mw5-portmode ] || { log "$reason portmode-missing"; return 0; }

	# Wait for netifd-created DSA devices, but never block boot indefinitely.
	n=0
	while { [ ! -e /sys/class/net/br-lan ] || [ ! -e /sys/class/net/lan ] || [ ! -e /sys/class/net/wan ]; } && [ "$n" -lt 20 ]; do
		sleep 1; n=$((n + 1))
	done

	mode="$(effective_mode)"
	[ -n "$mode" ] || mode=safe
	if ! config_consistent; then
		# Never destroy a healthy live bridge merely because early-boot UCI state
		# is still settling. The emergency repair path below is entered only if
		# the expected LAN address is actually missing.
		if lan_has_ip; then
			log "$reason config-inconsistent-live-lan-preserved"
		else
			log "$reason config-inconsistent-lan-missing"
		fi
	fi

	if local_dhcp_expected "$mode"; then
		ensure_dhcp_config
		ensure_lan_live || true
		ensure_dnsmasq
	else
		log "$reason local-dhcp-disabled mode=$mode"
	fi

	if wan_expected "$mode"; then
		ensure_wan "$mode" "$reason"
	fi

	lan_ip="$(ip -4 addr show dev br-lan 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n1)"
	wan_ip="$(ip -4 addr show dev "$(uci -q get network.wan.device 2>/dev/null || echo wan)" 2>/dev/null | sed -n 's/.* inet \([0-9.]*\)\/.*/\1/p' | head -n1)"
	defrt="$(ip -4 route show default 2>/dev/null | head -n1)"
	log "$reason done mode=$mode lan_ip=${lan_ip:-none} wan_ip=${wan_ip:-none} default=${defrt:-none} dnsmasq=$(pidof dnsmasq 2>/dev/null || echo none)"
}

boot() {
	is_mw5 || return 0
	: >"$LOG"
	check_once boot
	# Re-check after Auto-WAN + WiFi completed their own boot phases. v44.65.22
	# is strictly idempotent here: healthy LAN/WAN/dnsmasq are never bounced.
	( sleep 18; check_once delayed ) &
}

start() { boot; }
