// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
// R76 raw SPI evidence: fullflash-templates/Cudy_AX1500.bin.

#include "rtl8197f_cudy_ax1500.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "cudy,ax1500-r76", "cudy,wr1500", "realtek,rtl8197f-vg", "realtek,rtl8197f-soc";
	model = "Cudy AX1500 / WR1500 R76 (experimental SPI diagnostics)";

	/* OEM bootloader and WR1500 hardware report agree on 128 MiB DDR2.
	 * Scope this to R76: RE1500/M1500 retain their diagnostic RAM window.
	 */
	memory@0 {
		reg = <0x00000000 0x08000000>;
	};

	chosen {
		bootargs = "console=ttyS0,38400n8 rdinit=/sbin/init clk_ignore_unused";
		stdout-path = "serial0:38400n8";
	};

	r76_switch: switch {
		compatible = "realtek,rtl8367d", "realtek,rtl8365mb";
		pinctrl-names = "default";
		pinctrl-0 = <&r76_smi_pins>;
		mdc-gpios = <&gpio0 56 GPIO_ACTIVE_HIGH>;
		mdio-gpios = <&gpio0 55 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio0 58 GPIO_ACTIVE_LOW>;
		realtek,disable-leds;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 { reg = <0>; label = "lan2"; phy-handle = <&r76_phy0>; };
			port@1 { reg = <1>; label = "lan3"; phy-handle = <&r76_phy1>; };
			port@2 { reg = <2>; label = "wan"; phy-handle = <&r76_phy2>; };
			port@3 { reg = <3>; label = "lan1"; phy-handle = <&r76_phy3>; };
			port@7 {
				reg = <7>;
				label = "cpu";
				ethernet = <&ethernet0>;
				phy-mode = "rgmii";
				tx-internal-delay-ps = <2000>;
				rx-internal-delay-ps = <0>;
				fixed-link { speed = <1000>; full-duplex; pause; };
			};
		};
		mdio {
			compatible = "realtek,smi-mdio";
			#address-cells = <1>;
			#size-cells = <0>;
			r76_phy0: ethernet-phy@0 { reg = <0>; };
			r76_phy1: ethernet-phy@1 { reg = <1>; };
			r76_phy2: ethernet-phy@2 { reg = <2>; };
			r76_phy3: ethernet-phy@3 { reg = <3>; };
		};
	};
};

&pinmux {
	r76_smi_pins: r76-smi-pins {
		/* OEM PIN_MUX_SEL13=0x33320000: retain unrelated pin fields. */
		pinctrl-single,bits = <0x34 0x03300000 0x0ff00000>;
	};
};

&gpio0 {
	/delete-property/ interrupt-controller;
	/delete-property/ #interrupt-cells;
	/delete-property/ interrupt-parent;
	/delete-property/ interrupts;
	status = "okay";
};

&uart0 {
	current-speed = <38400>;
};

/* Read-only auto-map uses the bootloader's existing SPI setup. No active
 * controller commands, GPIO probing or erase/program callbacks are enabled.
 */
&spirom0 {
	reg = <0x10000000 0x01000000>;
	reg-names = "automap";
	/delete-property/ realtek,read-shift;
	realtek,read-shift-probes = <0x40000 0x27051956 0x2b0000 0x68737173>;
	label = "cudy-r76-oem-spi";
	status = "okay";

	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* Prefix prevents automatic OEM rootfs/overlay or firmware splitting
		 * during an OpenWrt initramfs diagnostic boot. Offsets are physical.
		 */
		partition@0 { label = "oem-u-boot"; reg = <0 0x20000>; read-only; };
		partition@20000 { label = "oem-cfg"; reg = <0x20000 0x10000>; read-only; };
		partition@30000 { label = "oem-bdinfo"; reg = <0x30000 0x10000>; read-only; };
		partition@40000 { label = "oem-kernel"; reg = <0x40000 0x270000>; read-only; };
		partition@2b0000 { label = "oem-rootfs"; reg = <0x2b0000 0xc50000>; read-only; };
		partition@f00000 { label = "oem-rootfs_data"; reg = <0xf00000 0xf0000>; read-only; };
		partition@ff0000 { label = "oem-backup"; reg = <0xff0000 0x10000>; read-only; };
	};
};

/* Native WR1500 RTL8832BR G6 module binds the PCI radio. The integrated
 * 8197G radio remains disabled; no MW5/RD05 calibration is assigned.
 */
&pcie0 {
	/* PCI INTx source21 routes through ICTL to CPU5, as on related boards. */
	interrupt-parent = <&intc>;
	interrupts = <21 4>;
	/* Fixed RTL8197F outbound windows: OEM BAR2 is 0x19000004.
	 * PCI bus addresses must equal CPU physical addresses; inheriting
	 * the zero-based generic ranges assigns BAR2 to bus address zero
	 * and causes a data-bus exception at the first RTL8832BR MAC read.
	 */
	ranges = <0x01000000 0 0x18c00000 0x00c00000 0 0x00200000>,
		 <0x02000000 0 0x19000000 0x01000000 0 0x01000000>;
	status = "okay";
};

/* Measured P0-to-MAC7/EXT1 cascade. Linux uses opaque rtl8_4 tags,
 * not the OEM SoC router/4-byte tag parser. No legacy swconfig node.
 */
&ethernet0 {
	realtek,rx-ring-size = <900>;
	realtek,tx-ring-size = <768>;
	realtek,descriptor-dwords = <8>;
	realtek,tx-port-mask = <1>;
	realtek,tx-dp-ext = <0>;
	realtek,tx-extspa = <0>;
	realtek,sdk-crc-lengths;
	realtek,sdk-cpuicr1-init;
	realtek,sdk-swcore-init;
	realtek,sdk-trxrdy;
	realtek,rx-poll-fallback;
	realtek,rx-poll-ms = <50>;
	status = "okay";
};
