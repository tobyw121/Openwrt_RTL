From: OpenAI <noreply@openai.com>
Subject: [PATCH] net: dsa: realtek: stop RD05 CPU link before RGMII changes

Follow the family-D SDK timing-before-force-link contract on bootstrap and
runtime reconfiguration. Verify selected timing before enabling CPU7, preserve
diagnostic timing overrides, and avoid subsequent live SSC/timing rewrites.
All new operations require exact RD05 board and family-D identification.

--- a/drivers/net/dsa/realtek/rtl8365mb.c
+++ b/drivers/net/dsa/realtek/rtl8365mb.c
@@ -3686,10 +3686,65 @@
 	       mb->chip_info && mb->chip_info->rtl8367d;
 }
 
-static int rtl8367d_rd05_prepare_link(struct realtek_priv *priv)
+static int rtl8367d_rd05_configure_link(struct realtek_priv *priv,
+				       u32 tx_delay, u32 rx_delay)
 {
 	struct rtl8365mb *mb = priv->chip_data;
+	u32 expected, actual, tap;
 	int ret;
+
+	if (!rtl8367d_rd05_board(mb))
+		return 0;
+	if (tx_delay > 1 || rx_delay > 7)
+		return -EINVAL;
+
+	/* GP3000 family-D SDK: timing must precede MAC force-link enable.
+	 * Also stop the link during runtime SSC/mux changes.  An error leaves
+	 * CPU7 stopped, rather than passing traffic with unverified timing.
+	 */
+	ret = rtl8367d_ext_config_forcemode(priv, 7, false, 0, 0, false, false);
+	if (ret)
+		return ret;
+	ret = rtl8367d_ext1_config_rgmii(priv);
+	if (ret)
+		return ret;
+
+	/* Bootstrap diagnostic modes can override the normal coarse timing. */
+	expected = FIELD_PREP(RTL8365MB_EXT_RGMXF_TXDELAY_MASK, tx_delay) |
+		   FIELD_PREP(RTL8365MB_EXT_RGMXF_RXDELAY_MASK, rx_delay);
+	ret = regmap_update_bits(priv->map, RTL8365MB_EXT_RGMXF_REG(1),
+				 RTL8365MB_EXT_RGMXF_TXDELAY_MASK |
+				 RTL8365MB_EXT_RGMXF_RXDELAY_MASK, expected);
+	if (ret)
+		return ret;
+	ret = regmap_read(priv->map, RTL8365MB_EXT_RGMXF_REG(1), &actual);
+	if (ret)
+		return ret;
+	if ((actual & (RTL8365MB_EXT_RGMXF_TXDELAY_MASK |
+		       RTL8365MB_EXT_RGMXF_RXDELAY_MASK)) != expected)
+		goto mismatch;
+
+	tap = READ_ONCE(rtl8367d_rd05_ext1_txc_tap);
+	expected = FIELD_PREP(RTL8367D_EXT1_RGMII_TX_DLY_MASK, tap);
+	ret = regmap_read(priv->map, RTL8367D_EXT_TXC_DLY_REG, &actual);
+	if (ret)
+		return ret;
+	if ((actual & RTL8367D_EXT1_RGMII_TX_DLY_MASK) != expected)
+		goto mismatch;
+
+	return rtl8367d_ext_config_forcemode(priv, 7, true, SPEED_1000,
+					    DUPLEX_FULL, true, true);
+
+mismatch:
+	dev_err(priv->dev, "RD05 EXT1 timing readback mismatch: got=0x%x expected=0x%x; CPU link stopped\n",
+		actual, expected);
+	return -EIO;
+}
+
+static int rtl8367d_rd05_prepare_link(struct realtek_priv *priv,
+				     u32 tx_delay, u32 rx_delay)
+{
+	struct rtl8365mb *mb = priv->chip_data;
 
 	if (!rtl8367d_rd05_board(mb))
 		return 0;
@@ -3699,15 +3754,7 @@
 	if (!READ_ONCE(rtl8367d_rd05_ext1_txc_explicit))
 		WRITE_ONCE(rtl8367d_rd05_ext1_txc_tap, 4);
 
-	/* Program mux/debug/MAC7 routing before bootstrap traffic, rather
-	 * than relying on a later phylink callback or userspace calibration.
-	 * Selected coarse/fine timing and SSC remain under the existing knobs. */
-	ret = rtl8367d_ext1_config_rgmii(priv);
-	if (ret)
-		return ret;
-
-	return rtl8367d_ext_config_forcemode(priv, 7, true, SPEED_1000,
-					    DUPLEX_FULL, true, true);
+	return rtl8367d_rd05_configure_link(priv, tx_delay, rx_delay);
 }
 
 static int rtl8367d_rd05_force_dsa_cpu_path(struct realtek_priv *priv)
@@ -3757,10 +3804,6 @@
 	if (!cpu_mask || !user_mask)
 		return 0;
 
-	ret = rtl8367d_rd05_prepare_link(priv);
-	if (ret)
-		return ret;
-
 	/* RD05: UTP0..4 plus CPU7/EXT1/MAC7, wired to RTL8197F P0, share one
 	 * untagged VID9 switching domain.  netifd/DSA still decides which Linux
 	 * slave belongs to br-lan or wan; this only prevents hardware ingress VLAN
@@ -3768,6 +3811,10 @@
 	 */
 	rtl8367d_rd05_extcpu_apply(cpu, extcpu_mode, &tx_delay, &rx_delay);
 
+	ret = rtl8367d_rd05_prepare_link(priv, tx_delay, rx_delay);
+	if (ret)
+		return ret;
+
 	cpu_mask = cpu->mask;
 	wide_mask = cpu_mask | user_mask;
 	rtl8367d_rd05_portmap_masks(cpu_mask, user_mask, mode, &vlan_mask,
@@ -3784,33 +3831,7 @@
 				 RTL8367D_BYPASS_EXT1_BIT, 0);
 	if (ret)
 		return ret;
-
-	ret = rtl8367d_ext1_set_ssc(priv, READ_ONCE(rtl8367d_rd05_ext1_ssc));
-	if (ret)
-		return ret;
-
 	ret = rtl8365mb_cpu_config(priv);
-	if (ret)
-		return ret;
-
-	/* Apply the family-D fine TX-clock tap as well as the coarse 0x1307
-	 * delay.  This controls RTL8367D -> RTL8197F timing independently of the
-	 * reverse direction and is therefore part of the runtime calibration.
-	 */
-	ret = regmap_update_bits(priv->map, RTL8367D_EXT_TXC_DLY_REG,
-				 RTL8367D_EXT1_RGMII_TX_DLY_MASK,
-				 FIELD_PREP(RTL8367D_EXT1_RGMII_TX_DLY_MASK,
-					    min_t(u32, READ_ONCE(rtl8367d_rd05_ext1_txc_tap), 7)));
-	if (ret)
-		return ret;
-
-	ret = regmap_update_bits(priv->map, RTL8365MB_EXT_RGMXF_REG(1),
-				 RTL8365MB_EXT_RGMXF_TXDELAY_MASK |
-				 RTL8365MB_EXT_RGMXF_RXDELAY_MASK,
-				 FIELD_PREP(RTL8365MB_EXT_RGMXF_TXDELAY_MASK,
-					    tx_delay ? 1 : 0) |
-				 FIELD_PREP(RTL8365MB_EXT_RGMXF_RXDELAY_MASK,
-					    rx_delay));
 	if (ret)
 		return ret;
 
@@ -3963,11 +3984,9 @@
 	mutex_lock(&rtl8367d_rd05_runtime_lock);
 	priv = rtl8367d_rd05_runtime_priv;
 	if (priv) {
-		ret = rtl8367d_ext1_config_rgmii(priv);
-		if (!ret)
-			ret = rtl8367d_ext_config_forcemode(priv, 7, true,
-						       SPEED_1000, DUPLEX_FULL,
-						       true, true);
+		ret = rtl8367d_rd05_configure_link(priv,
+			READ_ONCE(rtl8367d_rd05_ext1_tx_delay),
+			READ_ONCE(rtl8367d_rd05_ext1_rx_delay));
 		if (!ret) {
 			regmap_read(priv->map, RTL8365MB_EXT_RGMXF_REG(1), &rgmxf);
 			regmap_read(priv->map, RTL8367D_EXT_TXC_DLY_REG, &txc);
