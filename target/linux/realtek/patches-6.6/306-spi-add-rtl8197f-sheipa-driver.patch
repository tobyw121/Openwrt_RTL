From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt RTL8197F bringup <noreply@example.invalid>
Date: Mon, 25 May 2026 00:00:00 +0000
Subject: [PATCH] spi: add Realtek RTL8197F/RTL8197FH SHEIPA SPI controller

Add Kconfig/Makefile hooks for the RTL8197F SHEIPA SPI controller supplied by
the OpenWrt target files overlay.

Use low-context insertion points near stable top-level objects so this patch
keeps applying across minor 6.6.y kernel refreshes where the alphabetic SPI
Makefile order may move.

---
--- a/drivers/spi/Kconfig
+++ b/drivers/spi/Kconfig
@@ -897,6 +897,16 @@ config SPI_ROCKCHIP_SFC
 	help
 	  This enables support for the Rockchip SFC serial flash controller.
 
+config SPI_RTL8197F_SHEIPA
+	tristate "Realtek RTL8197F/RTL8197FH SHEIPA SPI controller"
+	depends on MACH_REALTEK_RTL || COMPILE_TEST
+	depends on OF
+	select SPI_MEM
+	help
+	  This enables the SHEIPA SPI controller used as the SPI-NOR boot flash
+	  controller on Realtek RTL8197F/RTL8197FH/RTL8197F-VG router SoCs.  The initial
+	  driver focuses on safe SPI-NOR probing and read access.
+
 config SPI_RSPI
 	tristate "Renesas RSPI/QSPI controller"
 	depends on ARCH_RENESAS || COMPILE_TEST
--- a/drivers/spi/Makefile
+++ b/drivers/spi/Makefile
@@ -8,6 +8,7 @@ obj-$(CONFIG_SPI_MASTER)		+= spi.o
 obj-$(CONFIG_SPI_MEM)			+= spi-mem.o
 obj-$(CONFIG_SPI_MUX)			+= spi-mux.o
 obj-$(CONFIG_SPI_SPIDEV)		+= spidev.o
+obj-$(CONFIG_SPI_RTL8197F_SHEIPA)	+= spi-rtl8197f-sheipa.o
 obj-$(CONFIG_SPI_LOOPBACK_TEST)		+= spi-loopback-test.o
 
 # SPI master controller drivers (bus)
