#ifdef CMD_OAM_ADD_DEL_REMOTE_MEPID_VALUE
//OAM configuration
//add configuration
//delete configuration
//remote mepid configuration
//mepid value, uint16
oam ( add | del ) remote-mepid <HEX:value>
#endif

#ifdef CMD_OAM_DUMP_CFM_DYING_GASP_OAM
//OAM configuration
//dump configuration
//CFM configuration
//dying gasp configuration
//OAM configuration
oam dump ( cfm | dying-gasp | oam )
#endif

#ifdef CMD_OAM_DUMP_CFM_DYING_GASP_OAM_PORT_PORT_ALL
//OAM configuration
//dump configuration
//CFM configuration
//dying gasp configuration
//OAM configuration
//port list
//port list (e.g. 3 or 6-8)
//all ports
oam dump ( cfm | dying-gasp | oam ) port ( <PORT_LIST:ports> | all )
#endif

#ifdef CMD_OAM_GET_ASIC_AUTO_DYING_GASP_PORT_PORTS_ALL_STATE
//OAM configuration
//get configuration
//asic dying gasp configuration
//port list
//port list (e.g. 3 or 6-8)
//all ports
//state configuration
oam get asic-auto-dying-gasp port ( <PORT_LIST:ports> | all ) state
#endif

#ifdef CMD_OAM_GET_CCM_PORT_PORTS_ALL_GROUP_ID_INDEX_MEPID
//OAM configuration
//get configuration
//ccm configuration
//port list
//port list (e.g. 3 or 6-8)
//all ports
//CFM group index
//index value, <0-1>
//mepid configuration
