#ifdef CMD_OAM_SET_ASIC_AUTO_DYING_GASP_PORT_PORTS_ALL_STATE_DISABLE_ENABLE
//OAM configuration
//set configuration
//asic dying gasp configuration
//port list
//port list (e.g. 3 or 6-8)
//all ports
