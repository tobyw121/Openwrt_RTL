#
# Makefile for SDK Linux Rtusr User Library
#

CFLAGS_y += -Wall -Werror -Wuninitialized -Wstrict-prototypes

SRCS_y =
SRCS_y += rtusr_init.c
SRCS_y += rtusr_l2.c
SRCS_y += rtusr_l3.c
SRCS_y += rtusr_oam.c
SRCS_y += rtusr_port.c
SRCS_y += rtusr_vlan.c
SRCS_y += rtusr_stp.c
SRCS_y += rtusr_counter.c
SRCS_y += rtusr_time.c
SRCS_y += rtusr_trap.c
SRCS_y += rtusr_pie.c
SRCS_y += rtusr_filter.c
SRCS_y += rtusr_qos.c
SRCS_y += rtusr_trunk.c
SRCS_y += rtusr_dot1x.c
SRCS_y += rtusr_debug.c
SRCS_y += rtusr_mirror.c
SRCS_y += rtusr_flowctrl.c
SRCS_y += rtusr_rate.c
SRCS_y += rtusr_svlan.c
SRCS_y += rtusr_switch.c
SRCS_y += rtusr_nic.c
SRCS_y += rtusr_diag.c
SRCS_y += rtusr_eee.c
SRCS_y += rtusr_sec.c
SRCS_y += rtusr_led.c
SRCS_y += rtusr_mpls.c
SRCS_y += rtusr_acl.c
ifeq ($(CONFIG_SDK_UART1), y)
SRCS_y += rtusr_uart.c
endif
ifeq ($(CONFIG_SDK_RTL8380), y)
ifeq ($(CONFIG_SDK_APP_DIAG_EXT), y)
    SRCS_y += rtusr_ext_8380.c
    INCLUDE += -I$(MODELDIR)
endif
endif

ifneq ($(CONFIG_SDK_DRIVER_TEST),)
SRCS_y += rtusr_private.c
INCLUDE += -I$(UT_INCLUDE)
endif

INCLUDE += -I$(SDK_INCLUDE) -I$(SYS_INCLUDE) -I$(DRV_INCLUDE) -I../include

TARGET := obj

SRCS = $(SRCS_y)
OBJS = $(shell for i in $(SRCS); do n=`basename $$i`; echo -n $(TARGET)/$${n%%.*}.o ""; done)
LIBNAME = $(SDK_LIBDIR)/librtusr.a

all: $(LIBNAME)

$(LIBNAME): $(OBJS)
	$(AR) rv $(LIBNAME) $(OBJS)
	$(STRIP) --strip-debug -R .note -R .comment $@

$(TARGET)/%.o: %.c
	$(CC) $(INCLUDE) $(CFLAGS) $(CFLAGS_y) -c -o $@ $<

romfs:

clean:
	rm -f $(OBJS) $(LIBNAME)

