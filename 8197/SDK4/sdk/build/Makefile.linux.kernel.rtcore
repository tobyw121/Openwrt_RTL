#
# Copyright (C) 2009 Realtek Semiconductor Corp. 
#
# Makefile for SDK Linux Rtcore Kernel Module 
#

ifeq ($(SDK_CONFIG), $(wildcard $(SDK_CONFIG)))
include $(SDK_CONFIG)
endif

SDK_TOP_DIR := ../../..
SDK_SYS_DIR := ../..
NIC_DIR = $(SDK_SYS_DIR)/drv/nic

EXTRA_CFLAGS += -I$(SDK_INCLUDE) -I$(SYS_INCLUDE) -I$(DRV_INCLUDE) -URTK_UNIVERSAL_BSP -Werror
ifneq ($(CONFIG_SDK_DRIVER_TEST),)
EXTRA_CFLAGS += -I$(UT_INCLUDE)
endif

ifeq ($(CONFIG_SDK_DRIVER_RTCORE),m)
EXTRA_CFLAGS += -mlong-calls -fno-pic -mno-abicalls
endif

RTCORE_OBJ := \
	rtcore_drv.o
ifeq ($(CONFIG_SDK_DRIVER_RTCORE),m)
RTCORE_OBJ += \
	rtcore_export.o
endif

SYS_DIR := $(SDK_SYS_DIR)/linux
SYS_OBJ := \
	$(SYS_DIR)/dev_config.o
	
DRV_DIR := $(SDK_SYS_DIR)/drv
INTR_DIR := $(DRV_DIR)/intr
DRV_OBJ := \
	$(DRV_DIR)/swcore/chip.o \
	$(DRV_DIR)/swcore/sys.o \
	$(DRV_DIR)/watchdog/watchdog.o \
	$(DRV_DIR)/watchdog/probe.o
ifeq ($(CONFIG_SDK_KERNEL_LINUX_KERNEL_MODE),y)
DRV_OBJ += \
	$(DRV_DIR)/swcore/l2notification.o
else
DRV_OBJ += \
	$(DRV_DIR)/swcore/l2notification_usr_krn.o
endif
ifeq ($(CONFIG_SDK_RTL8389),y)
DRV_OBJ += \
	$(DRV_DIR)/watchdog/r8389.o
endif
ifeq ($(CONFIG_SDK_RTL8328),y)
DRV_OBJ += \
	$(DRV_DIR)/watchdog/r8328.o
endif
ifeq ($(CONFIG_SDK_RTL8390),y)
DRV_OBJ += \
	$(DRV_DIR)/watchdog/r8390.o
endif
ifeq ($(CONFIG_SDK_RTL8380),y)
DRV_OBJ += \
	$(DRV_DIR)/watchdog/r8380.o
endif
#	$(INTR_DIR)/intr.o
ifeq ($(CONFIG_SDK_BSP_SMI),y)
DRV_OBJ += \
	$(DRV_DIR)/smi/smi.o \
	$(DRV_DIR)/gpio/gpio.o \
	$(DRV_DIR)/gpio/generalCtrl_gpio.o
ifeq ($(CONFIG_SDK_SOFTWARE_CONTROL_LED),y)
DRV_OBJ += \
	$(DRV_DIR)/swled/swctrl_led_main.o \
	$(DRV_DIR)/swled/swctrl_led_r8390.o \
	$(DRV_DIR)/swled/swctrl_led_cfg.o
endif
endif
ifeq ($(CONFIG_SDK_RTL8231),y)
DRV_OBJ += \
	$(DRV_DIR)/gpio/ext_gpio.o \
	$(DRV_DIR)/smi/ext_smi.o \
	$(DRV_DIR)/rtl8231/rtl8231.o \
	$(DRV_DIR)/rtl8231/probe.o \
	$(DRV_DIR)/rtl8231/r8389.o \
	$(DRV_DIR)/rtl8231/r8328.o \
	$(DRV_DIR)/rtl8231/r8390.o \
	$(DRV_DIR)/rtl8231/r8380.o
endif
ifeq ($(CONFIG_SDK_UART1),y)
DRV_OBJ += \
	$(DRV_DIR)/uart/uart.o \
	$(DRV_DIR)/uart/probe.o
ifneq ($(CONFIG_SDK_RTL8390),)
DRV_OBJ += \
	$(DRV_DIR)/uart/r8390.o
endif
ifneq ($(CONFIG_SDK_RTL8380),)
DRV_OBJ += \
	$(DRV_DIR)/uart/r8380.o
endif
endif

COMMON_DIR := $(SDK_SYS_DIR)/common
COMMON_OBJ := \
	$(COMMON_DIR)/debug/rt_log.o \
	$(COMMON_DIR)/debug/mem.o \
	$(COMMON_DIR)/rtcore/init.o

OSAL_DIR := $(SDK_SYS_DIR)/osal/linux
OSAL_OBJ := \
	$(OSAL_DIR)/cache.o \
	$(OSAL_DIR)/isr.o \
	$(OSAL_DIR)/lib.o \
	$(OSAL_DIR)/memory.o \
	$(OSAL_DIR)/sem.o \
	$(OSAL_DIR)/thread.o \
	$(OSAL_DIR)/time.o \
	$(OSAL_DIR)/spl.o \
	$(OSAL_DIR)/atomic.o

IOAL_DIR := $(SDK_SYS_DIR)/ioal
IOAL_OBJ := \
	$(IOAL_DIR)/mem32.o
ifeq ($(CONFIG_SDK_MODEL_MODE),y)
EXTRA_CFLAGS += -I$(SDK_TOP_DIR)/model
EXTRA_CFLAGS += -I$(SDK_TOP_DIR)/model/behavior_src/8390
EXTRA_CFLAGS += -I$(SDK_TOP_DIR)/model/common
EXTRA_CFLAGS += -I$(SDK_TOP_DIR)/kernel/uClinux/uClibc/include
IOAL_OBJ += \
	$(SDK_TOP_DIR)/../model/virtualmac/vmac_target.o \
	$(SDK_TOP_DIR)/model/ioal/ioal_init.o
else
IOAL_OBJ += \
	$(IOAL_DIR)/ioal_init.o
endif

NIC_DIR := $(DRV_DIR)/nic
NIC_OBJ :=
ifeq ($(CONFIG_SDK_DRIVER_NIC_KERNEL_MODE),y)
NIC_OBJ += \
	$(NIC_DIR)/nic.o \
	$(NIC_DIR)/probe.o \
	$(NIC_DIR)/diag.o
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8389),)
NIC_OBJ += \
	$(NIC_DIR)/r8389.o
endif
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8328),)
NIC_OBJ += \
	$(NIC_DIR)/r8328.o
endif
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8390),)
NIC_OBJ += \
	$(NIC_DIR)/r8390.o
endif
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8380),)
NIC_OBJ += \
	$(NIC_DIR)/r8380.o
endif
endif

TARGET := rtcore

ALL_OBJ := $(RTCORE_OBJ) $(SYS_OBJ) $(DRV_OBJ) $(COMMON_OBJ) $(OSAL_OBJ) $(IOAL_OBJ) $(NIC_OBJ)

obj-$(CONFIG_SDK_DRIVER_RTCORE) += $(TARGET).o
$(TARGET)-objs := $(ALL_OBJ)

clean:
	@$(RM) $(ALL_OBJ)
	@find $(SDK_SYS_DIR) \( -name '*.[oas]' -o -name '*.ko' -o -name '.*.cmd' \
		-o -name '.*.d' -o -name '.*.tmp' -o -name '*.mod.c' \) \
		-type f -print | xargs rm -f

