	$(DAL_ESW_DIR)/dal_esw_eee.o \
	$(DAL_ESW_DIR)/dal_esw_flowctrl.o \
	$(DAL_ESW_DIR)/dal_esw_l2.o \
	$(DAL_ESW_DIR)/dal_esw_l3.o \
	$(DAL_ESW_DIR)/dal_esw_mirror.o \
	$(DAL_ESW_DIR)/dal_esw_oam.o \
	$(DAL_ESW_DIR)/dal_esw_pie.o \
	$(DAL_ESW_DIR)/dal_esw_port.o \
