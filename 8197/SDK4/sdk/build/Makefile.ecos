ifeq ($(CONFIG_SDK_DRIVER_TEST),y)
UT_DIR := $(ECOS_SDK_ROOT_DIR)/unittest
CFLAGS += -I$(UT_DIR)
COMMONUTIL_DIR := $(UT_DIR)/common
SDKTEST_DIR := $(UT_DIR)/sdk
HALTEST_DIR := $(UT_DIR)/hal
DALTEST_DIR := $(UT_DIR)/dal
NICTEST_DIR := $(UT_DIR)/nic
OSALTEST_DIR := $(UT_DIR)/osal

UT_OBJ := \
	$(SDKTEST_DIR)/sdk_test.o \
