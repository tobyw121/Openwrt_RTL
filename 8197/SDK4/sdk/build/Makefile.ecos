ECOS_SDK_ROOT_DIR := $(shell pwd)
ECOS_SDK_SRC_DIR := $(ECOS_SDK_ROOT_DIR)/src
ECOS_SDK_INC_DIR := $(ECOS_SDK_ROOT_DIR)/include
ECOS_SDK_CFG_DIR := $(ECOS_SDK_ROOT_DIR)/config
ECOS_SDK_SYS_DIR := $(ECOS_SDK_ROOT_DIR)/system
ECOS_SYS_INC_DIR := $(ECOS_SDK_SYS_DIR)/ecos
ECOS_DRV_INC_DIR := $(ECOS_SDK_SYS_DIR)/include
ECOS_SDK_CONFIG := $(ECOS_SDK_CFG_DIR)/.config

ifeq ("x$(INSTALL_DIR)","x")
KERNEL_INSTALL_DIR := $(ECOS_SDK_SRC_DIR)/../../../build/kernel/install
else
KERNEL_INSTALL_DIR := $(INSTALL_DIR)
endif

-include $(KERNEL_INSTALL_DIR)/include/pkgconf/ecos.mak

TARGET := rtk_target.elf

ifeq ($(ECOS_SDK_CONFIG),$(wildcard $(ECOS_SDK_CONFIG)))
include $(ECOS_SDK_CONFIG)
all: $(TARGET)
else
all: config_error
endif

XCC           = $(ECOS_COMMAND_PREFIX)gcc
XCXX          = $(XCC)
XLD           = $(XCC)
OBJDUMP       = $(ECOS_COMMAND_PREFIX)objdump
OBJCOPY       = $(ECOS_COMMAND_PREFIX)objcopy
STRIP         = $(ECOS_COMMAND_PREFIX)strip 
AR            = $(ECOS_COMMAND_PREFIX)ar

CFLAGS        = -I$(KERNEL_INSTALL_DIR)/include -I$(ECOS_SDK_INC_DIR) -I$(ECOS_SYS_INC_DIR) -I$(ECOS_DRV_INC_DIR)
CFLAGS       += -I$(ECOS_SDK_INC_DIR)/app/diag -I$(ECOS_SDK_SRC_DIR)/app/lib -I$(DIAG_INC)
CXXFLAGS      = $(CFLAGS)
LDFLAGS       = -nostartfiles -L$(KERNEL_INSTALL_DIR)/lib -Ttarget.ld

SYS_DIR := $(ECOS_SDK_SYS_DIR)/ecos
SYS_OBJ := \
	$(SYS_DIR)/dev_config.o 

BSP_DIR := $(ECOS_SDK_SYS_DIR)/bsp
BSP_OBJ := \
#	$(BSP_DIR)/watchdog.o

DRV_DIR := $(ECOS_SDK_SYS_DIR)/drv
DRV_SWCORE_DIR := $(DRV_DIR)/swcore
DRV_SMI_DIR := $(DRV_DIR)/smi
DRV_NIC_DIR := $(DRV_DIR)/nic
DRV_OBJ := \
	$(DRV_SWCORE_DIR)/chip.o \
	$(DRV_SWCORE_DIR)/sys.o
ifeq ($(CONFIG_SDK_BSP_SMI),y)
DRV_OBJ += \
	$(DRV_DIR)/smi/smi.o \
	$(DRV_DIR)/gpio/gpio.o
#	$(DRV_SMI_DIR)/smi.o 
endif

NIC_DIR := $(DRV_DIR)/nic
NIC_OBJ := \
	$(NIC_DIR)/nic.o \
	$(NIC_DIR)/probe.o \
	$(NIC_DIR)/diag.o
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8389),)
NIC_OBJ += \
	$(NIC_DIR)/r8389.o
endif
ifneq ($(CONFIG_SDK_DRIVER_NIC_R8328),)
NIC_OBJ += \
	$(NIC_DIR)/r8328.o
endif

SYS_COMMON_DIR := $(ECOS_SDK_SYS_DIR)/common
SYS_COMMON_DBG_DIR := $(SYS_COMMON_DIR)/debug
SYS_COMMON_RTCORE_DIR := $(SYS_COMMON_DIR)/rtcore
SYS_COMMON_OBJ := \
	$(SYS_COMMON_DBG_DIR)/rt_log.o \
	$(SYS_COMMON_DBG_DIR)/mem.o \
	$(SYS_COMMON_RTCORE_DIR)/init.o

COMMON_DIR := $(ECOS_SDK_SRC_DIR)/common
COMMON_UTIL_DIR := $(COMMON_DIR)/util
COMMON_OBJ := \
	$(COMMON_DIR)/rt_error.o \
	$(COMMON_UTIL_DIR)/rt_bitop.o \
	$(COMMON_UTIL_DIR)/rt_util.o

OSAL_ECOS_DIR := $(ECOS_SDK_SYS_DIR)/osal/ecos
OSAL_OS_DIR := $(OSAL_ECOS_DIR)
OSAL_OBJ := \
	$(OSAL_OS_DIR)/cache.o \
	$(OSAL_OS_DIR)/isr.o \
	$(OSAL_OS_DIR)/lib.o \
	$(OSAL_OS_DIR)/memory.o \
	$(OSAL_OS_DIR)/sem.o \
	$(OSAL_OS_DIR)/time.o \
	$(OSAL_OS_DIR)/thread.o 

IOAL_DIR := $(ECOS_SDK_SYS_DIR)/ioal
IOAL_OBJ := \
	$(IOAL_DIR)/ioal_init.o \
	$(IOAL_DIR)/mem32.o 
	
HAL_DIR := $(ECOS_SDK_SRC_DIR)/hal
HAL_CHIPDEF_DIR := $(HAL_DIR)/chipdef
