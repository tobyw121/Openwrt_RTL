	$(HALTEST_DIR)/hal_database_test_case.o \
	$(HALTEST_DIR)/hal_mechanism_test_case.o \
	$(DALTEST_DIR)/dal_vlan_test_case.o \
	$(DALTEST_DIR)/dal_qos_test_case.o \
	$(DALTEST_DIR)/dal_flowctrl_test_case.o \
	$(DALTEST_DIR)/dal_l2_test_case.o \
	$(DALTEST_DIR)/dal_dot1x_test_case.o \
	$(DALTEST_DIR)/dal_filter_test_case.o \
	$(DALTEST_DIR)/dal_rate_test_case.o \
	$(DALTEST_DIR)/dal_trunk_test_case.o \
	$(DALTEST_DIR)/dal_switch_test_case.o \
	$(DALTEST_DIR)/dal_stp_test_case.o \
	$(DALTEST_DIR)/dal_svlan_test_case.o \
	$(DALTEST_DIR)/dal_trap_test_case.o \
	$(DALTEST_DIR)/dal_port_test_case.o \
	$(DALTEST_DIR)/dal_pie_test_case.o \
	$(DALTEST_DIR)/dal_oam_test_case.o \
	$(DALTEST_DIR)/dal_eee_test_case.o \
	$(DALTEST_DIR)/dal_l3_test_case.o \
	$(DALTEST_DIR)/dal_sec_test_case.o \
	$(DALTEST_DIR)/dal_stp_test_case.o  \
	$(NICTEST_DIR)/nic_test_case.o
endif

MAIN_DIR := $(SYS_DIR)
MAIN_OBJ := \
	$(MAIN_DIR)/usrAppStart.o

ifeq ($(CONFIG_SDK_APP_DIAG),y)
DIAG_ROOT_DIR := $(ECOS_SDK_SRC_DIR)/app/diag
DIAG_DIR := $(DIAG_ROOT_DIR)/src
DIAG_INC = $(ECOS_SDK_ROOT_DIR)/src/app/diag/include
DIAG_OBJ := \
	$(DIAG_DIR)/parser/cparser.o \
	$(DIAG_DIR)/parser/cparser_fsm.o \
	$(DIAG_DIR)/parser/cparser_io_unix.o \
	$(DIAG_DIR)/parser/cparser_line.o \
	$(DIAG_DIR)/parser/cparser_token.o \
	$(DIAG_DIR)/parser/cparser_token_tbl.o \
	$(DIAG_DIR)/parser/cparser_tree.o \
	$(DIAG_DIR)/diag_util.o \
	$(DIAG_DIR)/diag_main.o \
	$(DIAG_DIR)/diag_cmd.o \
    $(DIAG_DIR)/diag_dot1x.o \
    $(DIAG_DIR)/diag_om.o \
    $(DIAG_DIR)/diag_eee.o \
    $(DIAG_DIR)/diag_reg.o \
    $(DIAG_DIR)/diag_trap.o \
    $(DIAG_DIR)/diag_oam.o \
    $(DIAG_DIR)/diag_port.o \
    $(DIAG_DIR)/diag_stp.o \
    $(DIAG_DIR)/diag_l2.o \
    $(DIAG_DIR)/diag_l3.o \
    $(DIAG_DIR)/diag_qos.o \
    $(DIAG_DIR)/diag_trunk.o \
    $(DIAG_DIR)/diag_rate.o \
    $(DIAG_DIR)/diag_switch.o \
    $(DIAG_DIR)/diag_counter.o \
    $(DIAG_DIR)/diag_sec.o \
    $(DIAG_DIR)/diag_mirror.o \
    $(DIAG_DIR)/diag_vlan.o \
    $(DIAG_DIR)/diag_flowctrl.o \
    $(DIAG_DIR)/diag_pie.o \
    $(DIAG_DIR)/diag_svlan.o \
    $(DIAG_DIR)/diag_filter.o
ifneq ($(CONFIG_SDK_DRIVER_NIC),)
DIAG_OBJ += \
    $(DIAG_DIR)/diag_nic.o
endif
ifneq ($(CONFIG_SDK_DEBUG),)
DIAG_OBJ += \
    $(DIAG_DIR)/diag_debug.o
endif
ifneq ($(CONFIG_RRCP_MASTER),)
DIAG_OBJ += \
    $(DIAG_DIR)/diag_rrcpmaster.o
endif
ifneq ($(CONFIG_SDK_DRIVER_TEST),)
DIAG_OBJ += \
    $(DIAG_DIR)/diag_sdk.o
endif
endif

DRV_OBJ := $(SYS_OBJ) $(BSP_OBJ) $(DRV_OBJ) $(SYS_COMMON_OBJ) $(COMMON_OBJ) $(NIC_OBJ) $(OSAL_OBJ) $(IOAL_OBJ) $(HAL_OBJ) $(DAL_OBJ) $(SDKTEST_OBJ) $(RTK_OBJ)
APP_OBJ := $(MAIN_OBJ)
ifeq ($(CONFIG_SDK_DRIVER_TEST),y)
DRV_OBJ += $(UT_OBJ)
endif
ifeq ($(CONFIG_SDK_APP_DIAG),y)
APP_OBJ += $(DIAG_OBJ)
endif
ALL_OBJ := $(DRV_OBJ) $(APP_OBJ)

ifdef APP_LIBDIR
else
APP_LIBDIR := .
endif

TARGET_LIB := $(APP_LIBDIR)/libsdk.a

.PHONY: all clean install

$(TARGET): $(TARGET_LIB) $(APP_OBJ)
	$(XLD) $(LDFLAGS) $(ECOS_GLOBAL_LDFLAGS) -o $(TARGET) $(APP_OBJ) $(TARGET_LIB) $(APP_LIB)
	$(OBJCOPY) -O binary $@ $(basename $(TARGET)).bin
	$(OBJCOPY) -O srec $@ $(basename $(TARGET)).srec
	$(OBJDUMP) -DSlx $@ > $(basename $(TARGET)).code
#	$(STRIP) $@
	make -f $(ECOS_SDK_SRC_DIR)/../build/Makefile.ecos install

$(TARGET_LIB): $(DRV_OBJ)
	$(AR) rcs $@ $(DRV_OBJ)

ifdef IMAGE_DIR
install: $(TARGET)
	-mkdir -p $(IMAGE_DIR)/sdk
	mv $(basename $(TARGET)).* $(IMAGE_DIR)/sdk
else
install: $(TARGET)

endif

distclean: clean
	-$(MAKE) -C $(ECOS_SDK_CFG_DIR) clean	

clean:
	-rm -f $(ALL_OBJ)
	-rm -f $(TARGET) $(TARGET_LIB)
	-rm -f $(IMAGE_DIR)/sdk/*
	-$(MAKE) -C $(APP_LIB_READLINE_DIR) $@

%.o: %.c
	$(XCC) -c -o $*.o $(CFLAGS) $(EXTRA_CFLAGS) $(ECOS_GLOBAL_CFLAGS) $<

%.o: %.cxx
	$(XCXX) -c -o $*.o $(CXXFLAGS) $(ECOS_GLOBAL_CFLAGS) $<

%.o: %.C
	$(XCXX) -c -o $*.o $(CXXFLAGS) $(ECOS_GLOBAL_CFLAGS) $<

%.o: %.cc
	$(XCXX) -c -o $*.o $(CXXFLAGS) $(ECOS_GLOBAL_CFLAGS) $<

config_error:
	@echo "*************************************************"
	@echo "You have not run make menuconfig."
	@echo "The build sequence for this source tree is:"
	@echo "1. 'make menuconfig'"
	@echo "2. 'make'"
	@echo "*************************************************"
	@exit 1

