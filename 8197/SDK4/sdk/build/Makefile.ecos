	$(HAL_CHIPDEF_DIR)/ssw/rtk_ssw_tableField_list.o \
	$(HAL_CHIPDEF_DIR)/ssw/chip_rtl8389.o
endif
ifeq ($(CONFIG_SDK_RTL8328),y)
HAL_OBJ += \
	$(HAL_MAC_DIR)/mac_debug.o \
	$(HAL_CHIPDEF_DIR)/esw/rtk_esw_reg_list.o \
	$(HAL_CHIPDEF_DIR)/esw/rtk_esw_regField_list.o \
	$(HAL_CHIPDEF_DIR)/esw/rtk_esw_table_list.o \
	$(HAL_CHIPDEF_DIR)/esw/rtk_esw_tableField_list.o \
	$(HAL_CHIPDEF_DIR)/esw/chip_rtl8328.o
endif

