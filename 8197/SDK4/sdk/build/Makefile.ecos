	$(HAL_PHY_DIR)/phy_8214f.o
else ifeq ($(CONFIG_SDK_RTL8214F),y)
HAL_OBJ += \
	$(HAL_PHY_DIR)/phy_8214f.o
endif
ifeq ($(CONFIG_SDK_RTL8218),y)
HAL_OBJ += \
