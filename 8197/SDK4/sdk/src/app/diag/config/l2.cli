#ifdef CMD_L2_TABLE_ADD_IP6_MCAST_SIP_DIP_VID_VLAN_ID_PORT_ALL
//l2 table configuration
//add configuration
//IPv6 multicast entry
//source IP
//destination IP
//vid configuration
//vid value, <0-4095>
//port list
//all
l2-table add ip6-mcast <IPV6ADDR:sip> <IPV6ADDR:dip> vid <UINT:vlan_id> ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_L2_TABLE_ADD_IP_MCAST_SIP_DIP_PORT_PORT_ALL_CROSS_VLAN
//l2 table configuration
//add configuration
//IP multicast entry
//source IP
//destination IP
//port configuration
//port list
//all
//cross VLAN
l2-table add ip-mcast <IPV4ADDR:sip> <IPV4ADDR:dip> port ( <PORT_LIST:port> | all ) { cross-vlan }
#endif

#ifdef CMD_L2_TABLE_ADD_IP_MCAST_SIP_DIP_VLAN_ID_PORT_ALL
//l2 table configuration
//add configuration
//IP multicast entry
//source IP
//destination IP
//vid value, <0-4095>
//port list
//all
l2-table add ip-mcast <IPV4ADDR:sip> <IPV4ADDR:dip> <UINT:vlan_id> ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_L2_TABLE_ADD_IP_MCAST_SIP_DIP_VID_VLAN_ID_PORT_ALL_CROSS_VLAN
//l2 table configuration
//add configuration
//IP multicast entry
//source IP
//destination IP
//vid configuration
//vid value, <0-4095>
//port list
//all
//cross VLAN
l2-table add ip-mcast <IPV4ADDR:sip> <IPV4ADDR:dip> vid <UINT:vlan_id> ( <PORT_LIST:port> | all ) { cross-vlan }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_MCAST_VID_MAC_PORT_ALL
//l2 table configuration
//add configuration
//multicast MAC entry
//vid value, <0-4095>
//multicast MAC address, A:B:C:D:E:F
//port list
//all
l2-table add mac-mcast <UINT:vid> <MACADDR:mac> ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_MCAST_VID_MAC_PORT_ALL_CROSS_VLAN
//l2 table configuration
//add configuration
//multicast MAC entry
//vid value, <0-4095>
//multicast MAC address, A:B:C:D:E:F
//port list
//all
//cross VLAN
l2-table add mac-mcast <UINT:vid> <MACADDR:mac> ( <PORT_LIST:port> | all )  { cross-vlan }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_UCAST_VID_MAC_PORT_PORT_AUTH_SA_BLOCK_DA_BLOCK_STATIC_NEXTHOP_SUSPEND
//l2 table configuration
//add configuration
//unicast MAC entry
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
//port configuration
//port id value
//dot1x authed entry
//source MAC blocking entry
//destination MAC blocking entry
//static entry
//nexthop entry
//suspend entry
l2-table add mac-ucast <UINT:vid> <MACADDR:mac> port <UINT:port> { auth } { sa-block  } { da-block  } { static } { nexthop } { suspend }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_UCAST_VID_MAC_PORT_PORT_AGG_VID_SA_BLOCK_DA_BLOCK_STATIC_NEXTHOP_SUSPEND
//l2 table configuration
//add configuration
//unicast MAC entry
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
//port configuration
//port id value
//aggregate vid value, <0-4095>
//source MAC blocking entry
//destination MAC blocking entry
//static entry
//nexthop entry
//suspend entry
l2-table add mac-ucast <UINT:vid> <MACADDR:mac> port <UINT:port> <UINT:agg_vid> { sa-block } { da-block } { static } { nexthop } { suspend }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_UCAST_VID_MAC_TRUNK_TRUNK_ID_AUTH_SA_BLOCK_DA_BLOCK_STATIC_NEXTHOP_SUSPEND
//l2 table configuration
//add configuration
//unicast MAC entry
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
//trunk configuration
//trunk id, value <0-7>
//dot1x authed entry
//source MAC blocking entry
//destination MAC blocking entry
//static entry
//nexthop entry
//suspend entry
l2-table add mac-ucast <UINT:vid> <MACADDR:mac> trunk <UINT:trunk_id> { auth } { sa-block  } { da-block  } { static } { nexthop } { suspend }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_UCAST_VID_MAC_PORT_SA_BLOCK_DA_BLOCK_STATIC_NEXTHOP_SUSPEND
//l2 table configuration
//add configuration
//unicast MAC entry
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
//port id value
//source MAC blocking entry
//destination MAC blocking entry
//static entry
//nexthop entry
//suspend entry
l2-table add mac-ucast <UINT:vid> <MACADDR:mac> <UINT:port> { sa-block } { da-block } { static } { nexthop } { suspend }
#endif

#ifdef CMD_L2_TABLE_ADD_MAC_UCAST_VID_MAC_PORT_AUTH_SA_BLOCK_DA_BLOCK_STATIC_NEXTHOP_SUSPEND
//l2 table configuration
//add configuration
//unicast MAC entry
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
//port id value
//dot1x authed entry
//source MAC blocking entry
//destination MAC blocking entry
//static entry
//nexthop entry
//suspend entry
l2-table add mac-ucast <UINT:vid> <MACADDR:mac> <UINT:port> { auth } { sa-block  } { da-block  } { static } { nexthop } { suspend }
#endif

#ifdef CMD_L2_TABLE_DEL_ALL_INCLUDE_STATIC
//l2 table configuration
//delete configuration
//all unicast MAC entries
//include static entries
l2-table del all { include-static }
#endif

#ifdef CMD_L2_TABLE_DEL_IP_MCAST_SIP_DIP
//l2 table configuration
//delete configuration
//IP multicast entry
//source IP address, A.B.C.D
//destination IP address, A.B.C.D
l2-table del ip-mcast <IPV4ADDR:sip> <IPV4ADDR:dip>
#endif

#ifdef CMD_L2_TABLE_DEL_IP_MCAST_SIP_DIP_VLAN_ID
