#ifdef CMD_L2_TABLE_ADD_DEL_CPU_MAC_VID_MAC
//l2 table configuration
//add configuration
//delete configuration
//CPU MAC configuration
//vid value, <0-4095>
//unicast MAC address, A:B:C:D:E:F
l2-table ( add | del ) cpu-mac <UINT:vid> <MACADDR:mac>
#endif

