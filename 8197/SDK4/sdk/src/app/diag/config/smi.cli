// Purpose : Define diag shell commands for internal GPIO.
//
// Feature : The file have include the following module and sub-modules
//           1) SMI commands.
//

#ifdef CMD_SMI_GET_SMI_GROUP
//SMI configuration
//get configuration
//SMI group
smi get <UINT:smi_group>
#endif

#ifdef CMD_SMI_SET_SMI_GROUP_SCK_PORT_SCK_PORT_SCK_PIN_SCK_PIN_SDA_PORT_SDA_PORT_SDA_PIN_SDA_PIN_TYPE_SMI_TYPE_CHIPID_SMI_CHIPID_DELAY_SMI_DELAY
//SMI configuration
//set configuration
//SMI group
//SCK GPIO port configuration
//SCK GPIO port (0 mean A, 1 mean B, ... 6 mean G)
//SCK GPIO pin configuration
//SCK GPIO pin id <0-7>
//SDA GPIO port configuration
//SDA GPIO port (0 mean A, 1 mean B, ... 6 mean G)
//SDA GPIO pin configuration
//SDA GPIO pin id <0-7>
//SMI Wave form Type
//SMI type (0 STD, 1 SI, 2 PD640xx, 3 PD690xx)
//SMI chip ID, PD type only
//SMI chipID value 0x0 if no need.
//SMI delay configuration
//SMI delay for each clock interval
smi set <UINT:smi_group> sck-port <UINT:sck_port> sck-pin <UINT:sck_pin> sda-port <UINT:sda_port> sda-pin <UINT:sda_pin> type <UINT:smi_type> chipid <UINT:smi_chipid> delay <UINT:smi_delay>
#endif

#ifdef CMD_SMI_SET_REG_SMI_GROUP_REG_ADD_REG_DATA
//SMI configuration
//set configuration
//SMI group
//Register operation
//Register Address
//Register Data
smi set reg <UINT:smi_group> <UINT:reg_add> <UINT:reg_data>
#endif

#ifdef CMD_SMI_GET_REG_SMI_GROUP_REG_ADD
//SMI configuration
//set configuration
//SMI group
//Register operation
//Register Address
smi get reg <UINT:smi_group> <UINT:reg_add>
#endif

