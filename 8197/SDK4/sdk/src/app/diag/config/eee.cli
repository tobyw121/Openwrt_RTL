#ifdef CMD_EEE_GET_PORT_ALL
//EEE configuration
//get configuration
//port list
//all ports
eee get ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_EEE_SET_PORT_ALL_STATE_DISABLE_ENABLE
//EEE configuration
//set configuration
//port list
//all ports
//state configuration
//disable function
//enable function
eee set ( <PORT_LIST:port> | all ) state ( disable | enable )
#endif

#ifdef CMD_EEEP_GET_PORT_ALL
//EEEP configuration
//get configuration
//port list
//all ports
eeep get ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_EEEP_SET_PORT_ALL_STATE_DISABLE_ENABLE
//EEEP configuration
//set configuration
//port list
//all ports
//state configuration
//disable function
//enable function
eeep set ( <PORT_LIST:port> | all ) state ( disable | enable )
#endif
