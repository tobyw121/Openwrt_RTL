#ifdef CMD_VLAN_CREATE_VID
//VLAN configuration
//create VLAN
//VLAN id
vlan create <UINT:vid>
#endif

#ifdef CMD_VLAN_DESTROY_VID
//VLAN configuration
//destroy VLAN
//VLAN id
vlan destroy <UINT:vid>
#endif

#ifdef CMD_VLAN_DESTROY_ALL_RESTORE_DEFAULT_VLAN
//VLAN configuration
//destroy VLAN
//all VLAN
//restore default VLAN after deleting
vlan destroy all { restore-default-vlan }
#endif

#ifdef CMD_VLAN_SET_VLAN_VID_FILTER_ID_FID
//VLAN configuration
//Set configuration
//VLAN entry
//VLAN id
//set filter id
//filter id
vlan set vlan <UINT:vid> filter-id <UINT:fid>
#endif

#ifdef CMD_VLAN_SET_VLAN_VID_MEMBER_MEMBER_PORTS_TAGGED_PORTS_NONE
//VLAN configuration
//set configuration
//VLAN entry
//VLAN id
//set member port (e.g. 3 or 6-8)
//member ports
//tag member ports (e.g. 3or 6-8)
//none tagged member ports
vlan set vlan <UINT:vid> member <PORT_LIST:member_ports> ( <PORT_LIST:tagged_ports> | none ) 
#endif

#ifdef CMD_VLAN_SET_VLAN_VID_MSTI_MST_ID
//VLAN configuration
//set configuration
//VLAN entry
//VLAN id
//set mst id
//mst id
vlan set vlan <UINT:vid> msti <UINT:mst_id>
#endif

#ifdef CMD_VLAN_SET_ACCEPT_FRAME_TYPE_PORTS_ALL_ALL_TAGGED_ONLY_UNTAGGED_ONLY
//VLAN configuration
//set configuration
//accept frame type
//port list
//all port
//accept all type frame
//accept tag only frame
//accept untag only frame(include priority tag)
vlan set accept-frame-type ( <PORT_LIST:ports> | all ) ( all | tagged-only | untagged-only )
#endif

#ifdef CMD_VLAN_SET_ACCEPT_FRAME_TYPE_OUTER_PORTS_ALL_ALL_TAGGED_ONLY_UNTAGGED_ONLY
//VLAN configuration
//set configuration
//accept frame type
//outer tag
//port list
//all port
//accept all type frame
//accept tag only frame
//accept untag only frame(include priority tag)
vlan set accept-frame-type outer ( <PORT_LIST:ports> | all ) ( all | tagged-only | untagged-only )
#endif

#ifdef CMD_VLAN_SET_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN function state
//enable function
//disable function
vlan set state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_INGRESS_FILTER_PORTS_ALL_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//ingress filter
//ports
//all ports
//state configuration
//enable function
//disable function
vlan set ingress-filter ( <PORT_LIST:ports> | all ) state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_EGRESS_FILTER_PORTS_ALL_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//egress filter
//ports
//all ports
//state configuration
//enable function
//disable function
vlan set egress-filter ( <PORT_LIST:ports> | all ) state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_LEAKY_PORTS_ALL_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN leaky
//ports
//all ports
//state configuration
//enable function
//disable function
vlan set vlan-leaky ( <PORT_LIST:ports> | all ) state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_INGRESS_FILTER_SYSTEM_STATE_ENABLE_DISABLE
