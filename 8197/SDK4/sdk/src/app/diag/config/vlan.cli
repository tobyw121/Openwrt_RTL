//disable tag
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_EXTRA_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//extra tag
//state configuration
//enable tag
//disable tag
vlan set ingress ( <PORT_LIST:ports> | all ) extra state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_EXTRA_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//extra tag
//state configuration
//enable tag
//disable tag
vlan set egress ( <PORT_LIST:ports> | all ) extra state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_TPID_MODE_IGR_UNTAG_EGR_TAG_ALL_PACKETS
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//TPID mode
//modify TPID for packet that received untag and transmitted as tag
//all packets
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) tpid-mode ( igr-untag-egr-tag | all-packets )
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_INNER_OUTER_TPID_TPID_IDX_MASK
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//inner tag
//outer tag
//TPID configuration
//TPID index mask
vlan set ingress ( <PORT_LIST:ports> | all ) ( inner | outer ) tpid <HEX:tpid_idx_mask>
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_EXTRA_TPID_TPID_IDX_MASK
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//extra tag
//TPID configuration
//TPID index mask
vlan set ingress ( <PORT_LIST:ports> | all ) extra tpid <HEX:tpid_idx_mask>
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_TPID_TPID_IDX
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//TPID configuration
//index of TPID entry
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) tpid <UINT:tpid_idx>
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_VID_SOURCE_ALE_ORIG_INNER_TAG_ORIG_OUTER_TAG
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//source of vid in tag
//from ALE
//from original inner tag
//from original outer tag
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) vid-source ( ale | orig-inner-tag | orig-outer-tag )
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_PRI_SOURCE_ORIG_INNER_TAG_ORIG_OUTER_TAG_NULL
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//source of priority in tag
//from original inner tag
//from original outer tag
//null
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) pri-source ( orig-inner-tag | orig-outer-tag | null )
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_KEEP_INNER_OUTER
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//keep original tag
//inner tag
//outer tag
vlan set ingress ( <PORT_LIST:ports> | all ) keep { inner } { outer }
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_INNER_OUTER_KEEP_TAG_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//inner tag
//outer tag
//keep original tag
//keep tag state
//enable function
//disable function
vlan set ingress ( <PORT_LIST:ports> | all ) ( inner | outer ) keep-tag state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_KEEP_INNER_OUTER
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//keep original tag
//inner tag
//outer tag
vlan set egress ( <PORT_LIST:ports> | all ) keep { inner } { outer }
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_KEEP_TAG_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//keep original tag
//keep tag state
//enable function
//disable function
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) keep-tag state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_TAG_MODE_PORTS_ALL_ORIGINAL_KEEP_FORMAT_PRIORITY_TAG
//VLAN configuration
//set configuration
//egress Tag mode
//ports
//all ports
//follow VLAN table
//keep original VLAN format
//priority tag format(vid is 0)
vlan set tag-mode ( <PORT_LIST:ports> | all ) ( original | keep-format | priority-tag )
#endif

#ifdef CMD_VLAN_SET_FORWARDING_MODE_VID_ALE_VLAN_MEMBER
//VLAN configuration
//set configuration
//forwarding mode
//VLAN id
//forward based on ALE's decision
//forward to member of VLAN
vlan set forwarding-mode <UINT:vid> ( ale | vlan-member )
#endif

#ifdef CMD_VLAN_SET_VLAN_VID_PROFILE_INDEX_INDEX
//VLAN configuration
//set configuration
//VLAN entry
//VLAN id
//set profile index
//profile index
vlan set vlan <UINT:vid> profile-index <UINT:index>
#endif

#ifdef CMD_VLAN_SET_PROFILE_INDEX_SA_LEARNING_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//profile configuration
//profile index
//sa learning configuration
//state configuration
//enable
//disable
vlan set profile <UINT:index> sa-learning state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_PROFILE_INDEX_L2_DLF_PM_IDX_IP4_DLF_PM_IDX_IP6_DLF_PM_IDX_PMASK_INDEX
//VLAN configuration
//set configuration
//profile configuration
//profile index
//set flooding portmask for unknown L2 mutlicast traffic
//set flooding portmask for unknown IP4 mutlicast traffic
//set flooding portmask for unknown IP6 mutlicast traffic
//index points to L2 multicast table
vlan set profile <UINT:index> ( l2-dlf-pm-idx | ip4-dlf-pm-idx | ip6-dlf-pm-idx ) <UINT:pmask_index>
#endif

#ifdef CMD_VLAN_SET_INGRESS_FILTER_ACTION_PORTS_ALL_FORWARD_DROP_TRAP
//VLAN configuration
//set configuration
//ingress filter
//ports
//all ports
//action to take when violate ingress filter
//forward packet
//drop packet
//trap packet to CPU
vlan set ingress-filter-action ( <PORT_LIST:ports> | all )  ( forward | drop | trap )
#endif

#ifdef CMD_VLAN_SET_PVID_MODE_INNER_OUTER_PORTS_ALL_ALL_UNTAG_ONLY_UNTAG_AND_PRIORITY_TAG
//VLAN configuration
//set configuration
//apply port based VLAN on specific packet format
//inner tag
//outer tag
//ports
//all ports
//all packet
//untag packet only
//untag and priority tag packet
vlan set pvid-mode ( inner | outer ) ( <PORT_LIST:ports> | all ) ( all | untag-only | untag-and-priority-tag )
#endif

#ifdef CMD_VLAN_SET_MAC_BASED_VLAN_INDEX_ENTRY_MAC_VID_PRIORITY
//VLAN configuration
//set configuration
//mac-based VLAN configuration
//entry index
//entry configuration
//source MAC address
//vid
//priority
vlan set mac-based-vlan <UINT:index> entry <MACADDR:mac> <UINT:vid> <UINT:priority>
#endif

#ifdef CMD_VLAN_SET_MAC_BASED_VLAN_INDEX_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//mac-based VLAN configuration
//entry index
//state configuration
//enable
//disable
vlan set mac-based-vlan <UINT:index> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_IP_SUBNET_BASED_VLAN_INDEX_ENTRY_SIP_SIPMASK_VID_PRIORITY
//VLAN configuration
//set configuration
//ip-subnet-based VLAN configuration
//entry index
//entry configuration
//source IP address
//source IP address mask
//vid
//priority
vlan set ip-subnet-based-vlan <UINT:index> entry <IPV4ADDR:sip> <IPV4ADDR:sipmask> <UINT:vid> <UINT:priority>
#endif

#ifdef CMD_VLAN_SET_IP_SUBNET_BASED_VLAN_INDEX_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//ip-subnet-based VLAN configuration
//entry index
//state configuration
//enable
//disable
vlan set ip-subnet-based-vlan <UINT:index> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_BLOCK_MODE_INDEX_CONVERSION_MAC_BASED_IP_SUBNET_BASED
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//block mode
//block index
//set block mode to ingress vlan conversion
//set block mode to mac-based-vlan
//set block mode to ip-subnet-based-vlan
vlan set vlan-conversion ingress block-mode <UINT:index> ( conversion | mac-based | ip-subnet-based )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//state configuration
//enable
//disable
vlan set vlan-conversion ingress entry <UINT:index> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_KEY_VID_VID_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//comparing key
//key vid
//vid to compare
//comparing state
//enable comparing
//disable comparing
vlan set vlan-conversion ingress entry <UINT:index> key vid  <UINT:vid> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_KEY_RANGE_CHECK_RANGE_CHECK_BITMASK_MASK_RANGE_CHECK_MASK
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//comparing key
//key range check
//bitmask result of range check configurations
//key range check mask
//range check mask bits
vlan set vlan-conversion ingress entry <UINT:index> key range-check <HEX:range_check_bitmask> mask <HEX:range_check_mask>
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_KEY_PRIORITY_PRIORITY_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//comparing key
//key priority
//priority to compare
//comparing state
//enable comparing
//disable comparing
vlan set vlan-conversion ingress entry <UINT:index> key priority  <UINT:priority> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_KEY_PORT_PORT_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//comparing key
//key port
//port ID to compare
//comparing state
//enable comparing
//disable comparing
vlan set vlan-conversion ingress entry <UINT:index> key port  <UINT:port> state  ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_DATA_VID_SELECT_INNER_OUTER
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//entry data
//specify target vid to conver to
//inner vlan
//outer vlan
vlan set vlan-conversion ingress entry <UINT:index> data  vid-select  ( inner | outer )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_DATA_VID_VID_FORCE_SHIFT
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//entry data
//specify vid
//vid to assign or shift
//directly assign
//shift operation
vlan set vlan-conversion ingress entry <UINT:index> data vid <UINT:vid> ( force | shift )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_DATA_PRIORITY_PRIORITY_FORCE_NONE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//entry data
//specify 1p priority
//priority to assign
//force priority
//don't force priority
vlan set vlan-conversion ingress entry <UINT:index> data priority <UINT:priority> ( force | none )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_DATA_STATUS_INNER_OUTER_UNTAG_TAG_NONE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//entry data
//specify tag status
//inner tag
//outer tag
//force outgoing packet to be untag
//force outgoing packet to be tag
//don't force tag status
vlan set vlan-conversion ingress entry <UINT:index> data status ( inner | outer ) ( untag | tag | none )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_INGRESS_ENTRY_INDEX_DATA_TPID_TPID_INDEX_FORCE_NONE
//VLAN configuration
//set configuration
//VLAN conversion
//ingress configuration
//entry configuration
//entry index
//entry data
//specify tpid index
//tpid index
//force TPID value of egress tagged packet
//don't force TPID value
vlan set vlan-conversion ingress entry <UINT:index> data tpid <UINT:tpid_index> ( force | none )
#endif

#ifdef CMD_VLAN_SET_TPID_INNER_OUTER_EXTRA_TPID_IDX_TPID
//VLAN configuration
//set configuration
//TPID configuration
//inner tag TPID
//outer tag TPID
//extra tag TPID
//index of TPID entry
//TPID
vlan set tpid ( inner | outer | extra ) <UINT:tpid_idx> <HEX:tpid>
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_STATUS_UNTAG_PRIORITY_TAG_TAG
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
//inner tag
//outer tag
//tag status configuration
//outgoing packet is untag
//outgoing packet is priority-tag
//outgoing packet is tag
vlan set egress ( <PORT_LIST:ports> | all ) ( inner | outer ) status ( untag | priority-tag | tag )
#endif

#ifdef CMD_VLAN_SET_VLAN_CONVERSION_EGRESS_DOBULE_TAG_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//VLAN conversion
