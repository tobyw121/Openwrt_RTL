#ifdef CMD_VLAN_SET_PVID_PORTS_ALL_PVID
//VLAN configuration
//set configuration
//config port based vid
//ports
//all ports
//pvid
vlan set pvid ( <PORT_LIST:ports> | all ) <UINT:pvid>
#endif

#ifdef CMD_VLAN_SET_PVID_OUTER_PORTS_ALL_PVID
//VLAN configuration
//set configuration
//config port based vid
//outer tagged
//ports
//all ports
//pvid
vlan set pvid outer ( <PORT_LIST:ports> | all ) <UINT:pvid>
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_GROUP_INDEX_FRAME_TYPE_ETHERNET_SNAP_LLC_OTHER_FRAME_VALUE
//VLAN configuration
//set configuration
//protocol VLAN configuration
//protocol group
//group index
//frame type
//ethernet
//snap
//llc-OTHER
//frame value
vlan set protocol-vlan group <UINT:index> frame-type ( ethernet | snap | llc-other ) <HEX:frame_value>
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_PORTS_ALL_GROUP_INDEX_VID_PRIORITY
//VLAN configuration
//set configuration
//protocol VLAN configuration
//ports
//all ports
//config action of group
//group index
//vid
//priority
vlan set protocol-vlan ( <PORT_LIST:ports> | all ) group <UINT:index> <UINT:vid> <UINT:priority>
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_PORTS_ALL_GROUP_INDEX_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//protocol VLAN configuration
//ports
//all ports
//config action of group
//group index
//state of protocol-vlan
//enable function
//disable function
vlan set protocol-vlan ( <PORT_LIST:ports> | all ) group <UINT:index> state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_OUTER_PORTS_ALL_GROUP_INDEX_VID_PRIORITY_DEI
//VLAN configuration
//set configuration
//protocol VLAN configuration
//outer tag
//ports
//all ports
//config action of group
//group index
//vid
//priority
//DEI
vlan set protocol-vlan outer ( <PORT_LIST:ports> | all ) group <UINT:index> <UINT:vid> <UINT:priority> <UINT:dei>
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_PORTS_ALL_GROUP_INDEX_DISABLE
//VLAN configuration
//set configuration
//protocol VLAN configuration
//ports
//all ports
//config action of group
//group index
//disable protocol VLAN of this protocol group
vlan set protocol-vlan ( <PORT_LIST:ports> | all ) group <UINT:index> disable
#endif

#ifdef CMD_VLAN_SET_PROTOCOL_VLAN_OUTER_PORTS_ALL_GROUP_INDEX_DISABLE
//VLAN configuration
//set configuration
//protocol VLAN configuration
//outer tag
//ports
//all ports
//config action of group
//group index
//disable protocol VLAN of this protocol group
vlan set protocol-vlan outer ( <PORT_LIST:ports> | all ) group <UINT:index> disable
#endif

#ifdef CMD_VLAN_SET_TPID_PORTS_ALL_TPID_IDX_TPID
//VLAN configuration
//set configuration
//TPID configuration
//ports
//all ports
//index of TPID entry
//TPID
vlan set tpid ( <PORT_LIST:ports> | all ) <UINT:tpid_idx> <HEX:tpid>
#endif

#ifdef CMD_VLAN_SET_INGRESS_PORTS_ALL_INNER_OUTER_IGNORE_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//ingress port configuration
//ports
//all ports
//inner tag
//outer tag
//ignore tag of packet
//state configuration
//enable function
//disable function
vlan set ingress ( <PORT_LIST:ports> | all ) ( inner | outer ) ignore state ( enable | disable )
#endif

#ifdef CMD_VLAN_SET_EGRESS_PORTS_ALL_INNER_OUTER_STATE_ENABLE_DISABLE
//VLAN configuration
//set configuration
//egress port configuration
//ports
//all ports
