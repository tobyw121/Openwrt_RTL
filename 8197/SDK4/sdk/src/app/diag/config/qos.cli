qos set remapping dei system <UINT:dei_value> <UINT:drop_precedence>
#endif

#ifdef CMD_QOS_SET_REMAPPING_DEI_TAG_SELECTOR_PORT_PORTS_ALL_INNER_TAG_OUTER_TAG
//QoS configuration
//set configuration
//drop precedence(DP) remapping
//DEI remapping
//tag selection
//port configuration
//port list
//all ports
//inner-tag. Remapping inner-tag CFI/DEI for getting DP value
//outer-tag. Remapping outer-tag CFI/DEI for getting DP value
qos set remapping dei tag-selector port ( <PORT_LIST:ports> | all ) ( inner-tag | outer-tag )
#endif

