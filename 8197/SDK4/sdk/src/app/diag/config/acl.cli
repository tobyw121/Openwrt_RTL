#ifdef CMD_ACL_SET_METER_BURST_SIZE_BYTE_PACKET_DLB_SRTCM_TRTCM_LB0BS_LB1BS
//ACL configuration
//set configuration
//meter configuration
//meter burst-size configuration
//byte based mode
//packet based mode
//dual leaky bucket
//single rate three color marker
//two rate three color marker
//leaky bucket 0 burst size (DLB) or committed burst size (SrTCM or TrTCM)  (unit:128 bytes or 1 packet)
//leaky bucket 1 burst size (DLB) or excess burst size (SrTCM) or peak burst size (TrTCM)  (unit:128 bytes or 1 packet)
acl set meter burst-size ( byte | packet ) ( dlb | srtcm | trtcm ) <UINT:lb0bs> <UINT:lb1bs>
#endif

#ifdef CMD_ACL_SET_METER_ENTRY_INDEX_DLB_LB0_RATE_LB1_RATE
