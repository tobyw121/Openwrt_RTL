//meter configuration
//meter entry configuration
//meter index
//dual leaky bucket
//Leaky bucket 0 rate  (unit:16 Kbps or 1 packet per sec)
//Leaky bucket 1 rate  (unit:16 Kbps or 1 packet per sec)
acl set meter entry <UINT:index> dlb <UINT:lb0_rate> <UINT:lb1_rate>
#endif

