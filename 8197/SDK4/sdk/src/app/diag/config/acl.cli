//field selector index
field-selector get <UINT:index>
#endif

#ifdef CMD_FIELD_SELECTOR_SET_INDEX_CONTENT_RAW_LLC_L3_ARP_IPV4_IPV6_IP_L4_OFFSET
//field selector configuration
//set configuration
//field selector index
//field selector content
//Raw packet(Start after SFD¡Abegin with DA)
//LLC packet(begin with length 0000-05FF)
//L3 packet(Start after Ethertype field¡AVLAN tag is bypassed)
//ARP/RARP packet (Start from ARP/RARP header)
//IPv4 packet (Start from IPv4 header)
//IPv6 packet (Start from IPv6 header)
//IP payload(Start from IP payload¡Aalso means start of layer 4 packet)
//L4 payload (Start after TCP/UDP header¡AICMP/IGMP is not supported)
//offset from starting position
field-selector set <UINT:index> content ( raw | llc | l3 | arp | ipv4 | ipv6 | ip | l4 ) <UINT:offset>
#endif

