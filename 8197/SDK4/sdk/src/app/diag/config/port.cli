#ifdef CMD_PORT_SET_RLDP_HELLO_TIME_NORMAL_LOOP_AGING_TIME_SELF_LOOP_AGING_TIME_PORT_ALL_1S_2S_4S_8S
//port configuration
//set configuration
//RLDP configuration
//hello time configuration
//normal loop aging time configuration
//self loop aging time configuration
//port list
//all port
//1 second
//2 seconds
//4 seconds
//8 seconds
port set rldp ( hello-time | normal-loop-aging-time | self-loop-aging-time ) ( <PORT_LIST:port> | all ) ( 1s | 2s | 4s | 8s )
#endif

#ifdef CMD_PORT_SET_UDLD_AUTO_DISABLE_PORT_LED_INDICATION_LINKUP_AUTO_TRIG_STATE_DISABLE_ENABLE
//port configuration
//set configuration
//UDLD configuration
//auto disable port
//led indication configuration
//linkup auto trigger
//state configuration
//disable function
//enable function
port set udld ( auto-disable-port | led-indication | linkup-auto-trig ) state ( disable | enable )
#endif

#ifdef CMD_PORT_SET_UDLD_ECHO_GENERATE_INTERVAL_2S_4S_8S_16S
//port configuration
//set configuration
//UDLD configuration
//echo generator interval configuration
//2 seconds
