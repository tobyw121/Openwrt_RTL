//port list include CPU port
//all port
//mmd device address
//mmd register address
//mmd register numbers
port get phy-mmd-reg ( <PORT_LIST:port> | all ) <UINT:mmd_addr> <UINT:mmd_reg> { <UINT:number> }
#endif

