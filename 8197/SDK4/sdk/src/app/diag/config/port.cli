#ifdef CMD_PORT_DUMP_CPU_PORT
//port configuration
//dump configuration
//CPU port id
port dump cpu-port
#endif

#ifdef CMD_PORT_DUMP_ISOLATION_PORT_ALL
//port configuration
//dump configuration
//traffic isolation configuration
//port list
//all ports
port dump isolation ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_PORT_DUMP_PORT_ALL
//port configuration
//dump configuration
//port list
//all ports
port dump ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_PORT_DUMP_RLDP_PORT_ALL
//port configuration
//dump configurration
//RLDP configuration
//port list
//all ports
port dump rldp ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_PORT_DUMP_UDLD_PORT_ALL
//port configuration
//dump configuration
//UDLD configuration
//port list
//all ports
port dump udld { ( <PORT_LIST:port> | all ) }
#endif

#ifdef CMD_PORT_DUMP_ISOLATION_VLAN_BASED
//port configuration
//dump configuration
//traffic isolation configuration
//VLAN based configuration
port dump isolation vlan-based
#endif

