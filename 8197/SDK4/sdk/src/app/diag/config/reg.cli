//
// Purpose : Define diag shell commands for reg.
//
// Feature : The file have include the following module and sub-modules
//           1) reg commands.
//

#ifdef CMD_REGISTER_SET_ADDRESS_VALUE
//register configuration
//set register
//register address
//register value
register set <UINT:address> <UINT:value>
#endif

#ifdef CMD_REGISTER_GET_ADDRESS_WORDS
//register configuration
//get register
//register address
//number of words
register get <UINT:address> { <UINT:words> }
#endif

#ifdef CMD_REGISTER_GET_ALL
//register configuration
//get register
//all register
register get all
#endif

