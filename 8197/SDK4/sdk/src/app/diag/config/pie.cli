pie get police <UINT:index>
#endif

#ifdef CMD_PIE_SET_COUNTER_INDEX_BYTE_PACKET_COUNTER
//PIE configuration
//set configuration
//counter configuration
//counter index
//byte count
//packet count
//counter value
pie set counter <UINT:index> ( byte | packet ) <UINT64:counter>
