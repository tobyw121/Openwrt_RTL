#ifdef CMD_PIE_SET_ACTION_INDEX_STATISTIC_BYTE32_BYTE64_NONE_PKT
//PIE configuration
//set configuration
//action configuration
//action index
//statistic action
//count pkts number in the unit of byte, 32-bit counter mode
//count pkts length in the unit of byte, 64-bit counter mode
//don't count in this entry
//count pkts number, 32-bit counter mode
pie set action <UINT:index> statistic ( byte32 | byte64 | none | pkt ) 
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_DROP_MODE_DROP_PERMIT_WITHDRAW_DROP
//PIE configuration
//set configuration
//action configuration
//action index
//drop action
//drop
//permit
//withdraw drop
pie set action <UINT:index> drop-mode ( drop | permit | withdraw-drop )
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_INNER_TAG_OUTER_TAG_WITHDRAW_STATE_DISABLE_ENABLE
//PIE configuration
//set configuration
//action configuration
//action index
//inner VLAN tag operation
//outer VLAN tag operation
//withdraw VLAN tag operation
//state configuration
//disable action
//enable action
pie set action <UINT:index> ( inner-tag | outer-tag ) withdraw state ( disable | enable )
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_INNER_TAG_OUTER_TAG_AS_VID_INFO_MINUS_VID_INFO_PLUS_VID_INFO_VID_INFO_KEEP_FORMAT_NOP_WITH_TAG_WITHOUT_TAG
//PIE configuration
//set configuration
//action configuration
//action index
//inner VLAN tag operation
//outer VLAN tag operation
//vid_info provide new inner VID
//packet's new inner VID = packet's tag VID - vid_info
//packet's new inner VID = packet's tag VID + vid_info.
//VID information
//keep VLAN tag and VID
//no operation
//packet sent with VLAN tag
//packet sent without VLAN tag
pie set action <UINT:index> ( inner-tag | outer-tag ) ( as-vid-info | minus-vid-info | plus-vid-info ) <UINT:vid_info> ( keep-format | nop | with-tag | without-tag )
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_REDIRECT_WITHDRAW_STATE_DISABLE_ENABLE
//PIE configuration
//set configuration
//action configuration
//action index
//redirect action
//withdraw redirect
//state configuration
//disable action
//enable action
pie set action <UINT:index> redirect withdraw state ( disable | enable )
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_REDIRECT_MULTI_REDIRECT_FWD_INDEX
//PIE configuration
//set configuration
//action configuration
//action index
//redirect action
//multiple ports redirection
//forwarding table index
pie set action <UINT:index> redirect multi-redirect <UINT:fwd_index>
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_REDIRECT_UNI_REDIRECT_WITH_CPU_TAG_WITHOUT_CPU_TAG_DPN
//PIE configuration
//set configuration
//action configuration
//action index
//redirect action
//single port redirection
//with CPU tag when trap to CPU
//without CPU tag when trap to CPU
//destination port number (DPN 28 means normal forward to CPU port, DPN 29 means trap to CPU, DPN 30 means drop, DPN 31 means flood)
pie set action <UINT:index> redirect uni-redirect ( with-cpu-tag | without-cpu-tag ) <UINT:dpn>
#endif

#ifdef CMD_PIE_SET_ACTION_INDEX_REDIRECT_MULTI_ROUTE_UNI_ROUTE_TTL_KEEP_MINUS_ONE_LOOKUP_INDEX
//PIE configuration
//set configuration
//action configuration
//action index
//redirect action
//IP multicast routing
//IP unicast routing
//TTL decreases or not
//keep TTL
//TTL minus one
//index to address lookup table
pie set action <UINT:index> redirect ( multi-route | uni-route ) ttl ( keep | minus-one ) <UINT:lookup_index>
#endif

