#ifdef CMD_FIELD_SELECTOR_SET_PORT_ALL_INDEX_CONTENT_8021Q_ARP_IPV4_IPV6_L4_HEADER_LLC_RAW_TCP_UDP_PAYLOAD_OFFSET0_OFFSET1_OFFSET2_OFFSET3
//field selector configuration
//set configuration
//port list
//all ports
//field selector index
//field selector content
//802.1Q packet (started after first ITAG ID (0x8100) or OTAG ID (0x88a8))
//ARP Packet (started after Ethernet II EtherType 0x0806)
//IPv4 Packet (started from start of IPv4 header)
//IPv6 Packet (started from start of IPv6 header)
//TCP/UDP/ICMP/IGMP/ICMPv6 Packet (Started from start of L4 header)
//LLC packet
//raw packet(Start after preamble,begin with DA)
//TCP/UDP Payload (Started after TCP/UDP header)
//offset from starting position of block 0
//offset from starting position of block 1
//offset from starting position of block 2
//offset from starting position of block 3
field-selector set ( <PORT_LIST:port> | all ) <UINT:index> content ( 8021q | arp | ipv4 | ipv6 | l4-header | llc | raw | tcp-udp-payload ) <UINT:offset0> <UINT:offset1> <UINT:offset2> <UINT:offset3>
#endif

#ifdef CMD_FIELD_SELECTOR_GET_PORT_ALL
//field selector configuration
//get configuration
//port list
//all ports
field-selector get ( <PORT_LIST:port> | all )
#endif

