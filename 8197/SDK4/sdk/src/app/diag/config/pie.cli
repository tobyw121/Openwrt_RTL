#ifdef CMD_PIE_SET_TEMPLATE_INDEX_FIELD_INDEX_DIP0_DIP1_DIP2_DIP3_DIP4_DIP5_DIP6_DIP7_DMAC0_DMAC1_RRCPINFO_DMAC2_DPM1_DPM2_DPN_ETHERTYPE_FIELD_SELECTOR1_0_FIELD_SELECTOR1_1_FIELD_SELECTOR1_2_FIELD_SELECTOR1_3_FIELD_SELECTOR2_0_FIELD_SELECTOR2_1_FIELD_SELECTOR2_2_FIELD_SELECTOR2_3_FMT_FWD_ITAG_FWD_OTAG_DPRI_FWD_VID_GUEST_VLAN_ICMP_CODE_TYPE_IGMP_TYPE_IP6_FLWH_IP_RANGE1_IP_RANGE2_IP_RANGE3_IP_RANGE4_ITAG_L4_DPORT_L4_SPORT_OTAG_PATTERN_MATCH0_PATTERN_MATCH1_PAYLOAD0_PAYLOAD1_PORT_RANGE_SIP0_SIP1_SIP2_SIP3_SIP4_SIP5_SIP6_SIP7_SMAC0_SMAC1_SMAC2_SPM1_SPM2_SPSM_TCP_FLAG_TOS_PROTO_TTL_FLAG_VID_RANGE
//PIE configuration
//set configuration
//template configuration
//template index
//template field index
//IPv6 DIP[15:0] or IPv4 DIP[15:0]
//IPv6 DIP[31:16] or IPv4 DIP[31:16]
//IPv6 DIP[47:32]
//IPv6 DIP[63:48]
//IPv6 DIP[79:64]
//IPv6 DIP[95:80]
//IPv6 DIP[111:96]
//IPv6 DIP[127:112]
//DMAC[15:0]
//DMAC[31:16]
//DMAC[47:32]
//PPI.DPM[28:13]{15:0}
//PPI.DPM[12:0]{15:3} + PPI.CPU{2} + PPI.COPYTOCPU{1} 
//PPI.DPN{15:11} + payload0 valid{10} + payload1 valid{9}
//ethernet type
//HSB.FS1[15:0]{15:0}
//HSB.FS1[31:16]{15:0}
//HSB.FS1[47:32]{15:0}
//HSB.FS1[63:48]{15:0}
//HSB.FS2[15:0]{15:0}
//HSB.FS2[31:16]{15:0}
//HSB.FS2[47:32]{15:0}
//HSB.FS2[63:48]{15:0}
//LP{15:14}+PPI.SPH{13:9}+TGL2FMT{8:7}+HSB.EXTRATAG{6}+TGL23FMT{5:4}+TGL4FMT{3:1}+HSB.PPPoE{0}
//PPI.PRI{15:13}+RESERVED{12}+PPI.IVID{11:0}
//PPI.PRI{15:13}+HSB.CPUTAG{12}+PPI.OVID{11:0}
//PPI.PRI{15:13}+ RESERVED{12}+ PPI.OVID{11:0} OR PPI.IVID{11:0}
//PPI.toGVLAN{15} + PPI.orgVID{14:3}
//ICMP Code{15:8} + Type{7:0}
//IGMP Type{15:8}
//FlowLabel[19:4]{15:0}
//IPRC[15:0]
//IPRC[31:16]
//IPRC[47:32]
//IPRC[63:48]
//HSB.IPRI{15:13}+HSB.CFI{12}+HSB.IVID{11:0}
//Layer4 Destination Port
//Layer4 Sorce Port
//HSB.OPRI{15:13}+HSB.DEI{12}+HSB.OVID{11:0}
//HSB.PM[15:0]{15:0}
//HSB.PM[31:16]{15:0}
//Content0 of HSB.PAYLOAD
//Content1 of HSB.PAYLOAD
//PRC[15:0]
//IPv6 SIP[15:0] or IPv4 SIP[15:0]
//IPv6 SIP[31:16] or IPv4 SIP[31:16]
//IPv6 SIP[47:32]
//IPv6 SIP[63:48]
//IPv6 SIP[79:64]
//IPv6 SIP[95:80]
//IPv6 SIP[111:96]
//IPv6 SIP[127:112]
//SMAC[15:0]
//SMAC[31:16]
//SMAC[47:32]
//PPI.SPHY[28:13]{15:0}
//PPI.SPHY[12:0]{15:3}+HSB.DATYPE{2:1}+CTLPKT{0}
//PPI.SPM
//TCP Flag(6-bit){15:10} + IPv6 FLowLabel[3:0]{9:6}+RESERVED{5:0}
//IPv4 TOS{15:8} + Protocol{7:0}
//TTL(8){15:8} + TTL(2){7:6} + DF{5} + MF{4} + NonzeroOffset{3} + PPI.REDIR{2} + PPI.IPUC{1} + PPI.IPMC{0}
//VIDRCH {15} + VIDRC[4:0]{14:10} + HSB.FS1[64]{9}+HSB.FS2[64]{8} + HSB.RTKPRO{6:4} + PPI.DP{3:2}
pie set template <UINT:index> <UINT:field_index> ( dip0 | dip1 | dip2 | dip3 | dip4 | dip5 | dip6 | dip7 | dmac0 | dmac1-rrcpinfo | dmac2 | dpm1 | dpm2 | dpn | ethertype | field-selector1_0 | field-selector1_1 | field-selector1_2 | field-selector1_3 | field-selector2_0 | field-selector2_1 | field-selector2_2 | field-selector2_3 | fmt | fwd-itag | fwd-otag-dpri | fwd-vid | guest-vlan | icmp-code-type | igmp-type | ip6-flwh | ip-range1 | ip-range2 | ip-range3 | ip-range4 | itag | l4-dport | l4-sport | otag | pattern-match0 | pattern-match1 | payload0 | payload1 | port-range | sip0 | sip1 | sip2 | sip3 | sip4 | sip5 | sip6 | sip7 | smac0 | smac1 | smac2 | spm1 | spm2 | spsm | tcp-flag | tos-proto | ttl-flag | vid-range )
#endif

#ifdef CMD_PIE_GET_TEMPLATE_INDEX
//PIE configuration
//get configuration
//template configuration
//template index
pie get template <UINT:index>
#endif

