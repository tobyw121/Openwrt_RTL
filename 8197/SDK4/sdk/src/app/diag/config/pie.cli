#ifdef CMD_PIE_DEL_ACTION_ENTRY_ACTION_AND_ENTRY_START
//PIE configuration
//delete configuration
//action configuration
//entry configuration
//action and entry configuration
//start from this index
pie del ( action | entry | action_and_entry ) <UINT:start>
#endif

#ifdef CMD_PIE_DEL_ACTION_ENTRY_ACTION_AND_ENTRY_START_END
//PIE configuration
//delete configuration
//action configuration
//entry configuration
//action and entry configuration
//start from this index
//end to this index
pie del ( action | entry | action_and_entry ) <UINT:start> <UINT:end>
#endif

#ifdef CMD_PIE_SET_ACTION_ENTRY_ACTION_AND_ENTRY_MOVE_SWAP_FROM_TO_ENTRY_LEN_DECREASE_INCREASE
//PIE configuration
//set configuration
//action configuration
//entry configuration
//action and entry configuration
//move content
//swap content
//start from this index
//end to this index
//entry length
//the address of unit operated next time will be one step decrease
//the address of unit operated next time will be one step increase
pie set ( action | entry | action_and_entry ) ( move | swap ) <UINT:from> <UINT:to> <UINT:entry_len> ( decrease | increase )
#endif

#ifdef CMD_PIE_SET_POLICE_INDEX_INVALID
//PIE configuration
//set configuration
//police configuration
//police index
//invalid police entry
pie set police <UINT:index> invalid
#endif

#ifdef CMD_PIE_SET_POLICE_INDEX_DLB_SRTCM_TRTCM_YELLOW_DP_RED_DP_PIR_CIR_PBS_CBS
//PIE configuration
//set configuration
//police configuration
//police index
//dual leaky bucket
//single rate three color marker
//two rate three color marker
//drop precedence to replace YELLOW packet drop precedence. If yellow_dp is 3, drop this packet
//drop precedence to replace RED packet drop precedence. The most significant bit is always 1, this bit specify the last significant bit. If bit is 0, the RED drop precedence is 2. If bit is 1, the RED drop precedence is 3.
//peak Information Rate in units of 16Kbps
//committed Information Rate in units of 16Kbps
//peak Burst Size (trTCM), Excess Burst Size (EBS) (unit: 128byte)
//committed Burst Size in byte units (unit: 128byte)
pie set police <UINT:index> ( dlb | srtcm | trtcm ) <UINT:yellow_dp> <UINT:red_dp> <UINT:pir> <UINT:cir> <UINT:pbs> <UINT:cbs>
#endif

#ifdef CMD_PIE_SET_POLICE_INDEX_DLB_SRTCM_TRTCM_COLOR_AWARE_YELLOW_DP_RED_DP_PIR_CIR_PBS_CBS
//PIE configuration
//set configuration
//police configuration
//police index
//dual leaky bucket
//single rate three color marker
//two rate three color marker
//policer is color aware. This bit takes effect when policer is RFC2697 or RFC2698.
//drop precedence to replace YELLOW packet drop precedence. If yellow_dp=3, drop this packet
//drop precedence to replace RED packet drop precedence. The most significant bit is always 1, this bit specify the last significant bit. If bit=0, the RED is 2. If bit=1, the RED is 3.
//peak Information Rate in units of 16Kbps
//committed Information Rate in units of 16Kbps
//peak Burst Size (trTCM), Excess Burst Size (EBS) (unit: 128byte)
//committed Burst Size in byte units (unit: 128byte)
pie set police <UINT:index> ( dlb | srtcm | trtcm ) color-aware <UINT:yellow_dp> <UINT:red_dp> <UINT:pir> <UINT:cir> <UINT:pbs> <UINT:cbs>
#endif

