#ifdef CMD_PIE_SET_RESULT_AGGREGATOR_PBLOCK_RANGE_INDEX_ENTRY_INDEX_TYPE_A01_23M0_2_A01_23M0_3_A01_23M1_2_A01_23M1_3_A0123M0_A0123M1_A0123M2_A0123M3_A01M0_A01M1_A23M2_A23M3_NONE
//PIE configuration
//set configuration
//aggregate PIE lookup result
//0:block 0-3, 1:block 4-7 ... 7:block 28-31
//block entry index (0-63)
//aggregation operation type
//0, 1 aggregate and 2, 3 aggregate. result in 0, 2
//0, 1 aggregate and 2, 3 aggregate. result in 0, 3
//0, 1 aggregate and 2, 3 aggregate. result in 1, 2
//0, 1 aggregate and 2, 3 aggregate. result in 1, 3
//0, 1, 2, 3 all aggregated. result in 0
//0, 1, 2, 3 all aggregated. result in 1
//0, 1, 2, 3 all aggregated. result in 2
//0, 1, 2, 3 all aggregated. result in 3
//0 and 1 aggregate, but 2, 3 do not aggregate. result in 0
//0 and 1 aggregate, but 2, 3 do not aggregate. result in 1
//0 and 1 do not aggregate, but 2, 3 aggregate. result in 2
//0 and 1 do not aggregate, but 2, 3 aggregate. result in 3
//not aggregation
pie set result-aggregator <UINT:pblock_range_index> <UINT:entry_index> type ( a01_23m0_2 | a01_23m0_3 | a01_23m1_2 | a01_23m1_3 | a0123m0 | a0123m1 | a0123m2 | a0123m3 | a01m0 | a01m1 | a23m2 | a23m3 | none )
#endif

