#endif  /* CMD_OAM_SET_CFM_INDEX_INDEX_MAID_MAID_INDEX_MAID_VALUE */

#ifdef CMD_OAM_SET_CFM_INDEX_INDEX_MD_LEVEL_LEVEL
//OAM configuration
