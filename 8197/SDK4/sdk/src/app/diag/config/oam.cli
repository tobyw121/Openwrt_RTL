#endif  /* CMD_OAM_SET_CFM_LOOPBACK_REPLY_PORT_ALL_STATE_DISABLE_ENABLE */

#ifdef CMD_OAM_SET_DYING_GASP_PORT_ALL_LOCAL_TLV_REMOTE_TLV_TLV_VALUE
//OAM configuration
//set configuration
//dying gasp configuration
//port list, <0-27>
//all ports
//local tlv configuration
//remote tlv configuration
//tlv value, A:B:C:D:E:F:G:H:I:J:K:L:M:N:O:P
