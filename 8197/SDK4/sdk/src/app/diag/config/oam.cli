#endif  /* CMD_OAM_SET_CFM_INDEX_INDEX_MD_LEVEL_LEVEL */

#ifdef CMD_OAM_SET_CFM_MEPID_COMPARE_PORT_ALL_STATE_DISABLE_ENABLE
