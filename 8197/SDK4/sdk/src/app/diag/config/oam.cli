#endif  /* CMD_OAM_SET_DYING_GASP_PORT_ALL_LOCAL_TLV_REMOTE_TLV_TLV_VALUE */

#ifdef CMD_OAM_SET_DYING_GASP_PORT_ALL_START
//OAM configuration
//set configuration
//dying gasp configuration
//port list, <0-27>
//all ports
//start configuration
