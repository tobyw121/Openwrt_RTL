//mib configuration
//dump configuration
//counter configuration
//debug configuration
//debug counter index, <0-44>
mib dump counter debug <UINT:index>

//mib configuration
//dump configuration
//counter configuration
//debug configuration
mib dump counter debug all

//mib configuration
//get configuration
//reset MIB value configuration
mib get rst-mib-val

//switch configuration
//get configuration
//48 pass 1 configuration
//state configuration
switch get 48-pass-1 state

//switch configuration
//get configuration
//limit pause configuration
//state configuration
switch get limit-pause state

//switch configuration
//get configuration
//IPG compensation configuration
//Giga port
//10G port
//state configuration
switch get ipg-compensation ( ge | 10g ) state

//switch configuration
//get configuration
//IPG compensation configuration
//Giga port
//10G port
switch get ipg-compensation ( ge | 10g )

//switch configuration
//get configuration
//IPG minimal receive length
//port list
//all ports
switch get ipg-min-length ( <PORT_LIST:ports> | all )

//switch configuration
//get configuration
//pass all mode configuration
//port list
//all ports
switch get pass-all-mode ( <PORT_LIST:ports> | all )

//switch configuration
//get configuration
//RX check CRC configuration
//port list
//all ports
switch get rx-check-crc ( <PORT_LIST:ports> | all )

//switch configuration
//get configuration
//bypass TX CRC configuration
//port list
//all ports
switch get bypass-tx-crc ( <PORT_LIST:ports> | all )

//switch configuration
//get configuration
//backpressure configuration
switch get back-pressure

//switch configuration
//get configuration
//padding the packet length to 64-Byte for under size packets configuration
//port list
//all ports
//state configuration
switch get padding-und-size ( <PORT_LIST:ports> | all ) state

//QoS configuration
//get configuration
//queue configuration
//number of queue
//port configuration
//port list
//all ports
qos get queue number port ( <PORT_LIST:ports> | all )

//flowctrl configuration
//get configuration
//used page count information
//ingress configuration
//egress configuration
//port list
//all ports
flowctrl get used-page-cnt ( ingress | egress ) ( <PORT_LIST:ports> | all )

//flowctrl configuration
//get configuration
//used page count information
//system configuration
flowctrl get used-page-cnt system

//flowctrl configuration
//get configuration
//used page count information
//queue-based
//port list
//all ports
flowctrl get used-page-cnt queue-based ( <PORT_LIST:ports> | all )

//flowctrl configuration
//reset configuration
//used page count information
//ingress configuration
//egress configuration
//port list
//all ports
flowctrl reset used-page-cnt ( ingress | egress ) ( <PORT_LIST:ports> | all )

//flowctrl configuration
//reset configuration
//used page count information
//system configuration
flowctrl reset used-page-cnt system

//port configuration
//get configuration
//port list
//all port
//MAC state configuration
port get ( <PORT_LIST:port> | all ) mac-state

//port configuration
//get configuration
//special-congest
//drain-out-thresh
port get special-congest drain-out-thresh

//port configuration
//get configuration
//special-congest
//port list
//all port
port get special-congest port ( <PORT_LIST:ports> | all )

//mib configuration
//set configuration
//reset MIB value configuration
//all MIB to be 0
//all MIB to be 0xFFFF-FFFF
mib set rst-mib-val ( 0 | 1 )

//SQA configuration
//reset to default configuration
sqa reset

//switch configuration
//set configuration
//48 pass 1 configuration
//state configuration
//disable function
//enable function
switch set 48-pass-1 state ( disable | enable )

//switch configuration
//set configuration
//limit pause configuration
//state configuration
//disable function
//enable function
switch set limit-pause state ( disable | enable )

//switch configuration
//set configuration
//IPG compensation configuration
//Giga port
//10G port
//state configuration
//disable function
//enable function
switch set ipg-compensation ( ge | 10g ) state ( disable | enable )

//switch configuration
//set configuration
//IPG compensation configuration
//Giga port
//10G port
//65ppm
//90ppm
switch set ipg-compensation ( ge | 10g ) ( 65ppm | 90ppm )

//switch configuration
//set configuration
//IPG minimal receive length
//port list
//all ports
//length in byte, <4-8>
switch set ipg-min-length ( <PORT_LIST:ports> | all ) <UINT:length>

//switch configuration
//set configuration
//pass all mode configuration
//port list
//all ports
//state configuration
//disable function
//enable function
switch set pass-all-mode ( <PORT_LIST:ports> | all ) state ( disable | enable )

//switch configuration
//set configuration
//RX check CRC configuration
//port list
//all ports
//state configuration
//disable function
//enable function
switch set rx-check-crc ( <PORT_LIST:ports> | all ) state ( disable | enable )

//switch configuration
//set configuration
//bypass TX CRC configuration
//port list
//all ports
//state configuration
//disable function
//enable function
switch set bypass-tx-crc ( <PORT_LIST:ports> | all ) state ( disable | enable )

//switch configuration
//set configuration
//backpressure configuration
//state configuration
//CRS-based backpressure
//Collision-based backpressure
switch set back-pressure ( jam | defer )

//switch configuration
//set configuration
//padding the packet length to 64-Byte for under size packets configuration
//port list
//all ports
//state configuration
//disable function
//enable function
switch set padding-und-size ( <PORT_LIST:ports> | all ) state ( disable | enable )

//QoS configuration
//set configuration
//queue configuration
//number of queue
//port configuration
//port list
//all ports
//queue number <1-8>
qos set queue number port ( <PORT_LIST:ports> | all ) <UINT:queue_num>

//port configuration
//set configuration
//port list
//all port
//MAC state configuration
//disable TX and RX
//enable TX only
//enable RX only
//enable TX and RX
port set ( <PORT_LIST:port> | all ) mac-state ( both-disable | tx-only | rx-only | both-enable )

//EEE configuration
//set configuration
//tx configuration
//wake mode configuration
//wake when there is packet to tx
//wake based on qos (high queue/ low queue)
eee set tx wake-mode ( packet-tx | qos-based )

//EEE configuration
//get configuration
//tx configuration
//wake mode configuration
eee get tx wake-mode

//EEE configuration
//get configuration
//port eee/eeep LPI status
//port list
//all ports
eee get status ( <PORT_LIST:port> | all )

//EEE configuration
//set configuration
//link up delay time
//1 ms
//256 ms
//512 ms
//1024 ms
eee set link-up-delay ( 1ms | 256ms | 512ms | 1024ms )

//EEE configuration
//get configuration
//link up delay time
eee get link-up-delay

//EEE configuration
//set configuration
//multi-wake
//state configuration
//disable function
//enable function
eee set multi-wake state ( disable | enable )

//EEE configuration
//get configuration
//multi-wake
//state configuration
eee get multi-wake state

//EEE configuration
//set configuration
//multi-wake
//interval
//1 us
//2 us
//3 us
//4 us
eee set multi-wake interval ( 1us | 2us | 3us | 4us )

//EEE configuration
//get configuration
//multi-wake
//interval
eee get multi-wake interval

//EEE configuration
//set configuration
//multi-wake
//port number of a group
//2 ports
//4 ports
//6 ports
//8 ports
//10 ports
//12 ports
//16 ports
//20 ports
eee set multi-wake port-num ( 2port | 4port | 6port | 8port | 10port | 12port | 16port | 20port )

//EEE configuration
//get configuration
//multi-wake
//port number of a group
eee get multi-wake port-num

//EEEP configuration
//set configuration
//tx configuration
//sleep rate
//rate (unit:0.5Mbps)
eeep set tx sleep-rate <UINT:rate>

//EEEP configuration
//get configuration
//tx configuration
//sleep rate
eeep get tx sleep-rate

//EEEP configuration
//set configuration
//tx configuration
//sleep rate
//rate (unit:0.5Mbps)
eeep set rx sleep-rate <UINT:rate>

//EEEP configuration
//get configuration
//tx configuration
//sleep rate
eeep get rx sleep-rate

//port configuration
//set configuration
//special-congest
//drain-out-thresh
//threshold, unit: page
port set special-congest drain-out-thresh <UINT:threshold> duplex ( full | half )

//port configuration
//set configuration
//special-congest
//port list
//all port
//sustain-timer
//second
port set special-congest port ( <PORT_LIST:ports> | all ) sustain-timer <UINT:second> duplex ( full | half )

//iol configuration
//dump configuration
iol dump

//iol configuration
//get configuration
//conllision max attempt action
iol get collision-max-attempt

//iol configuration
//get configuration
//error length action
iol get error-length

//iol configuration
//get configuration
//invalid pause action
iol get invalid-pause

//iol configuration
//get configuration
//late collision action
iol get late-collision

//iol configuration
//get configuration
//max length action
iol get max-length

//iol configuration
//get configuration
//conllision max attempt action
//retry
//drop
iol set collision-max-attempt ( retry | drop )

//iol configuration
//set configuration
//error length action
//forward
//drop
iol set error-length ( forward | drop )

//iol configuration
//set configuration
//invalid pause action
//forward
//drop
iol set invalid-pause ( forward | drop )

//iol configuration
//set configuration
//late collision action
//re-transmit
//drop
iol set late-collision ( re-transmit | drop )

//iol configuration
//set configuration
//max length action
//disable function
//enable function
iol set max-length ( disable | enable )

//model test configuration
//set configuration
//debug message
//debug message module mask
//debug message module mask value
model set debug mask <UINT:maskVal>

//model test configuration
//set configuration
//debug message
//debug message module mask
model get debug mask

//model test configuration
//only test real IC
//only test model code
//test both real IC and model code
//model test start item
//model test end item
model ( ic-only | model-only | both ) <UINT:start> <UINT:end>

//packet generation configuration
//get configuration
//tx command mode
pktgen get tx-cmd

//packet generation configuration
//set configuration
//tx command mode
//start TX commad
//start stop commad and reset counter
//start stop commad and hold counter
pktgen set tx-cmd ( start | stop-and-reset-counter | stop-and-hold-counter )

//packet generation configuration
//get configuration
//system packet generation state
pktgen get state

//packet generation configuration
//set configuration
