#ifdef CMD_TRAP_DUMP_CFM
//trap configuration
//dump configuration
//CFM configuration
trap dump cfm
#endif

#ifdef CMD_TRAP_DUMP_OAMPDU_OPTION_TYPE_PORT_ALL
//trap configuration
//dump configuration
//oampdu configuration
//packet with optional header or cfi bit == 1 configuration
//port list
//all ports
trap dump ( oampdu | option-type ) ( <PORT_LIST:port> | all )
#endif

#ifdef CMD_TRAP_DUMP_PACKET_REASON
//trap configuration
//dump configuration
//packet trap to CPU
//reason of packet trap to CPU
trap dump ( packet | reason )
#endif

#ifdef CMD_TRAP_DUMP_RMA_L2_USER_DEFINE
//trap configuration
//dump configuration
//RMA configuration
//user defined l2 RMA configuration
trap dump rma l2-user-define
#endif

#ifdef CMD_TRAP_DUMP_RMA_LAYER2
