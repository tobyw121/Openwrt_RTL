//dump configuration
//RMA configuration
//layer2 RMA configuration
trap dump rma layer2
#endif

#ifdef CMD_TRAP_DUMP_RMA_L2_USER_DEFINE_L34_PROTOCOL_L34_USER_PROTOCOL_LAYER2_MGMT_IP_CHECK
//trap configuration
//dump configuration
//RMA configuration
//user defined l2 RMA configuration
//l34 RMA protocol configuration
//layer34 user defined management rma configuration
//layer2 RMA configuration
//management ip check configuration
trap dump rma ( l2-user-define | l34-protocol | l34-user-protocol | layer2 | mgmt-ip-check )
#endif

