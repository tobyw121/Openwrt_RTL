#ifdef CMD_VLAN_SET_EGRESS_PORT_PORTS_ALL_INNER_OUTER_TPID_MODE_IGR_UNTAG_EGR_TAG_ALL_PACKETS
//VLAN configuration
//set configuration
//egress port configuration
//port list
//port list (e.g. 3 or 6-8)
//all ports
//inner tag
//outer tag
//TPID mode
//modify TPID for packet that received untag and transmitted as tag
//all packets
vlan set egress port ( <PORT_LIST:ports> | all ) ( inner | outer ) tpid-mode ( igr-untag-egr-tag | all-packets )
#endif

