//entry index
//source MAC address configuration
//source MAC address
//vid configuration
//vid
//priority configuration
//priority
vlan set mac-based-vlan entry <UINT:index> mac-address <MACADDR:mac> vid <UINT:vid> priority <UINT:priority>
#endif

