//port list (e.g. 3 or 6-8)
//all ports
//inner tag
//outer tag
//ignore tag of packet
//state configuration
//enable function
//disable function
vlan set ingress port ( <PORT_LIST:ports> | all ) ( inner | outer ) ignore state ( disable | enable )
#endif

