//get configuration
//packet to cpu configuration
//forward to CPU
//trap to CPU
//format configuration
switch get pkt2cpu ( forward | trap ) format
#endif

#ifdef CMD_SWITCH_SET_PKT2CPU_FORWARD_TRAP_FORMAT_MODIFIED_ORIGINAL
//switch configuration
//set configuration
//packet to cpu configuration
//forward to CPU
//trap to CPU
//format configuration
//with modified format
