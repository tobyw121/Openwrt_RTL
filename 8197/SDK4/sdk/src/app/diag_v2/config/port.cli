#ifdef CMD_PORT_DUMP_CPU_PORT
//port configuration
//dump configuration
//CPU port id
port dump cpu-port
#endif

#ifdef CMD_PORT_DUMP_ISOLATION
//port configuration
//dump configuration
//traffic isolation configuration
port dump isolation
#endif

#ifdef CMD_PORT_DUMP_PORT_PORTS_ALL
//port configuration
//dump configuration
//port configuration
//port list
//all ports
port dump port ( <PORT_LIST:ports> | all )
#endif

#ifdef CMD_PORT_DUMP_RLDP_PORT_PORTS_ALL
