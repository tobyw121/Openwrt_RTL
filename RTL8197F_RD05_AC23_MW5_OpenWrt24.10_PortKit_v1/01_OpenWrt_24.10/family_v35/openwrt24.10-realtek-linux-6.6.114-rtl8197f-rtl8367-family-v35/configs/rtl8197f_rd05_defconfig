# RTL8197F / Xiaomi RD05 first-boot defconfig
CONFIG_TARGET_realtek=y
CONFIG_TARGET_realtek_rtl8197f=y
CONFIG_TARGET_realtek_rtl8197f_DEVICE_xiaomi_r4_rd05=y
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
CONFIG_DEVEL=n
CONFIG_AUTOREMOVE=y
# CONFIG_CPU_BIG_ENDIAN is not set
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_SYS_SUPPORTS_LITTLE_ENDIAN=y

# First-boot RD05: no WLAN stack for now
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
# CONFIG_PACKAGE_wpad-basic-wolfssl is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wireless-regdb is not set
# CONFIG_PACKAGE_iw is not set
# First-boot RD05: use read-only automapped boot flash instead of SHEIPA SPI-NOR probe
CONFIG_MTD_RTL8197F_SPIROM=y
# CONFIG_SPI_RTL8197F_SHEIPA is not set
# CONFIG_MTD_SPI_NOR is not set
CONFIG_GPIO_RTL8197F=y
# v31 complete first-boot: no debug spam, no read-only rootfs_data split, no ethdiag auto-probe
# CONFIG_MTD_SPLIT_SQUASHFS_ROOT is not set
# CONFIG_RTL8197F_ETH_DIAG is not set
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_PREINIT_DISABLE_FAILSAFE=y
CONFIG_TARGET_PREINIT_TIMEOUT=1
CONFIG_TARGET_PREINIT_SUPPRESS_FAILSAFE_NETMSG=y
# RD05 DSA/network diagnostics and full userspace link tools
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ethtool=y

CONFIG_PACKAGE_rtl8367d-compat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_tc=y

# Optional old RTL8367 B-map build coverage; modules are not installed in RD05.
CONFIG_PACKAGE_kmod-swconfig=m
CONFIG_PACKAGE_kmod-switch-rtl8366-smi=m
CONFIG_PACKAGE_kmod-switch-rtl8367=m
CONFIG_PACKAGE_kmod-switch-rtl8367b=m
