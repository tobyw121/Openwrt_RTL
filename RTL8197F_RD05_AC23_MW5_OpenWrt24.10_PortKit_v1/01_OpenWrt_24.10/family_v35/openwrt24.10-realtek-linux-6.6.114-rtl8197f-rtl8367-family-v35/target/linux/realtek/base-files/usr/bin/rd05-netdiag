#!/bin/sh
# rd05-netdiag - Xiaomi RD05 / RTL8197F P0-RGMII + RTL8367D CPU7/EXT1 diagnostics (v34)
# Usage:
#   rd05-netdiag          same as full
#   rd05-netdiag pre      snapshot before PC traffic
#   rd05-netdiag post     snapshot after PC traffic
#   rd05-netdiag full     complete non-destructive router capture, raw Magic exchange, PCAPs and automatic verdict
#   rd05-netdiag arptest [seconds]  focused before/after LAN ARP/RX test window (also executed by full)
#   rd05-netdiag lancheck focused one-shot LAN/ARP/RX state
#   rd05-netdiag ports    print all known RTL8367D port/MIB counters
#   rd05-netdiag watch    live kernel RX/DSA filter if dmesg -w is available
#   rd05-netdiag prepare  explicitly reseed the RTL8197F vendor ingress/DMA tables
#   rd05-netdiag autotune explicitly run the legacy experimental v29 switch/tag/TX matrix
#   rd05-netdiag help     show usage and PC-side commands

umask 077
MODE="${1:-full}"
OUTDIR="${RD05_OUTDIR:-/tmp}"
TS="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo now)"
RD05_SESSION="${RD05_SESSION:-rd05-${TS}-$$}"
RD05_SESSION="$(printf '%s' "$RD05_SESSION" | tr -cd 'A-Za-z0-9._-' 2>/dev/null)"
[ -n "$RD05_SESSION" ] || RD05_SESSION="rd05-${TS}-$$"
if [ "$MODE" = "full" ]; then
	RUNDIR="$OUTDIR/rd05-netdiag-full-${TS}-$$"
	if mkdir "$RUNDIR" 2>/dev/null; then
		OUT="$RUNDIR/router.log"
	else
		RUNDIR=""
		OUT="$OUTDIR/rd05-netdiag-full-${TS}-$$.txt"
	fi
else
	RUNDIR=""
	OUT="$OUTDIR/rd05-netdiag-${MODE}-${TS}.txt"
fi
# Full-mode LAN/RX window length. Keep all router-side commands inside rd05-netdiag full.
FULL_ARPTEST_SECONDS="${RD05_FULL_ARPTEST_SECONDS:-120}"
# The PC peer normally uses 192.168.1.3/24 and is connected to DSA slave lan2.
RD05_PC_IP="${RD05_PC_IP:-192.168.1.3}"
FULL_PROBE_TARGET="${RD05_FULL_PROBE_TARGET:-$RD05_PC_IP}"
FULL_PROBE_IF="${RD05_FULL_PROBE_IF:-br-lan}"
RD05_MAGIC_IF="${RD05_MAGIC_IF:-lan2}"
RD05_MAGIC_INTERVAL_MS="${RD05_MAGIC_INTERVAL_MS:-200}"
RD05_PC_MAC="${RD05_PC_MAC:--}"
RD05_RAW_CAPTURE="${RD05_RAW_CAPTURE:-1}"
RD05_RAW_SNAPLEN="${RD05_RAW_SNAPLEN:-256}"
RD05_RAW_MAX_PACKETS="${RD05_RAW_MAX_PACKETS:-8192}"
# v25 EXT1/CPU-control matrix: keep DSA tagger/TXDESC/portmap safe and vary RTL8367D CPU control/RGMII modes.
TXMATRIX_SECONDS="${RD05_TXMATRIX_SECONDS:-12}"
TXMATRIX_MODES="${RD05_TXMATRIX_MODES:-0}"
PORTMAP_SECONDS="${RD05_PORTMAP_SECONDS:-12}"
PORTMAP_PORTS="${RD05_PORTMAP_PORTS:-0 1 2 3 4}"
PORTMAP_SWITCH_MODES="${RD05_PORTMAP_SWITCH_MODES:-0 focus}"
EXTCPU_SECONDS="${RD05_EXTCPU_SECONDS:-12}"
EXTCPU_MODES="${RD05_EXTCPU_MODES:-0 1 2 3 4 5 10 11 12 13 14 15 16 17}"

hr() { echo; echo "===== $* ====="; }
run() {
	echo; echo "+ $*"
	"$@" 2>&1 || echo "[exit $?] $*"
}
exists() { command -v "$1" >/dev/null 2>&1; }
cat_if() { [ -e "$1" ] && { echo "--- $1 ---"; cat "$1" 2>&1; }; }

val_ethtool() {
	dev="$1"
	key="$2"
	ethtool -S "$dev" 2>/dev/null | awk -v k="$key" '$1 == k":" { gsub(/:/, "", $1); print $2; exit }'
}

val_procnet() {
	dev="$1"
	awk -v d="$dev" '
		$1 ~ ("^" d ":") {
			gsub(":", "", $1);
			print $2, $3, $10, $11;
			exit;
		}' /proc/net/dev 2>/dev/null
}

safe_num() {
	case "$1" in
		''|*[!0-9]*) echo 0 ;;
		*) echo "$1" ;;
	esac
}

print_counter_delta() {
	name="$1"; before="$2"; after="$3"
	before="$(safe_num "$before")"
	after="$(safe_num "$after")"
	printf '  %-34s before=%-10s after=%-10s delta=%s\n' "$name" "$before" "$after" "$((after - before))"
}

rd05_router_probe_tick() {
	# Trigger ingress from the peer without requiring a timed PC-side command.
	# A same-subnet ping causes ARP requests/retries from br-lan; if the PC is
	# configured at FULL_PROBE_TARGET it should answer back into lan2.
	[ -n "$FULL_PROBE_TARGET" ] || return 0
	if [ -e "/sys/class/net/$FULL_PROBE_IF" ]; then
		ping -I "$FULL_PROBE_IF" -c 1 -W 1 "$FULL_PROBE_TARGET" >/dev/null 2>&1 &
	else
		ping -c 1 -W 1 "$FULL_PROBE_TARGET" >/dev/null 2>&1 &
	fi
	# Some BusyBox builds have arping; use it opportunistically. If absent or
	# unsupported, the ping-triggered ARP path above is still enough.
	if command -v arping >/dev/null 2>&1; then
		arping -I "$FULL_PROBE_IF" -c 1 -w 1 "$FULL_PROBE_TARGET" >/dev/null 2>&1 &
	fi
}

rd05_ensure_network() {
	hr "ensure LAN is started before diagnostics"
	if command -v ifup >/dev/null 2>&1; then
		ifup lan >/dev/null 2>&1 || true
	fi
	if command -v ubus >/dev/null 2>&1; then
		ubus call network.interface.lan up >/dev/null 2>&1 || true
	fi

	waited=0
	while [ "$waited" -lt 30 ]; do
		if dmesg 2>/dev/null | grep -q 'rd05 poststart v34:.*cpuicr1=.*rxbase=.*txbase='; then
			break
		fi
		sleep 1
		waited=$((waited + 1))
	done
	echo "LAN wait=${waited}s eth0=$(cat /sys/class/net/eth0/operstate 2>/dev/null || echo missing) lan2=$(cat /sys/class/net/lan2/operstate 2>/dev/null || echo missing)"
	dmesg 2>/dev/null | grep 'rd05 poststart v34:' | tail -1 || true
}

rd05_selected_eth0() {
	[ -e /sys/class/net/eth0 ] || { echo "eth0 missing"; return; }
	ethtool -S eth0 2>/dev/null | grep -E 'rd05_magic|rd05_rx_external|rd05_rx_self_loop|rd05_rx_arp|rd05_rx_ipv4|rd05_rx_ipv6|rd05_rx_bcast|rd05_rx_mcast|rd05_rx_untagged|rd05_rx_direct|rd05_rxtrace|rd05_rxdesc|rd05_trap_ok|rd05_ffcr|rd05_daclrcr|rd05_ptrap|rd05_l2cpu_ok|rd05_pipe_ok|rd05_acl_ok|rx_crc_strips|reg_cpui|reg_dma|reg_cpur|rd05_sdk_newdesc_rx|rd05_legacy_rx' || true
}

rd05_selected_lan2() {
	[ -e /sys/class/net/lan2 ] || { echo "lan2 missing"; return; }
	ethtool -S lan2 2>/dev/null | grep -E 'tx_packets|rx_packets|ifInOctets|ifOutOctets|ifInUcastPkts|ifInMulticastPkts|ifInBroadcastPkts|ifOutUcastPkts|ifOutMulticastPkts|ifOutBroadcastPkts|dot1dTpPortInDiscards|ifOutDiscards|etherStatsDropEvents' || true
}

rd05_known_ports() {
	cat <<'EOT'
0 lan1 UTP0-LAN1
1 lan2 UTP1-LAN2
2 wan UTP2-WAN
3 lan3 UTP3-LAN3
4 lan4 UTP4-LAN4
5 - P5-unknown/reserved
6 - EXT0/CPU-candidate
7 - EXT1/CPU-candidate
EOT
}

val_cpuport() {
	phys="$1"
	key="$2"
	pref="p0${phys}_${key}"
	v="$(val_ethtool eth0 "$pref")"
	[ -n "$v" ] && { echo "$v"; return; }
	pref="p${phys}_${key}"
	val_ethtool eth0 "$pref"
}

rd05_switch_port_matrix() {
	hr "RTL8367D all known ports matrix"
	printf '%-4s %-8s %-22s %-8s %-14s %-12s %-12s %-12s %-12s %-12s %-12s\n' \
		"phy" "dev" "role" "carrier" "state" "ifInOct" "inBcast" "inMcast" "disc" "ifOutOct" "outBcast"
	rd05_known_ports | while read phys dev role; do
		[ -n "$phys" ] || continue
		if [ "$dev" != "-" ] && [ -e "/sys/class/net/$dev" ]; then
			carrier="$(cat /sys/class/net/$dev/carrier 2>/dev/null || echo '-')"
			state="$(cat /sys/class/net/$dev/operstate 2>/dev/null || echo '-')"
			in_oct="$(safe_num "$(val_ethtool "$dev" ifInOctets)")"
			in_bc="$(safe_num "$(val_ethtool "$dev" ifInBroadcastPkts)")"
			in_mc="$(safe_num "$(val_ethtool "$dev" ifInMulticastPkts)")"
			disc="$(safe_num "$(val_ethtool "$dev" dot1dTpPortInDiscards)")"
			out_oct="$(safe_num "$(val_ethtool "$dev" ifOutOctets)")"
			out_bc="$(safe_num "$(val_ethtool "$dev" ifOutBroadcastPkts)")"
		else
			carrier="-"
			state="hidden"
			in_oct="$(safe_num "$(val_cpuport "$phys" ifInOctets)")"
			in_bc="$(safe_num "$(val_cpuport "$phys" ifInBroadcastPkts)")"
			in_mc="$(safe_num "$(val_cpuport "$phys" ifInMulticastPkts)")"
			disc="$(safe_num "$(val_cpuport "$phys" dot1dTpPortInDiscards)")"
			out_oct="$(safe_num "$(val_cpuport "$phys" ifOutOctets)")"
			out_bc="$(safe_num "$(val_cpuport "$phys" ifOutBroadcastPkts)")"
		fi
		printf '%-4s %-8s %-22s %-8s %-14s %-12s %-12s %-12s %-12s %-12s %-12s\n' \
			"$phys" "$dev" "$role" "$carrier" "$state" "$in_oct" "$in_bc" "$in_mc" "$disc" "$out_oct" "$out_bc"
	done

	echo
	echo "--- eth0-exposed hidden/CPU-port MIB counters p00..p07, if present ---"
	if [ -e /sys/class/net/eth0 ]; then
		ethtool -S eth0 2>/dev/null | grep -E 'p0?[0-7]_(ifInOctets|ifOutOctets|ifInUcastPkts|ifInMulticastPkts|ifInBroadcastPkts|ifOutUcastPkts|ifOutMulticastPkts|ifOutBroadcastPkts|dot1dTpPortInDiscards|etherStatsDropEvents)' || echo "no p00..p07 counters exposed on eth0"
	else
		echo "eth0 missing"
	fi
}

rd05_known_port_full_stats() {
	hr "RTL8367D full known-port stats"
	rd05_known_ports | while read phys dev role; do
		[ -n "$phys" ] || continue
		echo
		echo "--- physical port $phys / $role / dev=$dev ---"
		if [ "$dev" != "-" ] && [ -e "/sys/class/net/$dev" ]; then
			ethtool -S "$dev" 2>/dev/null | grep -E 'tx_packets|tx_bytes|rx_packets|rx_bytes|ifInOctets|ifOutOctets|ifInUcastPkts|ifInMulticastPkts|ifInBroadcastPkts|ifOutUcastPkts|ifOutMulticastPkts|ifOutBroadcastPkts|dot1dTpPortInDiscards|ifOutDiscards|etherStatsDropEvents|dot3StatsFCSErrors|dot3StatsSymbolErrors' || true
		else
			if [ -e /sys/class/net/eth0 ]; then
				ethtool -S eth0 2>/dev/null | grep -E "p0?${phys}_(ifInOctets|ifOutOctets|ifInUcastPkts|ifInMulticastPkts|ifInBroadcastPkts|ifOutUcastPkts|ifOutMulticastPkts|ifOutBroadcastPkts|dot1dTpPortInDiscards|etherStatsDropEvents|dot3StatsFCSErrors|dot3StatsSymbolErrors)" || echo "hidden port $phys has no eth0-exposed p${phys} counters"
			else
				echo "eth0 missing"
			fi
		fi
	done
}

rd05_selected_brlan() {
	[ -e /sys/class/net/br-lan ] || { echo "br-lan missing"; return; }
	ip -s link show br-lan 2>/dev/null || true
	ip addr show br-lan 2>/dev/null || true
}

rd05_lan_state() {
	label="$1"
	hr "focused LAN/ARP/RX state${label:+ - $label}"
	echo "--- link state ---"
	for dev in eth0 br-lan lan2; do
		[ -e "/sys/class/net/$dev" ] || continue
		printf '%-7s carrier=%s operstate=%s flags=' "$dev" \
			"$(cat /sys/class/net/$dev/carrier 2>/dev/null || echo '-')" \
			"$(cat /sys/class/net/$dev/operstate 2>/dev/null || echo '-')"
		ip -o link show "$dev" 2>/dev/null | sed 's/^[0-9]*: [^:]*: //' || true
	done
	echo
	echo "--- eth0 RD05 counters ---"
	rd05_selected_eth0
	echo
	echo "--- lan2 switch/DSA counters ---"
	rd05_selected_lan2
	echo
	rd05_switch_port_matrix
	echo
	echo "--- br-lan counters/address ---"
	rd05_selected_brlan
	echo
	echo "--- filtered RX/ARP dmesg tail ---"
	dmesg 2>/dev/null | grep -Ei 'v5am|rxext|rd05 rxtrace|rd05 rx observe|bridge-local|slave-local|proto 0x0806|proto 0x0800|proto 0x86dd|untagged rx|l2cpu v5|pipe v5|acl v5|cpu path|registered eth0|RTL8367D' | tail -160 || true
}

rd05_lan_decision() {
	hr "focused LAN/ARP decision"
	external="$(safe_num "$(val_ethtool eth0 rd05_rx_external)")"
	self_loop="$(safe_num "$(val_ethtool eth0 rd05_rx_self_loop)")"
	arp="$(safe_num "$(val_ethtool eth0 rd05_rx_arp)")"
	ip4="$(safe_num "$(val_ethtool eth0 rd05_rx_ipv4)")"
	ip6="$(safe_num "$(val_ethtool eth0 rd05_rx_ipv6)")"
	bc="$(safe_num "$(val_ethtool eth0 rd05_rx_bcast)")"
	mcast="$(safe_num "$(val_ethtool eth0 rd05_rx_mcast)")"
	trace="$(safe_num "$(val_ethtool eth0 rd05_rxtrace_frames)")"
	rtk8="$(safe_num "$(val_ethtool eth0 rd05_rxtrace_rtk0)")"
	l2ok="$(safe_num "$(val_ethtool eth0 rd05_l2cpu_ok)")"
	pipeok="$(safe_num "$(val_ethtool eth0 rd05_pipe_ok)")"
	aclok="$(safe_num "$(val_ethtool eth0 rd05_acl_ok)")"
	trapok="$(safe_num "$(val_ethtool eth0 rd05_trap_ok)")"
	lan2b="$(safe_num "$(val_ethtool lan2 ifInBroadcastPkts)")"
	lan2disc="$(safe_num "$(val_ethtool lan2 dot1dTpPortInDiscards)")"
	p06in="$(safe_num "$(val_cpuport 6 ifInOctets)")"
	p06out="$(safe_num "$(val_cpuport 6 ifOutOctets)")"
	p07in="$(safe_num "$(val_cpuport 7 ifInOctets)")"
	p07out="$(safe_num "$(val_cpuport 7 ifOutOctets)")"
	p07fcs="$(safe_num "$(val_cpuport 7 dot3StatsFCSErrors)")"
	p07drop="$(safe_num "$(val_cpuport 7 etherStatsDropEvents)")"

	echo "eth0: rd05_rx_external=$external rd05_rx_self_loop=$self_loop rd05_rx_arp=$arp rd05_rx_ipv4=$ip4 rd05_rx_ipv6=$ip6 rd05_rx_bcast=$bc rd05_rx_mcast=$mcast rd05_rxtrace_frames=$trace rd05_rxtrace_rtk0=$rtk8"
	echo "seeds: rd05_l2cpu_ok=$l2ok rd05_pipe_ok=$pipeok rd05_acl_ok=$aclok rd05_trap_ok=$trapok"
	echo "lan2: ifInBroadcastPkts=$lan2b dot1dTpPortInDiscards=$lan2disc"
	echo "cpu candidates: p06_ifInOctets=$p06in p06_ifOutOctets=$p06out p07_ifInOctets=$p07in p07_ifOutOctets=$p07out p07_fcs=$p07fcs p07_drop=$p07drop"
	echo
	if [ "$p07fcs" -gt 0 ] && [ "$p07out" -eq 0 ]; then
		echo "RESULT: RTL8367D CPU7 receives SoC-originated frames with FCS errors. This is a switch-side EXT1 RX sampling problem, not proof about switch-to-SoC RX."
		echo "NEXT: v34 uses adjacent EXT1 RX delay tap 6; verify that p07_dot3StatsFCSErrors no longer increases."
	elif [ "$external" -gt 0 ] && [ "$arp" -gt 0 ]; then
		echo "RESULT: externally sourced ARP reaches RTL8197F CPU RX. If the PC still has no answer, investigate DSA slave delivery and the reply/TX path."
	elif [ "$external" -gt 0 ]; then
		echo "RESULT: a non-router source MAC reaches the RTL8197F CPU ring. The P0/RGMII receive path is active; continue with CPU-tag source-port decode, DSA slave delivery and bridge policy."
	elif [ "$self_loop" -gt 0 ] || [ "$trace" -gt 0 ]; then
		echo "RESULT: CPU RX only shows local/self-reflected or otherwise unproven frames. This is not evidence that PC ingress works."
		echo "NEXT: rd05_rx_external must increase for a real PC/LAN frame; inspect the v34 post-start CPUICR1/ring and EXT1/SSC readbacks if it remains zero."
	elif [ "$lan2b" -gt 0 ] && [ "$p07out" -gt 0 ]; then
		echo "RESULT: RTL8367D forwards LAN ingress out CPU7/EXT1, but RTL8197F CPU RX still sees no external frame."
		echo "NEXT: verify the v34 post-start CPUICR1/ring readback, RGMII timing and RX descriptor ownership."
	elif [ "$lan2b" -gt 0 ] && [ "$lan2disc" -eq 0 ]; then
		echo "RESULT: lan2 sees broadcast and switch is not discarding, but CPU RX sees no ARP."
		echo "NEXT: verify the RTL8367D CPU-port VLAN membership and P0/RGMII path."
	elif [ "$lan2disc" -gt 0 ]; then
		echo "RESULT: lan2 has cumulative bridge discards and there is no CPU7 egress proof in this snapshot. Check VLAN/PVID/member/ingress filtering."
	else
		echo "RESULT: no ARP seen at CPU and no clear lan2 broadcast evidence in this snapshot. Run rd05-netdiag arptest while PC arping runs."
	fi
}

rd05_arptest() {
	# Accept both "rd05_arptest 120" and "rd05_arptest arptest 120" call styles.
	case "$1" in
		''|*[!0-9]*) seconds="${2:-$FULL_ARPTEST_SECONDS}" ;;
		*) seconds="$1" ;;
	esac
	case "$seconds" in ''|*[!0-9]*) seconds="$FULL_ARPTEST_SECONDS" ;; esac
	[ "$seconds" -lt 30 ] 2>/dev/null && seconds=30
	[ "$seconds" -gt 300 ] 2>/dev/null && seconds=300

	hr "RD05 automated LAN ARP/RX test - fullauto trafficguard"
	cat <<EOT
This runs every router-side command automatically.

IMPORTANT: the router cannot create inbound LAN2 frames by itself.
During the live countdown below, generate traffic on the PC only.

Start the supplied Linux PC companion before or together with this command:

  sudo ./rd05-pc-netdiag.py --interface <pc-lan-interface> --configure-ip --duration $seconds

The PC tool captures all Ethernet traffic, sends/receives raw EtherType 0x8899
RD05MAGIC-V31 frames, generates ARP/ICMP/UDP probes and writes PCAP/JSON.
No additional router command is required.
EOT

	# before counters
	b_external="$(val_ethtool eth0 rd05_rx_external)"
	b_magic="$(val_ethtool eth0 rd05_magic_hits)"
	b_magic_cand="$(val_ethtool eth0 rd05_magic_last_candidate)"
	b_self_loop="$(val_ethtool eth0 rd05_rx_self_loop)"
	b_arp="$(val_ethtool eth0 rd05_rx_arp)"
	b_ip4="$(val_ethtool eth0 rd05_rx_ipv4)"
	b_ip6="$(val_ethtool eth0 rd05_rx_ipv6)"
	b_bcast="$(val_ethtool eth0 rd05_rx_bcast)"
	b_mcast="$(val_ethtool eth0 rd05_rx_mcast)"
	b_untag="$(val_ethtool eth0 rd05_rx_untagged)"
	b_direct="$(val_ethtool eth0 rd05_rx_direct_lan2)"
	b_trace_frames="$(val_ethtool eth0 rd05_rxtrace_frames)"
	b_trace_logs="$(val_ethtool eth0 rd05_rxtrace_logs)"
	b_trace_arp0="$(val_ethtool eth0 rd05_rxtrace_arp0)"
	b_trace_arp4="$(val_ethtool eth0 rd05_rxtrace_arp4)"
	b_trace_arp8="$(val_ethtool eth0 rd05_rxtrace_arp8)"
	b_trace_bcast0="$(val_ethtool eth0 rd05_rxtrace_bcast0)"
	b_trace_bcast4="$(val_ethtool eth0 rd05_rxtrace_bcast4)"
	b_trace_bcast8="$(val_ethtool eth0 rd05_rxtrace_bcast8)"
	b_legacy_pkts="$(val_ethtool eth0 rd05_legacy_rx_pkts)"
	b_legacy_empty="$(val_ethtool eth0 rd05_legacy_rx_empty)"
	b_legacy_bad="$(val_ethtool eth0 rd05_legacy_rx_bad)"
	b_legacy_ent="$(val_ethtool eth0 rd05_legacy_rx_last_ent)"
	b_lan2_b="$(val_ethtool lan2 ifInBroadcastPkts)"
	b_lan2_m="$(val_ethtool lan2 ifInMulticastPkts)"
	b_lan2_oct="$(val_ethtool lan2 ifInOctets)"
	b_lan2_disc="$(val_ethtool lan2 dot1dTpPortInDiscards)"
	b_p06_in="$(val_cpuport 6 ifInOctets)"
	b_p06_out="$(val_cpuport 6 ifOutOctets)"
	b_p07_in="$(val_cpuport 7 ifInOctets)"
	b_p07_out="$(val_cpuport 7 ifOutOctets)"
	b_br="$(val_procnet br-lan)"
	b_eth="$(val_procnet eth0)"

	rd05_lan_state "before"
	[ -n "$RUNDIR" ] && rd05_raw_start "$seconds"
	echo "RD05_WINDOW_READY version=1 session=$RD05_SESSION duration_s=$seconds interface=$RD05_MAGIC_IF pc_ip=$RD05_PC_IP pc_mac=$RD05_PC_MAC"
	echo
	hr "LAN/RX TRAFFIC WINDOW - ROUTER SELF-PROBE AND RAW MAGIC ACTIVE"
	echo "Window length: ${seconds}s. Router-side collection is automatic."
	echo "v23 self-probe: router sends periodic probes to ${FULL_PROBE_TARGET} via ${FULL_PROBE_IF}."
	echo "The PC only needs to be connected to lan2 and configured with that IP; no timed PC command is required."
	echo
	i=0
	seen_lan2=0
	seen_cpuport=0
	seen_ethrx=0
	while [ "$i" -lt "$seconds" ]; do
		rd05_router_probe_tick
		step=5
		remaining=$((seconds - i))
		[ "$remaining" -lt "$step" ] && step="$remaining"
		sleep "$step"
		i=$((i + step))
		c_external="$(val_ethtool eth0 rd05_rx_external)"
		c_magic="$(val_ethtool eth0 rd05_magic_hits)"
		c_self_loop="$(val_ethtool eth0 rd05_rx_self_loop)"
		c_arp="$(val_ethtool eth0 rd05_rx_arp)"
		c_bcast="$(val_ethtool eth0 rd05_rx_bcast)"
		c_trace="$(val_ethtool eth0 rd05_rxtrace_frames)"
		c_legacy_pkts="$(val_ethtool eth0 rd05_legacy_rx_pkts)"
		c_legacy_bad="$(val_ethtool eth0 rd05_legacy_rx_bad)"
		c_legacy_empty="$(val_ethtool eth0 rd05_legacy_rx_empty)"
		c_lan2_b="$(val_ethtool lan2 ifInBroadcastPkts)"
		c_lan2_oct="$(val_ethtool lan2 ifInOctets)"
		c_p07_out="$(val_cpuport 7 ifOutOctets)"
		d_external=$(( $(safe_num "$c_external") - $(safe_num "$b_external") ))
		d_magic_live=$(( $(safe_num "$c_magic") - $(safe_num "$b_magic") ))
		d_self_loop=$(( $(safe_num "$c_self_loop") - $(safe_num "$b_self_loop") ))
		d_arp=$(( $(safe_num "$c_arp") - $(safe_num "$b_arp") ))
		d_bcast=$(( $(safe_num "$c_bcast") - $(safe_num "$b_bcast") ))
		d_trace=$(( $(safe_num "$c_trace") - $(safe_num "$b_trace_frames") ))
		d_legacy_pkts=$(( $(safe_num "$c_legacy_pkts") - $(safe_num "$b_legacy_pkts") ))
		d_legacy_bad=$(( $(safe_num "$c_legacy_bad") - $(safe_num "$b_legacy_bad") ))
		d_legacy_empty=$(( $(safe_num "$c_legacy_empty") - $(safe_num "$b_legacy_empty") ))
		d_lan2_b=$(( $(safe_num "$c_lan2_b") - $(safe_num "$b_lan2_b") ))
		d_lan2_oct=$(( $(safe_num "$c_lan2_oct") - $(safe_num "$b_lan2_oct") ))
		d_p07_out=$(( $(safe_num "$c_p07_out") - $(safe_num "$b_p07_out") ))
		[ "$d_lan2_oct" -gt 0 ] || [ "$d_lan2_b" -gt 0 ] && seen_lan2=1
		[ "$d_p07_out" -gt 0 ] && seen_cpuport=1
		[ "$d_external" -gt 0 ] && seen_ethrx=1
		printf 'LIVE_WINDOW t=%03ss/%03ss lan2_oct_delta=%s lan2_bcast_delta=%s p07_out_delta=%s external_delta=%s magic_delta=%s self_loop_delta=%s legacy_pkts_delta=%s legacy_bad_delta=%s legacy_empty_delta=%s eth0_arp_delta=%s eth0_bcast_delta=%s rxtrace_delta=%s\n' \
			"$i" "$seconds" "$d_lan2_oct" "$d_lan2_b" "$d_p07_out" "$d_external" "$d_magic_live" "$d_self_loop" "$d_legacy_pkts" "$d_legacy_bad" "$d_legacy_empty" "$d_arp" "$d_bcast" "$d_trace"
		if [ "$i" -eq 30 ] && [ "$seen_lan2" -eq 0 ]; then
			echo "LIVE_WINDOW_HINT: still no new LAN2 input. The router is already sending ARP/ping and raw RD05MAGIC-V31 probes; verify cable, LAN2 link and PC script."
		fi
	done
	[ -n "$RUNDIR" ] && rd05_raw_wait
	echo "RD05_WINDOW_DONE version=1 session=$RD05_SESSION duration_s=$seconds interface=$RD05_MAGIC_IF"

	# after counters
	a_external="$(val_ethtool eth0 rd05_rx_external)"
	a_magic="$(val_ethtool eth0 rd05_magic_hits)"
	a_magic_cand="$(val_ethtool eth0 rd05_magic_last_candidate)"
	a_magic_len="$(val_ethtool eth0 rd05_magic_last_len)"
	a_magic_p0="$(val_ethtool eth0 rd05_magic_last_proto0)"
	a_magic_p4="$(val_ethtool eth0 rd05_magic_last_proto4)"
	a_magic_p8="$(val_ethtool eth0 rd05_magic_last_proto8)"
	a_self_loop="$(val_ethtool eth0 rd05_rx_self_loop)"
	a_arp="$(val_ethtool eth0 rd05_rx_arp)"
	a_ip4="$(val_ethtool eth0 rd05_rx_ipv4)"
	a_ip6="$(val_ethtool eth0 rd05_rx_ipv6)"
	a_bcast="$(val_ethtool eth0 rd05_rx_bcast)"
	a_mcast="$(val_ethtool eth0 rd05_rx_mcast)"
	a_untag="$(val_ethtool eth0 rd05_rx_untagged)"
	a_direct="$(val_ethtool eth0 rd05_rx_direct_lan2)"
	a_trace_frames="$(val_ethtool eth0 rd05_rxtrace_frames)"
	a_trace_logs="$(val_ethtool eth0 rd05_rxtrace_logs)"
	a_trace_arp0="$(val_ethtool eth0 rd05_rxtrace_arp0)"
	a_trace_arp4="$(val_ethtool eth0 rd05_rxtrace_arp4)"
	a_trace_arp8="$(val_ethtool eth0 rd05_rxtrace_arp8)"
	a_trace_bcast0="$(val_ethtool eth0 rd05_rxtrace_bcast0)"
	a_trace_bcast4="$(val_ethtool eth0 rd05_rxtrace_bcast4)"
	a_trace_bcast8="$(val_ethtool eth0 rd05_rxtrace_bcast8)"
	a_legacy_pkts="$(val_ethtool eth0 rd05_legacy_rx_pkts)"
	a_legacy_empty="$(val_ethtool eth0 rd05_legacy_rx_empty)"
	a_legacy_bad="$(val_ethtool eth0 rd05_legacy_rx_bad)"
	a_legacy_ent="$(val_ethtool eth0 rd05_legacy_rx_last_ent)"
	a_lan2_b="$(val_ethtool lan2 ifInBroadcastPkts)"
	a_lan2_m="$(val_ethtool lan2 ifInMulticastPkts)"
	a_lan2_oct="$(val_ethtool lan2 ifInOctets)"
	a_lan2_disc="$(val_ethtool lan2 dot1dTpPortInDiscards)"
	a_p06_in="$(val_cpuport 6 ifInOctets)"
	a_p06_out="$(val_cpuport 6 ifOutOctets)"
	a_p07_in="$(val_cpuport 7 ifInOctets)"
	a_p07_out="$(val_cpuport 7 ifOutOctets)"
	a_br="$(val_procnet br-lan)"
	a_eth="$(val_procnet eth0)"

	rd05_lan_state "after"
	hr "focused before/after deltas"
	print_counter_delta "eth0 rd05_rx_external" "$b_external" "$a_external"
	print_counter_delta "eth0 rd05_magic_hits" "$b_magic" "$a_magic"
	echo "eth0 rd05_magic_last_candidate before=$b_magic_cand after=$a_magic_cand len=$a_magic_len proto0/4/8=$a_magic_p0/$a_magic_p4/$a_magic_p8"
	print_counter_delta "eth0 rd05_rx_self_loop" "$b_self_loop" "$a_self_loop"
	print_counter_delta "eth0 rd05_rx_arp" "$b_arp" "$a_arp"
	print_counter_delta "eth0 rd05_rx_ipv4" "$b_ip4" "$a_ip4"
	print_counter_delta "eth0 rd05_rx_ipv6" "$b_ip6" "$a_ip6"
	print_counter_delta "eth0 rd05_rx_bcast" "$b_bcast" "$a_bcast"
	print_counter_delta "eth0 rd05_rx_mcast" "$b_mcast" "$a_mcast"
	print_counter_delta "eth0 rd05_rx_untagged" "$b_untag" "$a_untag"
	print_counter_delta "eth0 rd05_rx_direct_lan2" "$b_direct" "$a_direct"
	print_counter_delta "eth0 rd05_rxtrace_frames" "$b_trace_frames" "$a_trace_frames"
	print_counter_delta "eth0 rd05_rxtrace_logs" "$b_trace_logs" "$a_trace_logs"
	print_counter_delta "eth0 rd05_rxtrace_arp0" "$b_trace_arp0" "$a_trace_arp0"
	print_counter_delta "eth0 rd05_rxtrace_arp4" "$b_trace_arp4" "$a_trace_arp4"
	print_counter_delta "eth0 rd05_rxtrace_arp8" "$b_trace_arp8" "$a_trace_arp8"
	print_counter_delta "eth0 rd05_rxtrace_bcast0" "$b_trace_bcast0" "$a_trace_bcast0"
	print_counter_delta "eth0 rd05_rxtrace_bcast4" "$b_trace_bcast4" "$a_trace_bcast4"
	print_counter_delta "eth0 rd05_rxtrace_bcast8" "$b_trace_bcast8" "$a_trace_bcast8"
	print_counter_delta "eth0 rd05_legacy_rx_pkts" "$b_legacy_pkts" "$a_legacy_pkts"
	print_counter_delta "eth0 rd05_legacy_rx_empty" "$b_legacy_empty" "$a_legacy_empty"
	print_counter_delta "eth0 rd05_legacy_rx_bad" "$b_legacy_bad" "$a_legacy_bad"
	echo "eth0 rd05_legacy_rx_last_ent before: $b_legacy_ent"
	echo "eth0 rd05_legacy_rx_last_ent after : $a_legacy_ent"
	print_counter_delta "lan2 ifInBroadcastPkts" "$b_lan2_b" "$a_lan2_b"
	print_counter_delta "lan2 ifInMulticastPkts" "$b_lan2_m" "$a_lan2_m"
	print_counter_delta "lan2 ifInOctets" "$b_lan2_oct" "$a_lan2_oct"
	print_counter_delta "lan2 dot1dTpPortInDiscards" "$b_lan2_disc" "$a_lan2_disc"
	print_counter_delta "cpu cand p06_ifInOctets" "$b_p06_in" "$a_p06_in"
	print_counter_delta "cpu cand p06_ifOutOctets" "$b_p06_out" "$a_p06_out"
	print_counter_delta "cpu cand p07_ifInOctets" "$b_p07_in" "$a_p07_in"
	print_counter_delta "cpu cand p07_ifOutOctets" "$b_p07_out" "$a_p07_out"

	d_lan2_oct=$(( $(safe_num "$a_lan2_oct") - $(safe_num "$b_lan2_oct") ))
	d_lan2_b=$(( $(safe_num "$a_lan2_b") - $(safe_num "$b_lan2_b") ))
	d_p07_out=$(( $(safe_num "$a_p07_out") - $(safe_num "$b_p07_out") ))
	d_legacy_pkts=$(( $(safe_num "$a_legacy_pkts") - $(safe_num "$b_legacy_pkts") ))
	d_legacy_empty=$(( $(safe_num "$a_legacy_empty") - $(safe_num "$b_legacy_empty") ))
	d_rx_external=$(( $(safe_num "$a_external") - $(safe_num "$b_external") ))
	d_magic=$(( $(safe_num "$a_magic") - $(safe_num "$b_magic") ))
	d_rx_self_loop=$(( $(safe_num "$a_self_loop") - $(safe_num "$b_self_loop") ))
	d_rx_arp=$(( $(safe_num "$a_arp") - $(safe_num "$b_arp") ))
	d_rx_bcast=$(( $(safe_num "$a_bcast") - $(safe_num "$b_bcast") ))
	d_rxtrace=$(( $(safe_num "$a_trace_frames") - $(safe_num "$b_trace_frames") ))
	hr "traffic-window verdict"
	if [ "$d_magic" -gt 0 ]; then
		result_window="RTL8197F_RAW_MAGIC_RX_CONFIRMED"
		echo "RESULT_WINDOW: $result_window"
		echo "Meaning: PC-origin RD05MAGIC-V31 bytes reached the RTL8197F raw DMA RX path before DSA/bridge processing."
	elif [ "$d_lan2_oct" -eq 0 ] && [ "$d_lan2_b" -eq 0 ] && [ "$d_p07_out" -eq 0 ]; then
		result_window="NO_NEW_LAN2_TRAFFIC_DETECTED_DURING_FULL_WINDOW"
		echo "RESULT_WINDOW: $result_window"
		echo "Meaning: router self-probes ran, but no peer traffic reached lan2 during the window."
	elif [ "$d_rx_external" -gt 0 ]; then
		result_window="RTL8197F_CPU_RX_SEES_EXTERNAL_INGRESS"
		echo "RESULT_WINDOW: $result_window"
		echo "Meaning: at least one non-router source MAC reached the CPU ring. P0/RGMII ingress is working; continue with rtl8_4 source-port decode, DSA slave delivery, bridge and reply TX."
	elif [ "$d_lan2_oct" -gt 0 ] && [ "$d_p07_out" -gt 0 ] && [ "$d_rx_external" -eq 0 ]; then
		result_window="LAN2_AND_RTL8367D_CPU_PORT_ACTIVE_BUT_NO_EXTERNAL_RTL8197F_RX"
		echo "RESULT_WINDOW: $result_window"
		echo "Meaning: the external switch forwards toward CPU7/EXT1, but no frame with a non-router source MAC reaches RTL8197F P0/DMA."
	elif [ "$d_rx_self_loop" -gt 0 ] || [ "$d_rxtrace" -gt 0 ] || [ "$d_legacy_pkts" -gt 0 ]; then
		result_window="RTL8197F_RX_ONLY_LOCAL_OR_UNPROVEN_FRAMES"
		echo "RESULT_WINDOW: $result_window"
		echo "Meaning: raw RX activity is present, but it does not prove PC ingress. The v30 self-reflection is counted separately and must not be treated as success."
	else
		result_window="PARTIAL_OR_AMBIGUOUS_TRAFFIC_DELTAS"
		echo "RESULT_WINDOW: $result_window lan2_oct=$d_lan2_oct lan2_bcast=$d_lan2_b p07_out=$d_p07_out external=$d_rx_external magic=$d_magic self_loop=$d_rx_self_loop legacy_pkts=$d_legacy_pkts legacy_empty=$d_legacy_empty rxtrace=$d_rxtrace"
	fi
	echo "RD05_WINDOW_MAGIC_DELTA=$d_magic"
	echo "RD05_WINDOW_EXTERNAL_DELTA=$d_rx_external"
	echo "RD05_WINDOW_ARP_DELTA=$d_rx_arp"
	echo
	echo "br-lan /proc/net/dev before: $b_br"
	echo "br-lan /proc/net/dev after : $a_br"
	echo "eth0   /proc/net/dev before: $b_eth"
	echo "eth0   /proc/net/dev after : $a_eth"
	if [ -n "$RUNDIR" ] && [ -d "$RUNDIR" ]; then
		cat > "$RUNDIR/window.env" <<EOT
RD05_SESSION=$RD05_SESSION
RD05_RESULT_WINDOW=$result_window
RD05_WINDOW_MAGIC_DELTA=$d_magic
RD05_WINDOW_EXTERNAL_DELTA=$d_rx_external
RD05_WINDOW_ARP_DELTA=$d_rx_arp
RD05_WINDOW_LAN2_OCTETS_DELTA=$d_lan2_oct
RD05_WINDOW_LAN2_BCAST_DELTA=$d_lan2_b
RD05_WINDOW_CPU7_OUT_DELTA=$d_p07_out
RD05_MAGIC_LAST_CANDIDATE=$a_magic_cand
RD05_MAGIC_LAST_LEN=$a_magic_len
RD05_MAGIC_LAST_PROTO0=$a_magic_p0
RD05_MAGIC_LAST_PROTO4=$a_magic_p4
RD05_MAGIC_LAST_PROTO8=$a_magic_p8
EOT
	fi
	rd05_lan_decision
}

grep_dmesg() {
	dmesg 2>/dev/null | grep -Ei 'rd05|v5am|rxext|RTL8367D|rtl8367|realtek-smi|rtknet|registered eth0|DSA|oem-vid9|RD05 DSA CPU path|rxtrace|rx observe|slave-local|bridge-local|untagged rx|non-realtek|proto 0x0806|proto 0x0800|proto 0x86dd|cpu path|l2cpu|rtl865x l2|rtl865x acl|rtl865x pipe|acl|ffcr|daclrcr|ptrap|flood|vlan|pvid|msti|isolation|mirror|WATCHDOG|p0 rgmii v31|vendor datapath v31|vendor datapath v9|private ioctl/proc v10|private ioctl/proc v25|sdk newdesc v25|cpuidma v25|rtl865x pipe v25|private ioctl/proc v23|sdk newdesc v23|cpuidma v23|rtl865x pipe v25|rtl865x pipe v23|private ioctl/proc v22|sdk newdesc v22|cpuidma v22|rtl865x pipe v22|private ioctl/proc v21|sdk newdesc v21|cpuidma v21|rtl865x pipe v21|private ioctl/proc v20|sdk newdesc v20|cpuidma v20|rtl865x pipe v20|private ioctl/proc v18|sdk newdesc v18|cpuidma v18|rtl865x pipe v18|private ioctl/proc v15|sdk newdesc v15|cpuidma v15|rtl865x pipe v15|private ioctl/proc v14|sdk newdesc v14|cpuidma v14|rtl865x pipe v14|private ioctl/proc v13|legacy rxmbuf v13|extmac force v13|private ioctl/proc v12|legacy rxmbuf v12|private ioctl/proc v11|legacy rxmbuf v11|private ioctl v9' || true
}


rd05_v5am_auto_bundle() {
	hr "v25 automatic SDK newdesc RX + RTL8367D EXT1/CPU-mode self-probe bundle"
	cat <<'EOT'
This state-changing preparation is executed only by "rd05-netdiag prepare"
or when RD05_RUN_PREPARE=1 is explicitly supplied to full. It triggers the
kernel RD05 proc/private-ioctl path and reports the RX ring state.
EOT

	echo
	if command -v rd05-ioctl >/dev/null 2>&1; then
		for cmd in reseed rxstart vendor-side; do
			echo "+ rd05-ioctl eth0 $cmd  # v23 procfs/private hook"
			rd05-ioctl eth0 "$cmd" 2>&1 || true
		done
		dmesg 2>/dev/null | grep -E 'rd05 vendor datapath v9|rd05 private ioctl/proc v10|private ioctl/proc v25|sdk newdesc v25|cpuidma v25|rtl865x pipe v25|private ioctl/proc v23|sdk newdesc v23|cpuidma v23|rtl865x pipe v25|rtl865x pipe v23|private ioctl/proc v22|sdk newdesc v22|cpuidma v22|rtl865x pipe v22|private ioctl/proc v21|sdk newdesc v21|cpuidma v21|rtl865x pipe v21|private ioctl/proc v20|sdk newdesc v20|cpuidma v20|rtl865x pipe v20|private ioctl/proc v18|sdk newdesc v18|cpuidma v18|rtl865x pipe v18|private ioctl/proc v15|sdk newdesc v15|cpuidma v15|rtl865x pipe v15|private ioctl/proc v14|sdk newdesc v14|cpuidma v14|rtl865x pipe v14|private ioctl/proc v13|legacy rxmbuf v13|extmac force v13|private ioctl/proc v12|legacy rxmbuf v12|private ioctl/proc v11|legacy rxmbuf v11|rd05 private ioctl v9' | tail -40 || true
	else
		echo "rd05-ioctl not installed or procfs wrapper missing"
	fi

	echo
	echo "+ dmesg | grep -E 'v5am|rxext|rxtrace|registered eth0|DSA CPU path|RTL8367D|vendor datapath v9|private ioctl/proc v10|private ioctl/proc v25|sdk newdesc v25|cpuidma v25|rtl865x pipe v25|private ioctl/proc v23|sdk newdesc v23|cpuidma v23|rtl865x pipe v25|rtl865x pipe v23|private ioctl/proc v22|sdk newdesc v22|cpuidma v22|rtl865x pipe v22|private ioctl/proc v21|sdk newdesc v21|cpuidma v21|rtl865x pipe v21|private ioctl/proc v20|sdk newdesc v20|cpuidma v20|rtl865x pipe v20|private ioctl/proc v18|sdk newdesc v18|cpuidma v18|rtl865x pipe v18|private ioctl/proc v15|sdk newdesc v15|cpuidma v15|rtl865x pipe v15|private ioctl/proc v14|sdk newdesc v14|cpuidma v14|rtl865x pipe v14|private ioctl/proc v13|legacy rxmbuf v13|extmac force v13|private ioctl/proc v12|legacy rxmbuf v12|private ioctl/proc v11|legacy rxmbuf v11|private ioctl v9' | tail -250"
	dmesg 2>/dev/null | grep -E 'v5am|rxext|rxtrace|registered eth0|DSA CPU path|RTL8367D|vendor datapath v9|private ioctl/proc v10|private ioctl/proc v25|sdk newdesc v25|cpuidma v25|rtl865x pipe v25|private ioctl/proc v23|sdk newdesc v23|cpuidma v23|rtl865x pipe v25|rtl865x pipe v23|private ioctl/proc v22|sdk newdesc v22|cpuidma v22|rtl865x pipe v22|private ioctl/proc v21|sdk newdesc v21|cpuidma v21|rtl865x pipe v21|private ioctl/proc v20|sdk newdesc v20|cpuidma v20|rtl865x pipe v20|private ioctl/proc v18|sdk newdesc v18|cpuidma v18|rtl865x pipe v18|private ioctl/proc v15|sdk newdesc v15|cpuidma v15|rtl865x pipe v15|private ioctl/proc v14|sdk newdesc v14|cpuidma v14|rtl865x pipe v14|private ioctl/proc v13|legacy rxmbuf v13|extmac force v13|private ioctl/proc v12|legacy rxmbuf v12|private ioctl/proc v11|legacy rxmbuf v11|private ioctl v9' | tail -250 || true

	echo
	echo "+ ethtool -S eth0 | grep -E 'rd05_rxdesc|rd05_rxtrace|rd05_sdk_newdesc_rx|rd05_legacy_rx|rd05_rx_arp|rd05_rx_bcast|rd05_rx_ipv|rd05_rx_untagged|rd05_l2cpu|rd05_pipe|rd05_acl|rd05_trap|rd05_ffcr|rd05_daclrcr|rd05_ptrapcr|reg_cpu|reg_dma|reg_cpui|last_cpu|last_dma|last_cpuqdm|last_sirr|last_macctrl|last_sys_clk|rx_desc0|tx_desc0|hw_rx_desc|reg_cpurmdcr0|rd05_sdk_newdesc_rx|rd05_legacy_rx'"
	if [ -e /sys/class/net/eth0 ]; then
		ethtool -S eth0 2>/dev/null | grep -E 'rd05_rxdesc|rd05_rxtrace|rd05_sdk_newdesc_rx|rd05_legacy_rx|rd05_rx_arp|rd05_rx_bcast|rd05_rx_ipv|rd05_rx_untagged|rd05_l2cpu|rd05_pipe|rd05_acl|rd05_trap|rd05_ffcr|rd05_daclrcr|rd05_ptrapcr|reg_cpu|reg_dma|reg_cpui|last_cpu|last_dma|last_cpuqdm|last_sirr|last_macctrl|last_sys_clk|rx_desc0|tx_desc0|hw_rx_desc|reg_cpurmdcr0|rd05_sdk_newdesc_rx|rd05_legacy_rx' || true
	else
		echo "eth0 missing"
	fi

	echo
	echo "+ ethtool -S lan2 | grep -E 'ifInBroadcastPkts|ifInMulticastPkts|ifInOctets|dot1dTpPortInDiscards|etherStatsDropEvents'"
	if [ -e /sys/class/net/lan2 ]; then
		ethtool -S lan2 2>/dev/null | grep -E 'ifInBroadcastPkts|ifInMulticastPkts|ifInOctets|dot1dTpPortInDiscards|etherStatsDropEvents' || true
	else
		echo "lan2 missing"
	fi

	echo
	rd05_switch_port_matrix
	echo
	echo "+ cat /proc/net/dev"
	cat /proc/net/dev 2>/dev/null || true

	echo
	echo "+ ip -br link; ip -br addr; ip neigh show"
	ip -br link 2>/dev/null || true
	ip -br addr 2>/dev/null || true
	ip neigh show 2>/dev/null || true

	if exists bridge; then
		echo
		echo "+ bridge link"
		bridge link 2>/dev/null || true
	fi
}


rd05_txmode_param_path() {
	for p in /sys/module/tag_rtl8_4/parameters/rd05_tx_mode \
		 /sys/module/dsa_tag_rtl8_4/parameters/rd05_tx_mode \
		 /sys/module/dsa_core/parameters/rd05_tx_mode; do
		[ -e "$p" ] && { echo "$p"; return; }
	done
}

