-static int rtl8367d_ext1_enable_ssc(struct realtek_priv *priv)
+static int rtl8367c_ext_config_ssc(struct realtek_priv *priv, int extint,
+				   bool enable)
+{
+	u32 seed = enable ? RTL8367C_EXT_SSC_SEED_ENABLE :
+			    RTL8367C_EXT_SSC_SEED_DISABLE;
+	u32 poly = enable ? RTL8367C_EXT_SSC_POLY_ENABLE :
+			    RTL8367C_EXT_SSC_POLY_DISABLE;
+	u32 ctrl = enable ? RTL8367C_EXT_SSC_CTRL_ENABLE :
+			    RTL8367C_EXT_SSC_CTRL_DISABLE;
+	int ret;
+
+	if (extint != 1 && extint != 2)
+		return -EINVAL;
+
+	ret = regmap_write(priv->map, RTL8367C_EXT_SSC_SEED_REG(extint),
+			   seed);
+	if (ret)
+		return ret;
+	ret = regmap_write(priv->map, RTL8367C_EXT_SSC_DIV_REG(extint),
+			   RTL8367C_EXT_SSC_DIV_VALUE);
+	if (ret)
+		return ret;
+	ret = regmap_write(priv->map, RTL8367C_EXT_SSC_POLY_REG(extint),
+			   poly);
+	if (ret)
+		return ret;
+	ret = regmap_write(priv->map, RTL8367C_EXT_SSC_CTRL_REG(extint),
+			   ctrl);
+	if (ret || !enable)
+		return ret;
+
+	return regmap_write(priv->map, RTL8367C_EXT_SSC_TOP_CON0_REG, 0);
+}
+
+static int rtl8367d_ext1_config_ssc(struct realtek_priv *priv, bool enable)
 {
+	u32 seed = enable ? RTL8367D_EXT1_SSC_SEED_ENABLE :
+			    RTL8367D_EXT1_SSC_SEED_DISABLE;
+	u32 poly = enable ? RTL8367D_EXT1_SSC_POLY_ENABLE :
+			    RTL8367D_EXT1_SSC_POLY_DISABLE;
+	u32 ctrl = enable ? RTL8367D_EXT1_SSC_CTRL_ENABLE :
+			    RTL8367D_EXT1_SSC_CTRL_DISABLE;
 	int ret;
 
-	/* RTL8367D DAL dal_rtl8367d_port_macForceLinkExtSSC_set(EXT_PORT1,
-	 * ENABLED).  The SDK explicitly re-tunes EXT1 to TX0/RX5 after these
-	 * writes because SSC changes the RGMII sampling point.
+	/* RTL8367D DAL dal_rtl8367d_port_macForceLinkExtSSC_set(EXT_PORT1).
+	 * The SDK re-tunes the RGMII delays after enabling SSC because the
+	 * spread-spectrum clock changes the sampling point. Keep the exact SDK
+	 * disable sequence as well; clearing these registers to zero is not the
+	 * documented hardware-off state.
 	 */
-	ret = regmap_write(priv->map, RTL8367D_EXT1_SSC_SEED_REG,
-			   RTL8367D_EXT1_SSC_SEED_ENABLE);
+
+	ret = regmap_write(priv->map, RTL8367D_EXT1_SSC_SEED_REG, seed);
 	if (ret)
 		return ret;
 	ret = regmap_write(priv->map, RTL8367D_EXT1_SSC_DIV_REG,
-			   RTL8367D_EXT1_SSC_DIV_ENABLE);
+			   RTL8367D_EXT1_SSC_DIV_VALUE);
 	if (ret)
 		return ret;
-	ret = regmap_write(priv->map, RTL8367D_EXT1_SSC_POLY_REG,
-			   RTL8367D_EXT1_SSC_POLY_ENABLE);
+	ret = regmap_write(priv->map, RTL8367D_EXT1_SSC_POLY_REG, poly);
 	if (ret)
 		return ret;
-	return regmap_write(priv->map, RTL8367D_EXT1_SSC_CTRL_REG,
-			    RTL8367D_EXT1_SSC_CTRL_ENABLE);
+	return regmap_write(priv->map, RTL8367D_EXT1_SSC_CTRL_REG, ctrl);
 }
 
-static int rtl8367d_ext1_config_rgmii(struct realtek_priv *priv)
+static int rtl8367d_ext1_config_rgmii(struct realtek_priv *priv,
+				      int tx_delay, int rx_delay)
 {
+	struct rtl8365mb *mb = priv->chip_data;
 	int ret;
 
 	/* Equivalent of the RTL8367D DAL EXT1 RGMII setup: configure EXT1
@@ -1047,19 +1183,20 @@ static int rtl8367d_ext1_config_rgmii(struct realtek_priv *priv)
 	if (ret)
 		return ret;
 
-	ret = rtl8367d_ext1_enable_ssc(priv);
+	ret = rtl8367d_ext1_config_ssc(priv, !mb->disable_ext_ssc);
 	if (ret)
 		return ret;
 
-	/* RD05 v34 hardware trace: EXT1 TX delay 0, RX sample tap 6.
-	 * Tap 5 accepted every SoC-origin packet as an FCS error; move one
-	 * adjacent sampling step while retaining the SDK SSC topology.
+	/* SDK default with SSC is TX0/RX5. RD05 hardware validation selected
+	 * adjacent RX tap 6. Device tree delay properties remain authoritative.
 	 */
 	return regmap_update_bits(priv->map, RTL8365MB_EXT_RGMXF_REG(1),
 				  RTL8365MB_EXT_RGMXF_TXDELAY_MASK |
 				  RTL8365MB_EXT_RGMXF_RXDELAY_MASK,
-				  FIELD_PREP(RTL8365MB_EXT_RGMXF_TXDELAY_MASK, 0) |
-				  FIELD_PREP(RTL8365MB_EXT_RGMXF_RXDELAY_MASK, 6));
+				  FIELD_PREP(RTL8365MB_EXT_RGMXF_TXDELAY_MASK,
+					     tx_delay) |
+				  FIELD_PREP(RTL8365MB_EXT_RGMXF_RXDELAY_MASK,
+					     rx_delay));
 }
 
 static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
@@ -1067,8 +1204,11 @@ static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
 {
 	const struct rtl8365mb_extint *extint =
 		rtl8365mb_get_port_extint(priv, port);
+	struct rtl8365mb *mb = priv->chip_data;
 	struct device_node *dn;
 	struct dsa_port *dp;
+	bool tx_delay_set = false;
+	bool rx_delay_set = false;
 	int tx_delay = 0;
 	int rx_delay = 0;
 	u32 val;
@@ -1103,6 +1243,7 @@ static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
 	 * property.
 	 */
 	if (!of_property_read_u32(dn, "tx-internal-delay-ps", &val)) {
+		tx_delay_set = true;
 		val = val / 1000; /* convert to ns */
 
 		if (val == 0 || val == 2)
@@ -1113,6 +1254,7 @@ static int rtl8365mb_ext_config_rgmii(struct realtek_priv *priv, int port,
 	}
 
