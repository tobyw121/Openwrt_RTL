From 2bef99f8e53423babe3d16c168167fd719b95c19 Mon Sep 17 00:00:00 2001
From: OpenAI <noreply@openai.com>
Date: Sat, 25 Jul 2026 14:11:10 +0000
Subject: [PATCH] net: dsa: realtek: add RTL8367 C/D family profiles


Extend rtl8365mb with runtime-ID-checked profiles for the RTL8367 C and
D register-map families. Add transport aliases, exact/fallback chip
profiles, RGMII and SSC controls, while keeping old B-map silicon
fail-closed for the revision-specific legacy driver.

Signed-off-by: OpenAI <noreply@openai.com>
---
 .../devicetree/bindings/net/dsa/realtek.yaml  |  48 ++++
 drivers/net/dsa/realtek/realtek-mdio.c        |   6 +
 drivers/net/dsa/realtek/realtek-smi.c         |   6 +
 drivers/net/dsa/realtek/rtl8365mb.c           | 269 +++++++++++++++---
 4 files changed, 293 insertions(+), 36 deletions(-)

diff --git a/Documentation/devicetree/bindings/net/dsa/realtek.yaml b/Documentation/devicetree/bindings/net/dsa/realtek.yaml
index cfd69c2..734a42c 100644
--- a/Documentation/devicetree/bindings/net/dsa/realtek.yaml
+++ b/Documentation/devicetree/bindings/net/dsa/realtek.yaml
@@ -8,6 +8,10 @@ title: Realtek switches for unmanaged switches
 
 allOf:
   - $ref: dsa.yaml#/$defs/ethernet-ports
+  - not:
+      required:
+        - realtek,enable-ext-ssc
+        - realtek,disable-ext-ssc
 
 maintainers:
   - Linus Walleij <linus.walleij@linaro.org>
@@ -39,6 +43,12 @@ properties:
     enum:
       - realtek,rtl8365mb
       - realtek,rtl8366rb
+      - realtek,rtl8367c
+      - realtek,rtl8367d
+      - realtek,rtl8367r
+      - realtek,rtl8367rb
+      - realtek,rtl8367rb-vb
+      - realtek,rtl8367rb-vc
     description: |
       realtek,rtl8365mb:
         Use with models RTL8363NB, RTL8363NB-VB, RTL8363SC, RTL8363SC-VB,
@@ -46,6 +56,18 @@ properties:
         RTL8367SB, RTL8370MB, RTL8310SR
       realtek,rtl8366rb:
         Use with models RTL8366RB, RTL8366S
+      realtek,rtl8367c and realtek,rtl8367rb-vb:
+        Use with C-register-map silicon. The SDK recognizes chip IDs 0x0276,
+        0x0597 and 0x6367; exact chip ID and revision probing remains
+        authoritative. RTL8367RB-VB normally uses physical port 6 / EXT0 as
+        the RGMII CPU link and can also expose physical port 7 / EXT1.
+      realtek,rtl8367d and realtek,rtl8367rb-vc:
+        Use with D-register-map silicon, chip ID 0x6642. RTL8367RB-VC is the
+        marketing variant handled by the SDK's RTL8367D DAL and has physical
+        port 7 / EXT1 as its RGMII CPU link.
+      realtek,rtl8367r and realtek,rtl8367rb:
+        Marketing-family aliases. Runtime chip probing accepts only a known
+        C-map or D-map ID; unsupported older B-map silicon fails safely.
 
   mdc-gpios:
     description: GPIO line for the MDC clock line.
@@ -59,6 +81,32 @@ properties:
     description: GPIO to be used to reset the whole device
     maxItems: 1
 
+  realtek,enable-ext-ssc:
+    type: boolean
+    description: |
+      Enable the RTL8367C/RTL8367RB-VB external-interface spread-spectrum
+      clock sequence. RTL8197F vendor designs normally enable SSC for EMI and
+      then use TX delay 0 and RX delay tap 5 unless explicit delay properties
+      override those defaults. D-map silicon enables SSC by default.
+
+  realtek,disable-ext-ssc:
+    type: boolean
+    description: |
+      Disable external-interface spread-spectrum clocking. On D-map
+      RTL8367D/RTL8367RB-VC this overrides the default SDK SSC sequence. On
+      C-map silicon it requests the exact vendor disable sequence. It must not
+      be combined with realtek,enable-ext-ssc. Use only when board clock design
+      or signal-integrity validation requires a non-SSC clock.
+
+  realtek,rtl8197f-cpu-path-bootstrap:
+    type: boolean
+    description: |
+      Enable the RTL8197F plus RTL8367D/RB-VC bootstrap used by the RD05-style
+      topology: CPU port 7 / EXT1, 8-byte rtl8_4 tag, and an initial shared
+      CPU-path VLAN/flood/isolation state. Normal DSA bridge and VLAN setup
+      remains authoritative after probe. This property is ignored for C-map
+      switches.
+
   realtek,disable-leds:
     type: boolean
     description: |
