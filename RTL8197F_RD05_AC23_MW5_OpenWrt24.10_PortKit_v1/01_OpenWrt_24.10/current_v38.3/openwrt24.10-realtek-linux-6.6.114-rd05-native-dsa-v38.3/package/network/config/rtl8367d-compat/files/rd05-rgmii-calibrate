#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# RD05 RTL8197F P0 <-> RTL8367D EXT1 RGMII calibration helper, v38.3.

set -eu

SOC="${RD05_RGMII_SOC_SYSFS:-/sys/module/rtl8197f_rtknet/parameters}"
SW="${RD05_RGMII_SW_SYSFS:-/sys/module/rtl8365mb/parameters}"
CONF_DEFAULT=/etc/rd05-rgmii.conf
CONF="${RD05_RGMII_CONF:-$CONF_DEFAULT}"
APPLY_SETTLE_MS="${RD05_RGMII_APPLY_SETTLE_MS:-1000}"
SWEEP_SETTLE_MS="${RD05_RGMII_SWEEP_SETTLE_MS:-200}"
ROLLBACK_ACTIVE=0
ROLLBACK_SOC_TX=0
ROLLBACK_SOC_RX=6
ROLLBACK_SW_TX=0
ROLLBACK_SW_TXC=0
ROLLBACK_SW_RX=5
ROLLBACK_SSC=1

fail() { echo "rd05-rgmii-calibrate: $*" >&2; exit 1; }
num() { case "${1:-}" in ''|*[!0-9]*) echo 0 ;; *) echo "$1" ;; esac; }
uint() { case "${1:-}" in ''|*[!0-9]*) return 1 ;; *) return 0 ;; esac; }
settle_ms() {
	ms="${1:-0}"
	uint "$ms" || fail "settle time must be an integer number of milliseconds"
	[ "$ms" -le 60000 ] || fail "settle time exceeds 60000 ms"
	[ "$ms" -gt 0 ] || return 0
	if command -v usleep >/dev/null 2>&1; then
		usleep "$((ms * 1000))"
	elif command -v busybox >/dev/null 2>&1 && busybox usleep 1 >/dev/null 2>&1; then
		busybox usleep "$((ms * 1000))"
	else
		# BusyBox builds without usleep also reject fractional sleep values.
		# Round upward so calibration remains portable and safe.
		sleep "$(((ms + 999) / 1000))"
	fi
}
readf() { [ -r "$1" ] && cat "$1" || echo -; }
statv() {
	dev="$1"; key="$2"
	ethtool -S "$dev" 2>/dev/null | awk -v k="$key" '$1 == k":" { print $2; exit }'
}
rxpkts() {
	awk -v d="$1" '$1 ~ ("^" d ":") { gsub(":", "", $1); print $3; exit }' /proc/net/dev 2>/dev/null
}
validate() {
	[ "$1" -ge 0 ] && [ "$1" -le 1 ] || fail "SoC TX delay must be 0..1"
	[ "$2" -ge 0 ] && [ "$2" -le 7 ] || fail "SoC RX delay must be 0..7"
	[ "$3" -ge 0 ] && [ "$3" -le 1 ] || fail "switch coarse TX delay must be 0..1"
	[ "$4" -ge 0 ] && [ "$4" -le 7 ] || fail "switch fine TX-clock tap must be 0..7"
	[ "$5" -ge 0 ] && [ "$5" -le 7 ] || fail "switch RX delay must be 0..7"
	[ "$6" -ge 0 ] && [ "$6" -le 1 ] || fail "SSC must be 0 or 1"
}
need_params() {
	[ -w "$SOC/rd05_p0_tx_delay" ] || fail "$SOC/rd05_p0_tx_delay is unavailable"
	[ -w "$SOC/rd05_p0_rx_delay" ] || fail "$SOC/rd05_p0_rx_delay is unavailable"
	[ -w "$SW/rd05_ext1_tx_delay" ] || fail "$SW/rd05_ext1_tx_delay is unavailable"
	[ -w "$SW/rd05_ext1_txc_tap" ] || fail "$SW/rd05_ext1_txc_tap is unavailable (v38 kernel required)"
	[ -w "$SW/rd05_ext1_rx_delay" ] || fail "$SW/rd05_ext1_rx_delay is unavailable"
	[ -w "$SW/rd05_ext1_ssc" ] || fail "$SW/rd05_ext1_ssc is unavailable"
}
current() {
	SOC_TX="$(num "$(readf "$SOC/rd05_p0_tx_delay")")"
	SOC_RX="$(num "$(readf "$SOC/rd05_p0_rx_delay")")"
	SW_TX="$(num "$(readf "$SW/rd05_ext1_tx_delay")")"
	SW_TXC="$(num "$(readf "$SW/rd05_ext1_txc_tap")")"
	SW_RX="$(num "$(readf "$SW/rd05_ext1_rx_delay")")"
	case "$(readf "$SW/rd05_ext1_ssc")" in Y|y|1) SSC=1 ;; *) SSC=0 ;; esac
}
arm_rollback() {
	current
	ROLLBACK_SOC_TX="$SOC_TX"; ROLLBACK_SOC_RX="$SOC_RX"
	ROLLBACK_SW_TX="$SW_TX"; ROLLBACK_SW_TXC="$SW_TXC"
	ROLLBACK_SW_RX="$SW_RX"; ROLLBACK_SSC="$SSC"
	ROLLBACK_ACTIVE=1
	trap 'rollback_exit $?' EXIT
	trap 'rollback_exit 129' HUP
	trap 'rollback_exit 130' INT
	trap 'rollback_exit 143' TERM
}
disarm_rollback() {
	ROLLBACK_ACTIVE=0
	trap - EXIT HUP INT TERM
}
rollback_exit() {
	rc="${1:-1}"
	trap - EXIT HUP INT TERM
	if [ "$ROLLBACK_ACTIVE" -eq 1 ]; then
		echo "rd05-rgmii-calibrate: restoring pre-sweep profile after exit $rc" >&2
		set +e
		APPLY_SETTLE_MS=1000 apply_values "$ROLLBACK_SOC_TX" "$ROLLBACK_SOC_RX" \
			"$ROLLBACK_SW_TX" "$ROLLBACK_SW_TXC" "$ROLLBACK_SW_RX" "$ROLLBACK_SSC"
		restore_rc=$?
		set -e
		[ "$restore_rc" -eq 0 ] || echo "rd05-rgmii-calibrate: rollback failed ($restore_rc); run: rd05-rgmii-calibrate sdk" >&2
	fi
	exit "$rc"
}
verify_values() {
	exp_soc_tx="$1"; exp_soc_rx="$2"; exp_sw_tx="$3"
	exp_sw_txc="$4"; exp_sw_rx="$5"; exp_ssc="$6"
	current
	[ "$SOC_TX" -eq "$exp_soc_tx" ] && [ "$SOC_RX" -eq "$exp_soc_rx" ] && \
	[ "$SW_TX" -eq "$exp_sw_tx" ] && [ "$SW_TXC" -eq "$exp_sw_txc" ] && \
	[ "$SW_RX" -eq "$exp_sw_rx" ] && [ "$SSC" -eq "$exp_ssc" ]
}
apply_values() {
	SOC_TX="$1"; SOC_RX="$2"; SW_TX="$3"; SW_TXC="$4"; SW_RX="$5"; SSC="$6"
	validate "$SOC_TX" "$SOC_RX" "$SW_TX" "$SW_TXC" "$SW_RX" "$SSC"
	need_params
	# The switch callbacks apply immediately. Program SSC first, then coarse
	# and fine TX timing, then RX timing. Replay the RTL8197F P0 setup last.
	echo "$SSC" > "$SW/rd05_ext1_ssc"
	echo "$SW_TX" > "$SW/rd05_ext1_tx_delay"
	echo "$SW_TXC" > "$SW/rd05_ext1_txc_tap"
	echo "$SW_RX" > "$SW/rd05_ext1_rx_delay"
	echo "$SOC_TX" > "$SOC/rd05_p0_tx_delay"
	echo "$SOC_RX" > "$SOC/rd05_p0_rx_delay"
	if command -v rd05-ioctl >/dev/null 2>&1; then
		rd05-ioctl eth0 reseed >/dev/null 2>&1 || fail "failed to replay RTL8197F P0 setup"
	else
		fail "rd05-ioctl is missing"
	fi
	settle_ms "$APPLY_SETTLE_MS"
	verify_values "$SOC_TX" "$SOC_RX" "$SW_TX" "$SW_TXC" "$SW_RX" "$SSC" || \
		fail "RGMII parameter readback mismatch"
}
show_status() {
	current
	echo "SOC_TX=$SOC_TX"
	echo "SOC_RX=$SOC_RX"
	echo "SW_TX=$SW_TX"
	echo "SW_TXC=$SW_TXC"
	echo "SW_RX=$SW_RX"
	echo "SSC=$SSC"
	if [ "$SOC_TX$SOC_RX$SW_TX$SW_TXC$SW_RX$SSC" = 000000 ]; then
		echo "WARNING: all-zero runtime profile; restore the SDK baseline with: rd05-rgmii-calibrate sdk" >&2
	fi
	dmesg 2>/dev/null | grep -E 'rd05 p0 rgmii v38(\.[0-9]+)?:|RTL8367D RD05 (DSA CPU path|RGMII v38 reapply):' | tail -3 || true
	ethtool -S eth0 2>/dev/null | grep -E 'rx_cdp_|rd05_rx_external|rd05_rx_arp|rx_desc0_opts1|p07_if(In|Out)Octets|p07_dot3StatsFCSErrors|p07_etherStatsDropEvents' || true
}
save_conf() {
	current
	tmp="${CONF}.tmp.$$"
	umask 077
	cat > "$tmp" <<EOC
# RD05 v38 calibrated RGMII settings.
PROFILE_VERSION=38
SOC_TX=$SOC_TX
SOC_RX=$SOC_RX
SW_TX=$SW_TX
SW_TXC=$SW_TXC
SW_RX=$SW_RX
SSC=$SSC
EOC
	mv "$tmp" "$CONF"
	echo "saved $CONF"
}
load_conf() {
	# SDK baseline from the RTL8197F-VG + RTL8367D family-D BSP/DAL.
	PROFILE_VERSION=38
	SOC_TX=0; SOC_RX=6; SW_TX=0; SW_TXC=0; SW_RX=5; SSC=1

	if [ -r "$CONF" ]; then
		PROFILE_VERSION=0
		# shellcheck disable=SC1090
		. "$CONF"
	fi

	case "${PROFILE_VERSION:-0}" in
		38)
			;;
		*)
			old="${CONF}.pre-v38"
			if [ -r "$CONF" ] && [ ! -e "$old" ]; then
				cp -p "$CONF" "$old" 2>/dev/null || cp "$CONF" "$old" 2>/dev/null || true
			fi
			echo "migrating ${CONF} from profile ${PROFILE_VERSION:-unversioned} to v38 SDK baseline" >&2
			PROFILE_VERSION=38
			SOC_TX=0; SOC_RX=6; SW_TX=0; SW_TXC=0; SW_RX=5; SSC=1
			tmp="${CONF}.tmp.$$"
			umask 077
			cat > "$tmp" <<EOC
# RD05 v38 SDK baseline; previous file saved as ${old} when available.
PROFILE_VERSION=38
SOC_TX=0
SOC_RX=6
SW_TX=0
SW_TXC=0
SW_RX=5
SSC=1
EOC
			mv "$tmp" "$CONF"
			;;
	esac

	validate "$SOC_TX" "$SOC_RX" "$SW_TX" "$SW_TXC" "$SW_RX" "$SSC"
	apply_values "$SOC_TX" "$SOC_RX" "$SW_TX" "$SW_TXC" "$SW_RX" "$SSC"
}
# Router -> switch direction. CPU7 ifIn/FCS counters directly reveal whether
# RTL8367D sampled the RTL8197F transmit clock/data correctly.
tx_auto() {
	command -v rd05-raw >/dev/null 2>&1 || fail "rd05-raw is missing"
	command -v ethtool >/dev/null 2>&1 || fail "ethtool is missing"
	arm_rollback
	keep_soc_tx="$ROLLBACK_SOC_TX"; keep_soc_rx="$ROLLBACK_SOC_RX"; keep_sw_tx="$ROLLBACK_SW_TX"; keep_sw_txc="$ROLLBACK_SW_TXC"; keep_sw_rx="$ROLLBACK_SW_RX"; keep_ssc="$ROLLBACK_SSC"
	best_score=2147483647; best_in=0; best_soc_tx=-1; best_sw_rx=-1; best_ssc=-1
	session="rgmii-tx-$(date +%s 2>/dev/null || echo $$)"
	report=/tmp/rd05-rgmii-tx-v38.3.tsv
	printf 'ssc\tsoc_tx\tsw_rx\tcpu7_in\tfcs\tdrop\tscore\n' > "$report"
	echo "Sweeping RTL8197F TX delay, RTL8367D RX tap and SSC (32 rows)."
	APPLY_SETTLE_MS="$SWEEP_SETTLE_MS"
	for ssc in 0 1; do
		for soc_tx in 0 1; do
			for sw_rx in 0 1 2 3 4 5 6 7; do
				apply_values "$soc_tx" "$keep_soc_rx" "$keep_sw_tx" "$keep_sw_txc" "$sw_rx" "$ssc"
				f0="$(num "$(statv eth0 p07_dot3StatsFCSErrors)")"
				d0="$(num "$(statv eth0 p07_etherStatsDropEvents)")"
				i0="$(num "$(statv eth0 p07_ifInOctets)")"
				rd05-raw send lan2 ff:ff:ff:ff:ff:ff router probe "$session" 1 256 12 >/dev/null 2>&1 || true
				sleep 1
				f1="$(num "$(statv eth0 p07_dot3StatsFCSErrors)")"
				d1="$(num "$(statv eth0 p07_etherStatsDropEvents)")"
				i1="$(num "$(statv eth0 p07_ifInOctets)")"
				fd=$((f1-f0)); dd=$((d1-d0)); id=$((i1-i0))
				[ "$fd" -ge 0 ] || fd=0; [ "$dd" -ge 0 ] || dd=0; [ "$id" -ge 0 ] || id=0
				score=$((fd*1000000 + dd*10000))
				printf '%u\t%u\t%u\t%u\t%u\t%u\t%u\n' "$ssc" "$soc_tx" "$sw_rx" "$id" "$fd" "$dd" "$score" >> "$report"
				printf 'ssc=%u soc_tx=%u sw_rx=%u cpu7_in=%u fcs=%u drop=%u score=%u\n' "$ssc" "$soc_tx" "$sw_rx" "$id" "$fd" "$dd" "$score"
				if [ "$id" -gt 0 ] && { [ "$score" -lt "$best_score" ] || { [ "$score" -eq "$best_score" ] && [ "$id" -gt "$best_in" ]; }; }; then
					best_score="$score"; best_in="$id"; best_soc_tx="$soc_tx"; best_sw_rx="$sw_rx"; best_ssc="$ssc"
				fi
			done
		done
	done
	APPLY_SETTLE_MS=1000
	if [ "$best_soc_tx" -lt 0 ]; then
		apply_values "$keep_soc_tx" "$keep_soc_rx" "$keep_sw_tx" "$keep_sw_txc" "$keep_sw_rx" "$keep_ssc"
		fail "no CPU7 ingress was measured; report: $report"
	fi
	apply_values "$best_soc_tx" "$keep_soc_rx" "$keep_sw_tx" "$keep_sw_txc" "$best_sw_rx" "$best_ssc"
	echo "BEST_TX SOC_TX=$best_soc_tx SW_RX=$best_sw_rx SSC=$best_ssc score=$best_score cpu7_in=$best_in report=$report"
	[ "${1:-}" = save ] && save_conf
	disarm_rollback
}

# Switch -> SoC direction. A PC must continuously transmit with:
#   sudo rd05-pc-netdiag.py --interface IFACE --configure-ip --calibration --duration 240
# v38 retains the RTL8367D family-D 0x13f9 fine TX-clock sweep in addition to
# the public coarse TX delay and RTL8197F RX tap.
rx_auto() {
	command -v ethtool >/dev/null 2>&1 || fail "ethtool is missing"
	arm_rollback
	keep_soc_tx="$ROLLBACK_SOC_TX"; keep_soc_rx="$ROLLBACK_SOC_RX"; keep_sw_tx="$ROLLBACK_SW_TX"; keep_sw_txc="$ROLLBACK_SW_TXC"; keep_sw_rx="$ROLLBACK_SW_RX"; keep_ssc="$ROLLBACK_SSC"
	best_score=0; best_soc_rx=-1; best_sw_tx=-1; best_sw_txc=-1; best_out=0
	report=/tmp/rd05-rgmii-rx-v38.3.tsv
	printf 'sw_tx\tsw_txc\tsoc_rx\tcpu7_out\teth0_rx\texternal\tcdp\tscore\n' > "$report"
	echo "PC must send continuously. Sweeping switch coarse TX, 0x13f9 fine TXC and SoC RX (128 rows, about 3 minutes)."
	APPLY_SETTLE_MS="$SWEEP_SETTLE_MS"
	for sw_tx in 0 1; do
		for sw_txc in 0 1 2 3 4 5 6 7; do
			for soc_rx in 0 1 2 3 4 5 6 7; do
				apply_values "$keep_soc_tx" "$soc_rx" "$sw_tx" "$sw_txc" "$keep_sw_rx" "$keep_ssc"
				r0="$(num "$(rxpkts eth0)")"; e0="$(num "$(statv eth0 rd05_rx_external)")"; c0="$(num "$(statv eth0 rx_cdp_advanced)")"; o0="$(num "$(statv eth0 p07_ifOutOctets)")"
				sleep 1
				r1="$(num "$(rxpkts eth0)")"; e1="$(num "$(statv eth0 rd05_rx_external)")"; c1="$(num "$(statv eth0 rx_cdp_advanced)")"; o1="$(num "$(statv eth0 p07_ifOutOctets)")"
				rd=$((r1-r0)); ed=$((e1-e0)); cd=$((c1-c0)); od=$((o1-o0))
				[ "$rd" -ge 0 ] || rd=0; [ "$ed" -ge 0 ] || ed=0; [ "$cd" -ge 0 ] || cd=0; [ "$od" -ge 0 ] || od=0
				score=$((ed*100000000 + rd*100000 + cd))
				printf '%u\t%u\t%u\t%u\t%u\t%u\t%u\t%u\n' "$sw_tx" "$sw_txc" "$soc_rx" "$od" "$rd" "$ed" "$cd" "$score" >> "$report"
				printf 'sw_tx=%u sw_txc=%u soc_rx=%u cpu7_out=%u eth0_rx=%u external=%u cdp=%u score=%u\n' "$sw_tx" "$sw_txc" "$soc_rx" "$od" "$rd" "$ed" "$cd" "$score"
				if [ "$od" -gt 0 ] && [ "$score" -gt "$best_score" ]; then
					best_score="$score"; best_soc_rx="$soc_rx"; best_sw_tx="$sw_tx"; best_sw_txc="$sw_txc"; best_out="$od"
				fi
			done
		done
	done
	APPLY_SETTLE_MS=1000
	if [ "$best_soc_rx" -lt 0 ] || [ "$best_score" -eq 0 ]; then
		apply_values "$keep_soc_tx" "$keep_soc_rx" "$keep_sw_tx" "$keep_sw_txc" "$keep_sw_rx" "$keep_ssc"
		fail "CPU7 emitted PC traffic, but no RTL8197F RX candidate succeeded; report: $report"
	fi
	apply_values "$keep_soc_tx" "$best_soc_rx" "$best_sw_tx" "$best_sw_txc" "$keep_sw_rx" "$keep_ssc"
	echo "BEST_RX SOC_RX=$best_soc_rx SW_TX=$best_sw_tx SW_TXC=$best_sw_txc score=$best_score cpu7_out=$best_out report=$report"
	[ "${1:-}" = save ] && save_conf
	disarm_rollback
}

usage() {
	cat <<'EOT'
Usage: rd05-rgmii-calibrate COMMAND [arguments]
  status                                  show active delays, SSC and counters
  apply SOC_TX SOC_RX SW_TX SW_TXC SW_RX SSC
  load                                    apply /etc/rd05-rgmii.conf
  save                                    write /etc/rd05-rgmii.conf
  sdk                                     restore SDK production 0/6 0/0/5 SSC=1
  restore                                 alias for sdk
  safe                                    apply conservative 0/6 0/0/2 SSC=0
  tx-auto [save]                          calibrate router/SoC -> RTL8367D; rollback on failure
  rx-auto [save]                          full RTL8367D -> SoC sweep; rollback on failure
  version                                 print helper version
EOT
}

cmd="${1:-status}"; shift || true
case "$cmd" in
	status) show_status ;;
	apply) [ "$#" -eq 6 ] || { usage; exit 2; }; apply_values "$@"; show_status ;;
	load) load_conf; show_status ;;
	save) save_conf ;;
	sdk|restore) apply_values 0 6 0 0 5 1; show_status ;;
	safe) apply_values 0 6 0 0 2 0; show_status ;;
	tx-auto) tx_auto "${1:-}" ;;
	rx-auto) rx_auto "${1:-}" ;;
	version) echo "rd05-rgmii-calibrate v38.3 release 11" ;;
	help|-h|--help) usage ;;
	*) usage; exit 2 ;;
esac
