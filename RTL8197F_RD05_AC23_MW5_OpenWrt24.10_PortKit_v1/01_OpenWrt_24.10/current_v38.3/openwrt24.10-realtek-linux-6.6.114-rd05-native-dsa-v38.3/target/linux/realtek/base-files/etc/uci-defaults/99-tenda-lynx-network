#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Tenda/Lynx RTL8197F + RTL8367 DSA network defaults.

. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
	*tenda,lynx-rtl8197f*) ;;
	*) exit 0 ;;
esac

lan_mac="$(mtd_get_mac_ascii factory TENDA.lan_mac 2>/dev/null)"
wan_mac=""
[ -n "$lan_mac" ] && wan_mac="$(macaddr_add "$lan_mac" 2)"

while uci -q delete network.@device[0]; do :; done

uci -q batch <<'UCI'
delete network.loopback
delete network.globals
delete network.br_lan
delete network.lan
delete network.wan_dev
delete network.wan
delete network.wan6

set network.loopback='interface'
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'

set network.globals='globals'
set network.globals.ula_prefix='fd00:7979:197f::/48'

set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
set network.br_lan.stp='0'
set network.br_lan.igmp_snooping='0'
add_list network.br_lan.ports='lan1'
add_list network.br_lan.ports='lan2'
add_list network.br_lan.ports='lan3'
add_list network.br_lan.ports='lan4'

set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'

set network.wan_dev='device'
set network.wan_dev.name='wan'
set network.wan_dev.ipv6='1'

set network.wan='interface'
set network.wan.device='wan'
set network.wan.proto='dhcp'

set network.wan6='interface'
set network.wan6.device='@wan'
set network.wan6.proto='dhcpv6'
UCI

if [ -n "$lan_mac" ]; then
	uci -q set network.br_lan.macaddr="$lan_mac"
	uci -q set network.lan.macaddr="$lan_mac"
fi
if [ -n "$wan_mac" ]; then
	uci -q set network.wan_dev.macaddr="$wan_mac"
	uci -q set network.wan.macaddr="$wan_mac"
fi
uci -q commit network
exit 0
