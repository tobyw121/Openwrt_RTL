From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: OpenWrt RTL8197F bringup <noreply@example.invalid>
Date: Tue, 02 Jun 2026 00:00:00 +0000
Subject: [PATCH] net: ethernet: add Xiaomi RD05 OEM RTL8367D preinit helper

Port the small but critical board-level switch reset deassertion sequence from
Realtek's RTL8197F/RTL8367 GPL/SDK path.  The RD05 OEM kernel exports
rtl819x_8367r_reset_pin.0 as GPIO58/H2 and leaves the external switch reset
line high before the 83xx/8367 SMI probe.  The native Linux realtek-smi probe
runs before the diagnostic driver; if the reset line is still low, the RTL8367D
does not ACK the first SMI command.

The helper is an early initcall for xiaomi,r4-rd05 only.  It selects the H2
pinmux mode, configures H2 as GPIO output and drives it high.  It does not
pulse reset low; DSA reset-gpios remains omitted on RD05 test images.

---
--- a/drivers/net/ethernet/Kconfig
+++ b/drivers/net/ethernet/Kconfig
@@ -41,6 +41,17 @@ config RTL8197F_RTKNET
 
 	  driver still requires board-level validation of descriptor address format,
 	  port-mask semantics and external switch wiring.
+
+config RTL8197F_RD05_OEM_SWITCH_PREINIT
+	bool "Xiaomi RD05 OEM RTL8367D reset/pinmux pre-initialisation"
+	depends on RTL8197F && HAS_IOMEM && OF
+	default y if RTL8197F
+	help
+	  Enable a tiny early initcall for Xiaomi R4/RD05 boards which mirrors the
+	  Realtek GPL/SDK pre-DSA setup for the external RTL8367D switch: select the
+	  H2 reset pinmux function and drive GPIO58/H2 high before the native
+	  realtek-smi DSA probe runs.  It does not import the legacy rtknet fastpath
+	  or the full vendor switch stack.
 
 config SUNGEM_PHY
 	tristate
--- a/drivers/net/ethernet/Makefile
+++ b/drivers/net/ethernet/Makefile
@@ -6,5 +6,6 @@
 obj-$(CONFIG_RTL8197F_ETH_DIAG) += rtl8197f_ethdiag.o
 obj-$(CONFIG_RTL8197F_RTKNET) += rtl8197f_rtknet.o
+obj-$(CONFIG_RTL8197F_RD05_OEM_SWITCH_PREINIT) += rtl8197f_rd05_oem_switch_preinit.o
 obj-$(CONFIG_NET_VENDOR_3COM) += 3com/
 obj-$(CONFIG_NET_VENDOR_8390) += 8390/
 obj-$(CONFIG_NET_VENDOR_ACTIONS) += actions/
