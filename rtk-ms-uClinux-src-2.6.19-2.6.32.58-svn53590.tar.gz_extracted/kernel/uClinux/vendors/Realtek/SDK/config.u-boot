#
# Automatically generated by make menuconfig: don't edit
#
CONFIG_MISC_INIT_R=y
CONFIG_STANDALONE_UBOOT=y

#
# Board
#
CONFIG_RTL839XS=y
# CONFIG_RTL838XS is not set
CONFIG_UART0=y
# CONFIG_UART1 is not set
CONFIG_EEE=y
# CONFIG_EEE_COMPATIBLE is not set
# CONFIG_INTERRUPT_SUPPORT is not set
# CONFIG_MDC_MDIO_EXT_SUPPORT is not set

#
# Board Probe
#
CONFIG_RTK_BOARD=y
CONFIG_RTL8353M_QA=y
CONFIG_RTL8392M_QA=y
CONFIG_RTL8393M_QA=y
CONFIG_RTL8353M_DEMO=y
CONFIG_RTL8353M_14B_DEMO=y
CONFIG_RTL8391M_DEMO=y
CONFIG_RTL8392M_DEMO=y
CONFIG_RTL8393M_DEMO=y
CONFIG_RTL8396M_DEMO=y
# CONFIG_RTL8390_FPGA is not set
# CONFIG_CUSTOMER_BOARD is not set

#
# PHY Probe
#
CONFIG_RTL8208=y
CONFIG_RTL8212B=y
CONFIG_RTL8212F=y
CONFIG_RTL8214=y
CONFIG_RTL8214B=y
CONFIG_RTL8214F=y
CONFIG_RTL8214FB=y
CONFIG_RTL8214FC=y
CONFIG_RTL8218=y
CONFIG_RTL8218B=y
CONFIG_RTL8218FB=y

#
# Supported Commands
#
CONFIG_CMDLINE_EDITING=y
CONFIG_CMD_FLASH=y
CONFIG_CMD_MEMORY=y
CONFIG_CMD_LOADB=y
# CONFIG_CMD_LOADS is not set
CONFIG_CMD_IMI=y
# CONFIG_CMD_ENV is not set
# CONFIG_CMD_DUMPREGS is not set
CONFIG_CMD_SAVEENV=y
CONFIG_RTK_BOOT=y
CONFIG_TFTP_DOWNLOAD=y
# CONFIG_SERIAL_DOWNLOAD is not set
# CONFIG_ICE_DOWNLOAD is not set
# CONFIG_STANDALONE_APP is not set
CONFIG_CMD_NET=y
CONFIG_NET_MULTI=y
CONFIG_AUTOBOOT_PROMPT=""
CONFIG_CMD_RTK=y
CONFIG_CMD_RUN=y

#
# Networking
#
CONFIG_ETHADDR="00:E0:4C:00:00:00"
CONFIG_CMD_NET=y
CONFIG_CMD_PING=y
CONFIG_NET_MULTI=y
CONFIG_IPADDR="192.168.1.1"
CONFIG_SERVERIP="192.168.1.111"

#
# Miscellaneous
#
CFG_PROMPT="RTL8390 # "
CONFIG_SYS_TEXT_BASE=0x83F00000
CONFIG_BOOTDELAY=1
CONFIG_BOOTCOMMAND="boota"
CONFIG_BOARDVERSION=""
CONFIG_BOARDMODEL="RTL8393M_DEMO"
CONFIG_BOOTARGS=""
CONFIG_POSTWORD=""
CONFIG_BAUDRATE=115200

#
# System
#
# CONFIG_FLASH_SIZE_4MB is not set
# CONFIG_FLASH_SIZE_8MB is not set
CONFIG_FLASH_SIZE_16MB=y
# CONFIG_FLASH_SIZE_32MB is not set
# CONFIG_FLASH_LAYOUT_TYPE1 is not set
# CONFIG_FLASH_LAYOUT_TYPE2 is not set
# CONFIG_FLASH_LAYOUT_TYPE3 is not set
CONFIG_FLASH_LAYOUT_TYPE4=y
CONFIG_TURNKEY_SYSINFO=y
# CONFIG_TURNKEY_ACTION_MENU is not set
CONFIG_DUAL_IMAGE=y
CONFIG_DUAL_IMAGE_PARTITION_SIZE=6B0000
# CONFIG_ENABLE_IH_MAGIC_NUMBER_CHK is not set
CONFIG_IH_MAGIC_NUMBER=83800000
# CONFIG_ENV_CRC_ERROR_SAVE_DEFAULT_ENV is not set
CONFIG_CONS_INDEX=1
# CONFIG_SERIAL_SOFTWARE_FIFO is not set
CONFIG_SYS_SDRAM_BASE=0x80000000
CONFIG_MTD_PARTITIONS="n"
CONFIG_RTL8390=y
CONFIG_ENV_OVERWRITE=y
CONFIG_EXCEPTION_BASE=0xbf000000

#
# 839x Diagnosis Tools
