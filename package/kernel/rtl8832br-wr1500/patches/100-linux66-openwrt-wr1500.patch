+		CASE_HE_RATE(3, 2);
+		CASE_HE_RATE(3, 3);
+		CASE_HE_RATE(3, 4);
+		CASE_HE_RATE(3, 5);
+		CASE_HE_RATE(3, 6);
+		CASE_HE_RATE(3, 7);
+		CASE_HE_RATE(3, 8);
+		CASE_HE_RATE(3, 9);
