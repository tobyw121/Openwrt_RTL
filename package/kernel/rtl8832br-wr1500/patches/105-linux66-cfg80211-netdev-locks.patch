From: OpenWrt RTL maintainers
Subject: [PATCH] wifi: distinguish cfg80211 callback locks on Linux 6.6

OEM module registration uses generic netdevice APIs under cfg80211 callbacks.
Linux 6.6 requires the cfg80211 helpers there to avoid recursive wiphy locking.
Track the current callback task separately from the vendor RTNL-only marker.
Probe/remove and legacy ioctl rename keep their ordinary locking paths.

--- a/include/drv_types.h
+++ b/include/drv_types.h
@@ -1489,6 +1489,8 @@
 
 	#if defined(PLATFORM_LINUX) || defined(PLATFORM_ECOS)
 	_thread_hdl_ rtnl_lock_holder;
+	/* Only cfg80211 callbacks hold BOTH RTNL and the wiphy mutex. */
+	_thread_hdl_ cfg80211_lock_holder;
 
 	#if defined(CONFIG_IOCTL_CFG80211)
 	struct wiphy *wiphy;
--- a/include/osdep_intf.h
+++ b/include/osdep_intf.h
@@ -74,6 +74,8 @@
 	#include "../os_dep/linux/ioctl_cfg80211.h"
 #endif /* CONFIG_IOCTL_CFG80211 */
 
+int rtw_linux_register_netdev(struct dvobj_priv *dvobj, struct net_device *ndev);
+void rtw_linux_unregister_netdev(struct dvobj_priv *dvobj, struct net_device *ndev);
 u8 rtw_rtnl_lock_needed(struct dvobj_priv *dvobj);
 void rtw_set_rtnl_lock_holder(struct dvobj_priv *dvobj, _thread_hdl_ thd_hdl);
 
--- a/os_dep/linux/os_intfs.c
+++ b/os_dep/linux/os_intfs.c
@@ -619,12 +619,41 @@
 #endif /* CONFIG_IOCTL_CFG80211 */
 /* For ethtool --- */
 
+/* Linux 6.6 cfg80211 callbacks already hold RTNL and wiphy->mtx.
+ * The generic notifier path would take wiphy->mtx recursively. Do not infer
+ * callback context from rtnl_is_locked(): another thread may own that lock,
+ * and the vendor rename ioctl holds RTNL without holding the wiphy mutex.
+ */
+int rtw_linux_register_netdev(struct dvobj_priv *dvobj, struct net_device *ndev)
+{
+#if defined(CONFIG_IOCTL_CFG80211) && LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	if (READ_ONCE(dvobj->cfg80211_lock_holder) == current)
+		return cfg80211_register_netdevice(ndev);
+#endif
+	if (rtw_rtnl_lock_needed(dvobj))
+		return register_netdev(ndev);
+	return register_netdevice(ndev);
+}
+
+void rtw_linux_unregister_netdev(struct dvobj_priv *dvobj, struct net_device *ndev)
+{
+#if defined(CONFIG_IOCTL_CFG80211) && LINUX_VERSION_CODE >= KERNEL_VERSION(6, 6, 0)
+	if (READ_ONCE(dvobj->cfg80211_lock_holder) == current) {
+		cfg80211_unregister_netdevice(ndev);
+		return;
+	}
+#endif
+	if (rtw_rtnl_lock_needed(dvobj))
+		unregister_netdev(ndev);
+	else
+		unregister_netdevice(ndev);
+}
+
 int rtw_os_ndev_register(_adapter *adapter, const char *name)
 {
 	struct dvobj_priv *dvobj = adapter_to_dvobj(adapter);
 	int ret = _SUCCESS;
 	struct net_device *ndev = adapter->pnetdev;
-	u8 rtnl_lock_needed = rtw_rtnl_lock_needed(dvobj);
 
 #ifdef CONFIG_RTW_NAPI
 	netif_napi_add(ndev, &adapter->napi, rtw_recv_napi_poll, RTL_NAPI_WEIGHT);
@@ -651,10 +680,7 @@
 
 	/* Tell the network stack we exist */
 
-	if (rtnl_lock_needed)
-		ret = (register_netdev(ndev) == 0) ? _SUCCESS : _FAIL;
-	else
-		ret = (register_netdevice(ndev) == 0) ? _SUCCESS : _FAIL;
+	ret = (rtw_linux_register_netdev(dvobj, ndev) == 0) ? _SUCCESS : _FAIL;
 
 	if (ret == _SUCCESS)
 		adapter->registered = 1;
@@ -702,12 +728,7 @@
 
 	if (netdev) {
 		struct dvobj_priv *dvobj = adapter_to_dvobj(adapter);
-		u8 rtnl_lock_needed = rtw_rtnl_lock_needed(dvobj);
-
-		if (rtnl_lock_needed)
-			unregister_netdev(netdev);
-		else
-			unregister_netdevice(netdev);
+		rtw_linux_unregister_netdev(dvobj, netdev);
 	}
 
 #ifdef CONFIG_RTW_NAPI
--- a/os_dep/linux/ioctl_cfg80211.c
+++ b/os_dep/linux/ioctl_cfg80211.c
@@ -5088,7 +5088,7 @@
 	mon_wdev->iftype = NL80211_IFTYPE_MONITOR;
 	mon_ndev->ieee80211_ptr = mon_wdev;
 
-	ret = register_netdevice(mon_ndev);
+	ret = rtw_linux_register_netdev(adapter_to_dvobj(padapter), mon_ndev);
 	if (ret)
 		goto out;
 
@@ -5141,6 +5141,7 @@
 			nl80211_iftype_to_rtw_network_type(type);
 
 	rtw_set_rtnl_lock_holder(dvobj, current);
+	WRITE_ONCE(dvobj->cfg80211_lock_holder, current);
 
 	RTW_INFO(FUNC_WIPHY_FMT" name:%s, type:%d\n", FUNC_WIPHY_ARG(wiphy), name, type);
 
@@ -5244,6 +5245,7 @@
 	else
 		RTW_INFO(FUNC_WIPHY_FMT" wdev:%p, ret:%d\n", FUNC_WIPHY_ARG(wiphy), wdev, ret);
 
+	WRITE_ONCE(dvobj->cfg80211_lock_holder, NULL);
 	rtw_set_rtnl_lock_holder(dvobj, NULL);
 
 #if (LINUX_VERSION_CODE >= KERNEL_VERSION(3, 6, 0))
@@ -5272,13 +5274,14 @@
 	struct rtw_wdev_priv *pwdev_priv;
 
 	rtw_set_rtnl_lock_holder(dvobj, current);
+	WRITE_ONCE(dvobj->cfg80211_lock_holder, current);
 
 	if (ndev) {
 		adapter = (_adapter *)rtw_netdev_priv(ndev);
 		pwdev_priv = adapter_wdev_data(adapter);
 
 		if (ndev == pwdev_priv->pmon_ndev) {
-			unregister_netdevice(ndev);
+			rtw_linux_unregister_netdev(dvobj, ndev);
 			pwdev_priv->pmon_ndev = NULL;
 			pwdev_priv->ifname_mon[0] = '\0';
 			RTW_INFO(FUNC_NDEV_FMT" remove monitor ndev\n", FUNC_NDEV_ARG(ndev));
@@ -5318,6 +5321,7 @@
 	}
 
 exit:
+	WRITE_ONCE(dvobj->cfg80211_lock_holder, NULL);
 	rtw_set_rtnl_lock_holder(dvobj, NULL);
 	return ret;
 }
@@ -11568,7 +11572,8 @@
 
 	if (pwdev_priv->pmon_ndev) {
 		RTW_INFO("%s, unregister monitor interface\n", __func__);
-		unregister_netdev(pwdev_priv->pmon_ndev);
+		rtw_linux_unregister_netdev(adapter_to_dvobj(adapter), pwdev_priv->pmon_ndev);
+		pwdev_priv->pmon_ndev = NULL;
 	}
 }
 
