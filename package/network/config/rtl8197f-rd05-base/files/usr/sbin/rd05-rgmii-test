#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Bounded, reversible RTL8367D RX-clock diagnostic. No CRC bypass or table resets.
PARAM=/sys/module/rtl8365mb/parameters/rd05_ext1_rx_delay
REPORT=/tmp/rd05-rgmii-test.log
LOCK=/tmp/rd05-rgmii-test.lock
SAVED_DELAY=
PROBE_JOB=
PROBE_LEASE=0

wan_up() {
	ifstatus wan 2>/dev/null | grep -Eq '"up"[[:space:]]*:[[:space:]]*true'
}

snapshot() {
	local counters rx tx
	counters="$(ethtool -S wan 2>/dev/null | awk '
		$1 == "cpu_ifInOctets:" || $1 == "p07_ifInOctets:" { i=$2 }
		$1 == "cpu_ifOutOctets:" || $1 == "p07_ifOutOctets:" { o=$2 }
		$1 == "cpu_fcs_errors:" || $1 == "p07_dot3StatsFCSErrors:" { c=$2 }
		END {
			if (i !~ /^[0-9]+$/ || o !~ /^[0-9]+$/ || c !~ /^[0-9]+$/ ||
			    length(i)>15 || length(o)>15 || length(c)>15) exit 1
			print i, o, c
		}')" || return 1
	rx="$(cat /sys/class/net/eth0/statistics/rx_packets 2>/dev/null)" || return 1
	case "$rx" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#rx}" -le 15 ] || return 1
	tx="$(cat /sys/class/net/eth0/statistics/tx_packets 2>/dev/null)" || return 1
	case "$tx" in ''|*[!0-9]*) return 1 ;; esac
	[ "${#tx}" -le 15 ] || return 1
	printf '%s %s %s\n' "$counters" "$rx" "$tx"
}

# Classify deltas, never cumulative counters. Unknown, reset and idle samples
# must not be reported as clean links. Zero errors alone is insufficient.
classify() {
	local before_in before_out before_crc before_rx before_tx after_in after_out after_crc after_rx after_tx
	before_in=$1 before_out=$2 before_crc=$3 before_rx=$4 before_tx=$5
	after_in=$6 after_out=$7 after_crc=$8 after_rx=$9
	shift 9
	after_tx=$1
	if [ "$after_in" -lt "$before_in" ] || [ "$after_out" -lt "$before_out" ] ||
	   [ "$after_crc" -lt "$before_crc" ] || [ "$after_rx" -lt "$before_rx" ] ||
	   [ "$after_tx" -lt "$before_tx" ]; then
		echo 'counter-reset'; return
	fi
	if [ "$after_crc" -gt "$before_crc" ]; then
		echo 'crc-errors'; return
	fi
	if [ "$after_in" -le "$before_in" ]; then
		if [ "$after_tx" -gt "$before_tx" ]; then
			echo 'tx-missing-at-switch'
		else
			echo 'no-tx-sample'
		fi
		return
	fi
	if [ "$after_rx" -le "$before_rx" ]; then
		echo 'tx-clean-rx-missing'; return
	fi
	echo 'bidirectional-traffic'
}

probe_packets() {
	local rc
	PROBE_LEASE=0
	# A private DHCP transaction provides fresh traffic even when netifd's
	# pending client defers a renew. /bin/true never installs an address/route.
	# Its PID file is separate from netifd's /var/run/udhcpc-wan.pid.
	timeout 4 udhcpc -f -n -q -t 1 -T 1 -C -B -i wan -s /bin/true \
		-p "$LOCK/probe.pid" >"$LOCK/probe-output" 2>&1 &
	PROBE_JOB=$!
	wait "$PROBE_JOB"
	rc=$?
	PROBE_JOB=
	echo "dhcp_probe_exit=$rc" >>"$REPORT"
	case "$rc" in
		0) PROBE_LEASE=1 ;;
		1|124|137|143) ;; # No offer/timeout is expected on a broken link.
		*) return 1 ;;
	esac
	return 0
}

restore() {
	local rc=0
	if [ -n "$PROBE_JOB" ]; then
		kill "$PROBE_JOB" 2>/dev/null || true
		wait "$PROBE_JOB" 2>/dev/null || true
		PROBE_JOB=
	fi
	if [ -n "$SAVED_DELAY" ]; then
		if printf '%s\n' "$SAVED_DELAY" >"$PARAM"; then
			echo "restored_rx_delay=$SAVED_DELAY" >>"$REPORT"
		else
			echo 'ERROR: restoring RX delay failed; reboot to restore defaults' | tee -a "$REPORT" >&2
			rc=1
		fi
	fi
	rm -f "$LOCK/probe.pid" "$LOCK/probe-output"
	rmdir "$LOCK" 2>/dev/null || true
	return "$rc"
}

fail() {
	printf 'ERROR: %s\n' "$*" >&2
	# A concurrent run owns its report. Never overwrite it on preflight failure.
	if [ ! -d "$LOCK" ]; then
		printf 'ERROR: %s\n' "$*" >"$REPORT"
	fi
	return 1
}

run_test() {
	local before after delay result saved_ssc
	case "$(cat /tmp/sysinfo/board_name 2>/dev/null)" in
		xiaomi,r4-rd05) ;; *) fail 'Only Xiaomi RD05 is supported'; return 2 ;;
	esac
	[ -w "$PARAM" ] || { fail "Timing parameter unavailable: $PARAM"; return 1; }
	wan_up && { fail 'WAN is already up; refusing to interrupt the working link'; return 1; }
	local tool
	for tool in timeout udhcpc ethtool awk ifstatus; do
		command -v "$tool" >/dev/null 2>&1 || {
			fail "Required command missing: $tool; no timing settings changed"
			return 1
		}
	done
	before="$(snapshot)" || { fail 'CPU-port counters unavailable; cannot test timing'; return 1; }
	mkdir "$LOCK" 2>/dev/null || { fail 'A timing test is already running, or its lock cannot be created'; return 1; }
	SAVED_DELAY="$(cat "$PARAM")"
	case "$SAVED_DELAY" in [0-7]) ;; *) SAVED_DELAY=; rmdir "$LOCK"; fail 'Invalid original RX delay'; return 1 ;; esac
	trap 'restore' EXIT
	trap 'exit 130' INT
	trap 'exit 143' TERM
	saved_ssc="$(cat /sys/module/rtl8365mb/parameters/rd05_ext1_ssc 2>/dev/null)"
	{
		echo 'RD05 RGMII RX timing test v3; no defaults are changed'
		echo "original_rx_delay=$SAVED_DELAY ssc=$saved_ssc"
		echo 'Only switch RX delay is varied; SSC, SoC timing, CRC validation and port tables are preserved.'
		echo 'Fields: switch_in_bytes switch_out_bytes switch_fcs_errors soc_rx_packets soc_tx_packets'
		echo 'A clean TX sample does not prove DHCP, ARP or SoC RX works.'
	} >"$REPORT"
	for delay in 0 1 2 3 4 5 6 7; do
		printf '%s\n' "$delay" >"$PARAM" || return 1
		# Exclude the clock reconfiguration from the measurement window.
		sleep 1
		before="$(snapshot)" || return 1
		probe_packets || {
			echo 'DHCP probe failed; test stimulus unavailable' | tee -a "$REPORT" >&2
			return 1
		}
		sleep 1
		after="$(snapshot)" || return 1
		# snapshot accepts decimal numbers only; field splitting is intentional.
		result="$(classify $before $after)"
		echo "delay=$delay before=[$before] after=[$after] result=$result" | tee -a "$REPORT"
		if [ "$PROBE_LEASE" = 1 ]; then
			echo "DHCP_PROBE_LEASE_AT_DELAY=$delay (no address installed; original timing will be restored)" | tee -a "$REPORT"
			break
		fi
		if wan_up; then
			echo "DHCP_UP_AT_DELAY=$delay (original timing will be restored)" | tee -a "$REPORT"
			break
		fi
	done
	restore || return 1
	SAVED_DELAY=
	trap - EXIT INT TERM
	echo "Report: $REPORT"
}

case "${1:-test}" in
	test) run_test ;;
	*) echo 'Usage: rd05-rgmii-test [test]' >&2; exit 2 ;;
esac
