#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# RD05 native DSA layout is owned by board.d/02_network + config_generate.
# Never delete user device/interface/DHCP sections during a package upgrade.

. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name 2>/dev/null)" in
	xiaomi,r4-rd05) ;;
	*) exit 0 ;;
esac

# config_generate normally ran already. Preserve both its first-boot output
# and any restored/custom configuration, including addresses, ULA and VLANs.
[ -s /etc/config/network ] && exit 0

# Recovery ordering can run uci-defaults before network generation. Reuse
# the same board definition instead of a second, destructive UCI template.
[ -x /bin/config_generate ] || exit 1
/bin/config_generate || exit 1
[ -s /etc/config/network ] || exit 1
exit 0
