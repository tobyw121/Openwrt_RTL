#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# Xiaomi R4/RD05 RTL8197F + RTL8367D DSA network defaults.
# The kernel exposes the external switch ports as lan1, lan2 and wan.

. /lib/functions.sh
. /lib/functions/system.sh

case "$(board_name 2>/dev/null) $(cat /tmp/sysinfo/board_name 2>/dev/null) $(tr '\0' ' ' </proc/device-tree/compatible 2>/dev/null)" in
	*xiaomi,r4-rd05*|*r4-rd05*) ;;
	*) exit 0 ;;
esac

# Do not gate the default network on /sys/class/net.  On RD05 the DSA
# slave devices are present by normal boot, but firstboot/tmpfs recovery can
# execute uci-defaults before netifd has consumed them.  Always write the
# intended RD05 DSA layout so /etc/init.d/network can bring the ports up
# instead of relying on the recovery link guard later in the boot.

lan_mac="$(mtd_get_mac_ascii nvram ethaddr 2>/dev/null)"
[ -n "$lan_mac" ] || lan_mac="$(mtd_get_mac_ascii bdata ethaddr 2>/dev/null)"
wan_mac="$(mtd_get_mac_ascii nvram ethaddr_wan 2>/dev/null)"
[ -n "$wan_mac" ] || wan_mac="$(mtd_get_mac_ascii bdata ethaddr_wan 2>/dev/null)"

# Remove anonymous device sections left by generic board.d defaults.
# RD05 uses named device sections below; leaving both can confuse netifd/diagnostics.
while uci -q delete network.@device[0]; do :; done

uci -q batch <<'UCI'
delete network.loopback
delete network.globals
delete network.br_lan
delete network.lan
delete network.wan_dev
delete network.wan
delete network.wan6

set network.loopback='interface'
set network.loopback.device='lo'
set network.loopback.proto='static'
set network.loopback.ipaddr='127.0.0.1'
set network.loopback.netmask='255.0.0.0'

set network.globals='globals'
set network.globals.ula_prefix='fd00:6969:6969::/48'

set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
set network.br_lan.stp='0'
set network.br_lan.igmp_snooping='0'
add_list network.br_lan.ports='lan1'
add_list network.br_lan.ports='lan2'

set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='192.168.1.1'
set network.lan.netmask='255.255.255.0'
set network.lan.ip6assign='60'

set network.wan_dev='device'
set network.wan_dev.name='wan'
set network.wan_dev.ipv6='1'

set network.wan='interface'
set network.wan.device='wan'
set network.wan.proto='dhcp'

set network.wan6='interface'
set network.wan6.device='@wan'
set network.wan6.proto='dhcpv6'
UCI

if [ -n "$lan_mac" ]; then
	uci -q set network.br_lan.macaddr="$lan_mac"
	uci -q set network.lan.macaddr="$lan_mac"
fi

if [ -n "$wan_mac" ]; then
	uci -q set network.wan_dev.macaddr="$wan_mac"
	uci -q set network.wan.macaddr="$wan_mac"
fi

uci -q commit network

# Ensure recovery and first-boot images provide an IPv4 lease on LAN.
uci -q set dhcp.lan='dhcp'
uci -q set dhcp.lan.interface='lan'
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q delete dhcp.lan.ignore
uci -q delete dhcp.lan.dhcpv4
uci -q commit dhcp

exit 0
