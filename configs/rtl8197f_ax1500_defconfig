# Cudy AX1500 / WR1500 R76 (hardware 1.0).
# One profile builds the RAM loader and the template-based full SPI image.
CONFIG_TARGET_realtek=y
CONFIG_TARGET_realtek_rtl8197f=y
CONFIG_TARGET_realtek_rtl8197f_DEVICE_cudy_ax1500_r76=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_DRIVER_11AC_SUPPORT=y
# Pulls in LuCI, firewall4, SSH, network/wireless userspace and diagnostics.
# The RTL8832BR 5GHz driver is built and loaded automatically; no legacy swconfig.
CONFIG_PACKAGE_rtl8197f-cudy-r76-base=y
CONFIG_PACKAGE_rtl8197f-cudy-ax1500-base=y
CONFIG_PACKAGE_kmod-rtl8832br-wr1500=y
